    local held = false
    while SP.Running and _G.AR2HUB_GEN == GEN do
        local down = iskeypressed and iskeypressed(SP.Key)
        if down and not held then _G.ProbeSites() end
        held = down
        task.wait(0.1)
    end
end)

task.spawn(function()   -- automatic sweep
    local lastAuto, lastPos, stillSince = tick(), nil, tick()
    while SP.Running and _G.AR2HUB_GEN == GEN do
        local root = myCharRoot()
        local p = root and root.Position
        if p and lastPos and (p - lastPos).Magnitude > 3 then stillSince = tick() end
        lastPos = p
        if SP.AutoInterval > 0 and (tick() - lastAuto) > SP.AutoInterval then
            local idleOk = (not SP.RequireIdle) or ((tick() - stillSince) > SP.IdleSeconds)
            if idleOk then
                lastAuto = tick()
                _G.ProbeSites()
            end
        end
        task.wait(1)
    end
end)

