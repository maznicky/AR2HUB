-- Finds the vehicle you are in via the ESP cache rather than walking the Vehicles
-- folder: enumerating all 79 of them alongside the ESP's own sweep is what took
-- Matcha down during this investigation.
-- Result is cached briefly. This walks all ~79 cached vehicles reading a position
-- from each, about 4 ms, and Auto Right was calling it every tick for as long as
-- Boost or Fly was enabled - 80 ms of every second spent re-answering the same
-- question. Everything here runs alongside several ESP sweeps, so that mattered.
-- Engine condition, read straight off the vehicle rather than through the ESP cache.
-- VM.EngineNow used to be refreshed only inside the flight loops, so between trips it
-- held the LAST vehicle's reading - a fresh 68% Mustang was judged as the 15% wreck
-- that preceded it, which would refuse or abort flights it could easily complete.
_G.VEHMOD.engineOf = function(base)
    if not base then return nil end
    local model = base.Parent
    local inter = model and model:FindFirstChild("Interaction")
    local ref = inter and inter:FindFirstChild("Repair Engine")
    if not ref then return nil end
    local ok, h = pcall(function() return ref:GetAttribute("Health") end)
    if ok and type(h) == "table" and type(h.y) == "number" then return h.y end
    return nil
end

_G.VEHMOD.baseNear = function(myPos, maxAge)
    local VM = _G.VEHMOD
    local now = tick()
    -- Hard expiry. Dying and getting into a different vehicle leaves every cached
    -- reference pointing at something that no longer exists, and reads against dead
    -- instances do not fail cleanly here - they get slow. Pressing ram after a death
    -- stalled for about thirty seconds, which is what a scan over a list of corpses
    -- costs. Nothing cached is allowed to outlive this window.
    if not VM.hardAt or (now - VM.hardAt) > 5 then
        VM.hardAt = now
        VM.nearBase, VM.nearAt, VM.nearFailAt = nil, nil, nil
        VM.ramBase, VM.ramPart, VM.ramZ = nil, nil, nil
    end
    if VM.nearAt and (now - VM.nearAt) < (maxAge or 1.0) and VM.nearBase then
        local okv = pcall(function() return VM.nearBase.Position end)
        if okv then return VM.nearBase, VM.nearWhy end
    end
    -- FAILURE backoff. A miss used to re-scan on the very next call, so autopilot with
    -- no vehicle locked asked 30 times a second. The scan measured 4 ms on a healthy
    -- client, but under load each lookup inflates the same way every other read does,
    -- and it starved the client to a fifth of a frame per second - health hit its 0.05
    -- floor and the game stopped responding. A failed search must cost almost nothing
    -- to repeat, so it simply is not repeated for a while.
    if VM.nearFailAt and (now - VM.nearFailAt) < 2.0 and not VM.nearBase then
        return nil, VM.nearWhy or "no vehicle within reach"
    end
    VM.nearAt = now
    local cache = _G.VEHESP and _G.VEHESP.Cache
    -- The cache is only kept fresh while Vehicle ESP is on; otherwise it can be stale, so read
    -- the Vehicles folder directly instead of trusting it.
    if not cache or #cache == 0 or not (_G.VEHESP and _G.VEHESP.Enabled) then
        -- Fall back to reading the Vehicles folder directly. Using the ESP's cache is
        -- cheaper, but depending on it meant every Vehicle Mods feature silently did
        -- nothing whenever Vehicle ESP happened to be switched off - autopilot just sat
        -- in "no vehicle" after a button press with no visible reason. A feature should
        -- not fail because an unrelated toggle is off.
        local vf = workspace:FindFirstChild("Vehicles")
        if not vf then return nil, "no Vehicles folder" end
        local fb, fbd, fbn
        for _, v in ipairs(vf:GetChildren()) do
            local b = v:FindFirstChild("Base")
            if b then
                local okp, p = pcall(function() return b.Position end)
                if okp and p then
                    local okd, d = pcall(function() return (p - myPos).Magnitude end)
                    if okd and d <= VM.Range and (not fbd or d < fbd) then
                        fb, fbd, fbn = b, d, v.Name
                    end
                end
            end
        end
        VM.nearBase, VM.nearWhy = fb, fb and fbn or "no vehicle within reach"
        VM.nearFailAt = (not fb) and now or nil
        return fb, VM.nearWhy
    end
    local best, bd
    for _, e in ipairs(cache) do
        local okp, p = pcall(function() return e.part.Position end)
        if okp and p then
            local okd, d = pcall(function() return (p - myPos).Magnitude end)
            if okd and (not bd or d < bd) then best, bd = e, d end
        end
    end
    if not best or bd > _G.VEHMOD.Range then
        VM.nearBase, VM.nearWhy = nil, "no vehicle within reach"
        return nil, VM.nearWhy
    end
    -- the cache holds the vehicle model itself; the tracked part may sit inside Collision
    local model = best.model or best.part.Parent
    local base = model and model:FindFirstChild("Base")
    VM.nearBase = base
    VM.nearWhy = base and best.name or "no Base part"
    return base, VM.nearWhy
end

-- ---- flight log ----
-- Answers the three questions that matter for planning a trip, and does it inside the
-- script rather than through an external recorder, because every recorder I ran from
-- outside either got cut off mid-run or contributed to a crash.
--
--   how far before damage   - distance and air time when engine health FIRST drops
--   how fast is possible    - peak speed measured from position change, not the
--                             velocity property, which reads mid-ramp values
--   does ground time reset  - time spent grounded before each flight is recorded
--                             alongside how long that flight lasted before damage,
--                             so the two can be compared across runs
--
-- Engine health is a fraction of a maximum that differs per vehicle, so the drop
-- SIZE is not comparable between vehicles - the timing of the first drop is.
_G.FLIGHTLOG = _G.FLIGHTLOG or { runs = {} }
_G.VEHMOD.ui.logSec = _G.VEHMOD.ui.sub:Section("Flight Log", "Full")
