-- ---- keep sprint through a swing ----
-- Swinging drops you to a walk, but pressing shift again resumes running even
-- mid-swing, so the fix is to re-assert shift exactly as you would by hand.
-- Nothing needs detecting: the script knows when a swing happens. Humanoid
-- WalkSpeed and MoveDirection are both unsupported in Matcha and MoveState is
-- not on the character, so there is no readable "am I sprinting" state anyway.
-- Which keycode Roblox sees for shift is decided at runtime rather than guessed:
-- whichever of LSHIFT / generic SHIFT reads as held is the one re-asserted.
local SHIFT_VKS = { 0xA0, 0x10 }
local melSprintAt = 0
local function melHeldShift()
    for _, vk in ipairs(SHIFT_VKS) do
        local ok, d = pcall(function() return iskeypressed(vk) end)
        if ok and d then return vk end
    end
    return nil
end
local function melKeepSprint()
    if not ML.KeepSprint then return end
    local now = tick()
    if (now - melSprintAt) < 0.15 then return end   -- our own click also trips the
    melSprintAt = now                               -- manual watcher; debounce it
    local vk = melHeldShift()
    if not vk or not keypress or not keyrelease then return end
    task.spawn(function()
        task.wait(ML.SprintDelay)      -- let the swing's cancel land first
        pcall(function() keyrelease(vk) end)
        task.wait(0.03)
        pcall(function() keypress(vk) end)
    end)
end

-- ---- key state, same dual approach as the aimbot ----
-- mouse4/mouse5 are here because they bypass the keyboard matrix entirely: see the
-- ghosting note on melKeyHeld below.
local MEL_VK = { m1=0x01, m2=0x02, m3=0x04, m4=0x05, m5=0x06,
                 mouse1=0x01, mouse2=0x02, mouse3=0x04, mouse4=0x05, mouse5=0x06,
                 shift=0x10, ctrl=0x11, alt=0x12, space=0x20, tab=0x09 }
local MEL_TRIG = { ["Mouse 4"] = 0x05, ["Mouse 5"] = 0x06, ["Right Mouse"] = 0x02 }
local function melRawKeyDown()
    -- A mouse button is read directly and never involves the keyboard's key matrix,
    -- so it cannot be swallowed the way V is while W and shift are held.
    local trig = MEL_TRIG[tostring(ML.Trigger or "Key")]
    if trig then
        if iskeypressed then
            local ok, d = pcall(function() return iskeypressed(trig) end)
            if ok and d then return true end
        end
        return false        -- explicit trigger chosen: do not fall through to the key
    end
    if melKeyHandle then
        local ok, v = pcall(function() return melKeyHandle:IsActivated() end)
        if ok and v then return true end
    end
    local k = string.lower(tostring(ML.Key or ""))
    local vk = MEL_VK[k]
    if not vk and #k == 1 then
        local b = string.byte(string.upper(k))
        if b >= 48 and b <= 90 then vk = b end
    end
    if vk and iskeypressed then
        local ok, d = pcall(function() return iskeypressed(vk) end)
        if ok and d then return true end
    end
    return false
end

-- Hold: active while the key is down. Toggle: press once to arm, again to
-- disarm. Always: no key at all.
--
-- Hold mode LATCHES for a grace period rather than trusting each read, because a
-- keyboard cannot necessarily report the melee key at all while other keys are held.
-- Measured on a 5s hold: with W and Shift down (running), V registered on 2 of 20
-- samples, while Z, '3' and Space registered as phantoms despite not being touched -
-- classic matrix ghosting on a non-NKRO board. Auto Melee therefore looked broken
-- exactly when it mattered, since running is when you chase. The latch turns an
-- intermittent read into a steady hold; a mouse button avoids the problem entirely
-- because it never goes through the keyboard matrix.
local melKeyWas = false
local melKeyLast = 0
local function melKeyHeld()
    local mode = ML.KeyMode
    if mode == "Always" then return true end
    local down = melRawKeyDown()
    if mode == "Toggle" then
        if down and not melKeyWas then ML.Armed = not ML.Armed end
        melKeyWas = down
        return ML.Armed == true
    end
    melKeyWas = down
    local now = tick()
    if down then melKeyLast = now end
    return (now - melKeyLast) < (ML.KeyGrace or 0.25)
end

-- ---- equipped weapon, resolved on a timer because FindFirstChild is 0.71 ms ----
-- The hitbox is only ever READ. Writing its Size was tested and the server
-- ignores it entirely - hit detection is server-side - so there is nothing to
-- gain and a permanently wrong part size to be caught with.
local melHb, melHbSize, melAt = nil, nil, 0

local function melResolve(now)
    if (now - melAt) < MEL_REFRESH then return end
    melAt = now
    local P = svcPlayers()
    local lp = P and P.LocalPlayer
    local ch = lp and lp.Character
    local eqd = ch and ch:FindFirstChild("Equipped")
    -- Re-resolve BY NAME first. GetChildren on Equipped returns an empty list on most
    -- reads (measured: 1 child, then 0, then 0, knife equipped throughout), while
    -- FindFirstChild has been reliable everywhere in this script. GetChildren is only
    -- needed to discover the name in the first place, or after a weapon swap.
    local w, hb
    if ML.Weapon and eqd then
        w = eqd:FindFirstChild(ML.Weapon)
        hb = w and w:FindFirstChild("Hitbox") or nil
    end
    if not hb then
        local kids = eqd and eqd:GetChildren() or nil
        w = kids and kids[1] or nil
        hb = w and w:FindFirstChild("Hitbox") or nil
    end
    if not hb and ch then
        -- Last resort, and the only path that never touches Equipped:GetChildren.
        -- After a reload there is no cached name to look up, so if that one call is
        -- flaking the weapon can never be discovered at all - which is exactly how a
        -- fresh load ended up permanently stuck on "no melee equipped".
        local okd, desc = pcall(function() return ch:GetDescendants() end)
        if okd and desc then
            for _, d in ipairs(desc) do
                if d.Name == "Hitbox" then
                    local okp, par = pcall(function() return d.Parent end)
                    if okp and par then
                        local okg, gp = pcall(function() return par.Parent.Name end)
                        if okg and gp == "Equipped" then
                            w, hb = par, d
                            break
                        end
                    end
                end
            end
        end
    end
    if not hb then
        -- Matcha's GetChildren on Equipped intermittently returns an EMPTY list.
        -- Measured on the same folder half a second apart, with a Pocket Knife
        -- equipped the whole time: 1 child, then 0, then 0. Treating that as "no
        -- melee" wiped the weapon and gated off every swing and chase, which is
        -- exactly the "no melee equipped" that made auto melee look dead.
        --
        -- An empty read is missing information, not proof. So the cached hitbox is
        -- kept as long as it still reads AND still hangs under Equipped - that is
        -- positive evidence the weapon is there, rather than an absence of evidence.
        if melHb then
            local oks, s = pcall(function() return melHb.Size end)
            local okp, pn = pcall(function() return melHb.Parent.Parent.Name end)
            -- The ancestor check only DISQUALIFIES: acting on it when it reads nil
            -- would just reintroduce the same flake in a different place. It has to
            -- succeed and disagree before the weapon is considered gone.
            if okp and type(pn) == "string" and pn ~= "Equipped" then
                melHb, melHbSize, ML.Weapon, ML.Reach = nil, nil, nil, 0
                melMiss = 0
                return
            end
            if oks and s then
                melHbSize = s
                ML.Reach = math.max(s.X, s.Y, s.Z)
                melMiss = 0
                return
            end
        end
        -- Reach is a NUMBER, and a number cannot go stale the way an instance read
        -- can. Once it is known, the weapon stays considered equipped until the reads
        -- have been failing for a good while - the swing does not need the hitbox
        -- instance at all, only its length and somewhere to measure from.
        melMiss = (melMiss or 0) + 1
        if melLastOk and (tick() - melLastOk) < 5 then return end
        if melMiss >= 8 then
            melHb, melHbSize, ML.Weapon, ML.Reach = nil, nil, nil, 0
        end
        return
    end
    melMiss = 0
    melLastOk = tick()
    ML.Weapon = w.Name
    melHb = hb
    local ok, sz = pcall(function() return hb.Size end)
    melHbSize = ok and sz or nil
    if melHbSize then
        ML.Reach = math.max(melHbSize.X, melHbSize.Y, melHbSize.Z)
    end
end

-- ---- zombie root cache ----
-- FindFirstChild costs 0.71 ms in Matcha, so resolving roots for ~100 zombies
-- is a 70 ms stall. Doing that on every swing attempt would hitch visibly while
-- the key is held, so roots are resolved a few per tick and reused. The refs
-- stay valid; positions are still read fresh at check time.
local melZ, melZQueue, melZOut, melZIdx, melZAt = {}, nil, nil, 1, 0
local function melZombieStep(now)
    if not melZQueue then
        if (now - melZAt) < 2.0 then return end
        local zf = workspace:FindFirstChild("Zombies")
        melZQueue = zf and zf:GetChildren() or {}
        melZOut, melZIdx = {}, 1
    end
    local done = 0
    while melZIdx <= #melZQueue and done < math.max(1, math.floor(3 * (_G.AR2HUB_HEALTH or 1))) do
        local z = melZQueue[melZIdx]
        melZIdx = melZIdx + 1
        done = done + 1
        if z then
            local r = z:FindFirstChild("HumanoidRootPart")
            if r then melZOut[#melZOut + 1] = r end
        end
    end
    if melZIdx > #melZQueue then
        melZ = melZOut
        melZQueue, melZOut, melZIdx = nil, nil, 1
        melZAt = now
    end
end

-- ---- the loop ----
task.spawn(function()
    local lastSwing = 0
    while _G.AR2HUB_GEN == GEN do
        local now = tick()
        -- Resolved every tick regardless of Auto Melee, so the readout shows the
        -- weapon and its reach as soon as you hold one, and so Extend Hitbox can
        -- be used on its own. melResolve puts the hitbox back to its original
        -- size whenever Extend Hitbox is off, so no separate restore is needed.
        melResolve(now)
        if ML.Enabled then
            if ML.Zombies then melZombieStep(now) end
            -- evaluated ONCE per tick: in Toggle mode this edge-detects the key,
            -- so calling it twice would flip the state twice on a single press
            local active = melKeyHeld()
            if ML.Reach <= 0 then
                ML.State = "no melee equipped"
            elseif not active then
                -- name whatever actually fires it, not always the key: with Trigger set
                -- to a mouse button, "waiting for V" is simply wrong
                local trigName = (ML.Trigger and ML.Trigger ~= "Key")
                                 and tostring(ML.Trigger) or string.upper(tostring(ML.Key))
                ML.State = (ML.KeyMode == "Toggle") and ("off - tap " .. trigName)
                           or ("waiting for " .. trigName)
            elseif (now - lastSwing) < ML.Cooldown then
                ML.State = "cooldown"
            else
                ML.State = "ready"      -- never leave it stale: a frozen state
            end                         -- reads as a failing check that is not failing
            -- The scan runs whenever a melee is active, not only when the swing is
            -- off cooldown, because the chase has to keep closing between swings.
            local canSwing = (now - lastSwing) >= ML.Cooldown
            -- Gated on the reach VALUE, not the hitbox instance. The hitbox is the
            -- better origin - it is where the swing comes from - but its reads flake,
            -- and losing it should cost a little accuracy, not the whole feature.
            if ML.Reach > 0 and active then
                local okp, origin = false, nil
                if melHb then okp, origin = pcall(function() return melHb.Position end) end
                local usedRoot = false
                if not okp or not origin then
                    local okr2, P2 = pcall(function() return svcPlayers() end)
                    local lp2 = (okr2 and P2) and P2.LocalPlayer or nil
                    local ch2 = lp2 and lp2.Character
                    local r2 = ch2 and ch2:FindFirstChild("HumanoidRootPart") or nil
                    if r2 then
                        okp, origin = pcall(function() return r2.Position end)
                        usedRoot = okp and origin ~= nil
                    end
                end
                local cam = workspace.CurrentCamera
                local cf
                if cam then
                    local ok, v = pcall(function() return cam.CFrame end)
                    if ok then cf = v end   -- NOT 'cam and pcall(...)': the 'and'
                end                         -- truncates, leaving cf nil forever
                if okp and origin and cf then
                    local look = cf.LookVector
                    -- The hitbox sits in your hand, slightly ahead of your centre, so
                    -- measuring from the root part instead needs a little more slack.
                    local limit = ML.Reach + MEL_PAD + (usedRoot and 0.6 or 0)
                    local arcCos = math.cos(math.rad(
                        ML.FrontOnly and MEL_ARC_FRONT or MEL_ARC_ANY))
                    local hit = false

                    -- Distance is measured to the target's SURFACE, not its centre.
                    -- The hitbox is a swept box and Matcha exposes no overlap test
                    -- (no Touched, no GetTouchingParts), so a hit is approximated
                    -- as "the target's body is within reach". Measured while
                    -- standing next to a zombie: 4.35 studs centre-to-centre with
                    -- a 2.93 reach, so comparing centres refused every real hit.
                    -- Nearest in-arc candidate, and its surface distance. The range
                    -- test happens after, so prediction can be applied to it.
                    local bestPart, bestSurf
                    local chasePart, chaseSurf, chasePos
                    local function consider(part)
                        local ok, pos = pcall(function() return part.Position end)
                        if not ok or not pos then return end
                        local d = pos - origin
                        local m = d.Magnitude
                        if m <= 0 then return end
                        -- must be in front, since a swing only covers the arc ahead
                        if look:Dot(d * (1 / m)) < arcCos then return end
                        local radius = 1.0
                        local oks, sz = pcall(function() return part.Size end)
                        if oks and sz then radius = math.max(sz.X, sz.Z) * 0.5 end
                        local surf = m - radius
                        -- chase candidates are tracked out to a much greater range
                        -- than swing candidates, so record them before the cutoff
                        if surf <= ML.ChaseMax and (not chaseSurf or surf < chaseSurf) then
                            chasePart, chaseSurf, chasePos = part, surf, pos
                        end
                        if surf > limit + MEL_LOOKAHEAD then return end
                        if not bestSurf or surf < bestSurf then
                            bestPart, bestSurf = part, surf
                        end
                    end

                    if ML.Zombies then
                        for i = 1, #melZ do consider(melZ[i]) end
                    end
                    if ML.Players then
                        local P = svcPlayers()
                        local lp = P and P.LocalPlayer
                        local lpId = lp and lp.UserId
                        if P then
                            for _, pl in ipairs(P:GetPlayers()) do
                                -- whitelisted players are never swung at
                                if pl.UserId ~= lpId and (_G.PLAYERMARK or {})[pl.UserId] ~= "whitelist" then
                                    local okc2, pch = pcall(function() return pl.Character end)
                                    local r = (okc2 and pch) and pch:FindFirstChild("HumanoidRootPart") or nil
                                    if r then consider(r) end
                                end
                            end
                        end
                    end

                    -- ---- swing prediction ----
                    -- Damage lands at the far point of the swing, not when the
                    -- swing starts, so committing only once the target is already
                    -- inside reach means the hit arrives late - by then a closing
                    -- target has walked past you, and a fleeing one is gone.
                    -- Closing RATE is tracked rather than velocity, because the
                    -- rate of change of distance already accounts for both your
                    -- movement and theirs, and Velocity is unsupported in Matcha.
                    local effective = bestSurf
                    if bestPart and bestSurf then
                        if melTrackPart ~= bestPart then
                            melTrackPart, melTrackSurf, melTrackRate = bestPart, bestSurf, 0
                            melTrackAt = now
                        else
                            local dt = now - melTrackAt
                            if dt >= 0.03 then
                                local raw = (bestSurf - melTrackSurf) / dt
                                melTrackRate = melTrackRate * 0.5 + raw * 0.5
                                melTrackSurf, melTrackAt = bestSurf, now
                            end
                        end
                        ML.Closing = -melTrackRate
                        if ML.Predict then
                            -- Where it will be when the blade actually arrives. The
                            -- horizon is capped to the chase burst's remaining time:
                            -- the closing rate only holds while the dash is pushing,
                            -- so predicting a full windup ahead of a 90 studs/s burst
                            -- would swing ~13 studs early at thin air.
                            local horizon = ML.Windup
                            if now < ML.chaseUntil then
                                horizon = math.min(horizon, ML.chaseUntil - now)
                            end
                            effective = bestSurf + melTrackRate * horizon
                            if effective < 0 then effective = 0 end
                        end
                    end
                    hit = (effective ~= nil) and (effective <= limit)

                    -- ---- chase ----
                    -- Track the chase target's velocity by differentiating its position.
                    -- Velocity is unsupported in Matcha, and the swing's closing-rate
                    -- tracker is a scalar, which cannot say WHERE to dash - only whether
                    -- the gap is shrinking. A moving target therefore needs its own
                    -- vector here, or the burst lands where the target used to be. With a
                    -- knife's small hitbox, "used to be" is a clean miss.
                    if chasePart and chasePos then
                        if ML.chaseTrackPart ~= chasePart then
                            ML.chaseTrackPart, ML.chaseTrackPos = chasePart, chasePos
                            ML.chaseTrackAt, ML.chaseVel = now, Vector3.new(0, 0, 0)
                        else
                            local dt = now - (ML.chaseTrackAt or now)
                            if dt >= 0.05 and ML.chaseTrackPos then
                                local raw = (chasePos - ML.chaseTrackPos) * (1 / dt)
                                local old = ML.chaseVel or Vector3.new(0, 0, 0)
                                ML.chaseVel = old * 0.5 + raw * 0.5   -- same smoothing as the swing tracker
                                ML.chaseTrackPos, ML.chaseTrackAt = chasePos, now
                            end
                        end
                    end
                    if ML.Chase then
                        local stopAt = ML.ChaseClose or 1.5
                        local prevTick = ML.chaseTickAt    -- read before overwriting, or
                        ML.chaseTickAt = now               -- dt is always zero
                        local hrp
                        local okr, P = pcall(function() return svcPlayers() end)
                        local lp = (okr and P) and P.LocalPlayer or nil
                        local ch = lp and lp.Character
                        if ch then hrp = ch:FindFirstChild("HumanoidRootPart") end
                        -- How fast THEY are coming to you, along the line between you.
                        -- ML.Closing cannot be used for this: it is the mutual rate, so
                        -- your own dash inflates it, which tripped the hold-off below,
                        -- which stopped the dash, which collapsed the rate again. The
                        -- trace showed exactly that oscillation - hold off at 9 studs,
                        -- drift back out to 11, re-dash, repeat.
                        local theirApproach = 0
                        local myPos
                        if hrp then
                            local okh, hp0 = pcall(function() return hrp.Position end)
                            myPos = okh and hp0 or nil
                        end
                        if myPos and chasePos and ML.chaseVel then
                            local toMe = Vector3.new(myPos.X - chasePos.X, 0, myPos.Z - chasePos.Z)
                            local m = toMe.Magnitude
                            if m > 0.01 then
                                theirApproach = (ML.chaseVel.X * toMe.X + ML.chaseVel.Z * toMe.Z) / m
                            end
                        end
                        if not hrp then
                            ML.ChaseState = "no character"
                        elseif not chasePart then
                            ML.ChaseState = "nothing to chase"
                        elseif chaseSurf and chaseSurf <= stopAt then
                            -- Arrived. Stopping the velocity writes is not enough - the
                            -- momentum carries you straight past, which is how you end
                            -- up behind the target stabbing air. So brake once, killing
                            -- the horizontal component and leaving gravity alone.
                            if ML.chaseUntil > 0 then
                                local okv, v = pcall(function() return hrp.AssemblyLinearVelocity end)
                                if okv and v then
                                    pcall(function()
                                        hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                                    end)
                                end
                            end
                            ML.chaseUntil = 0
                            ML.ChaseState = "in reach"
                        elseif theirApproach > 2
                               and (chaseSurf - stopAt) / theirApproach < 0.35 then
                            -- They are already running at you and will be in reach within
                            -- the windup. Dashing into a target that is closing on you is
                            -- what causes the meet-in-the-middle overshoot, so let them
                            -- come and let the swing prediction do its job.
                            ML.chaseUntil = 0
                            ML.ChaseState = string.format("letting them close (%.0f studs, they run %.0f/s)",
                                chaseSurf, theirApproach)
                        else
                            if now >= ML.chaseUntil and (now - ML.chaseLast) >= ML.ChaseCD then
                                -- Deadline is only a safety cap now. The burst actually
                                -- ends when the per-tick check below says the gap is gone,
                                -- because a gap measured once is wrong the moment either
                                -- of you moves.
                                local travel = math.max(chaseSurf - stopAt, 0)
                                local dur = travel / math.max(ML.ChaseSpeed, 1) + 0.1
                                if dur > 0.6 then dur = 0.6 end
                                ML.chaseUntil = now + dur
                                ML.chaseLast = now
                                ML.Chases = (ML.Chases or 0) + 1
                            end
                            if now < ML.chaseUntil then
                                -- re-aimed every tick, so a target that moves mid-dash
                                -- is still followed rather than dashed past
                                local okp2, hp = pcall(function() return hrp.Position end)
                                if okp2 and hp and chasePos then
                                    -- Interception, not pursuit: solve for how long the
                                    -- burst takes to reach the target, then aim where the
                                    -- target will be by then. Two refinements are plenty
                                    -- since this re-runs every tick and converges.
                                    local aim = chasePos
                                    local vel = ML.chaseVel
                                    if ML.ChaseLead and vel and vel.Magnitude > 0.5 then
                                        local t = math.max(chaseSurf, 0) / math.max(ML.ChaseSpeed, 1)
                                        for _ = 1, 2 do
                                            local pred = chasePos + vel * t
                                            local flatd = Vector3.new(pred.X - hp.X, 0, pred.Z - hp.Z)
                                            t = flatd.Magnitude / math.max(ML.ChaseSpeed, 1)
                                            if t > 1.5 then t = 1.5 end
                                        end
                                        aim = chasePos + vel * t
                                        ML.ChaseLeadStuds = (vel * t).Magnitude
                                    else
                                        ML.ChaseLeadStuds = 0
                                    end
                                    local dir = aim - hp
                                    local flat = Vector3.new(dir.X, 0, dir.Z)
                                    if flat.Magnitude > 0.01 then
                                        flat = flat / flat.Magnitude
                                        -- Speed is clamped to what the remaining gap can
                                        -- absorb this tick. At 90 studs/s a tick covers
                                        -- 2.7 studs, and the stop distance is 1.5, so a
                                        -- full-speed final tick lands past the target no
                                        -- matter how good the aim was.
                                        local dt = now - (prevTick or (now - 0.03))
                                        if dt < 0.02 then dt = 0.02 elseif dt > 0.1 then dt = 0.1 end
                                        local remaining = math.max(chaseSurf - stopAt, 0)
                                        local speed = ML.ChaseSpeed
                                        if speed * dt > remaining then
                                            speed = remaining / dt
                                        end
                                        pcall(function()
                                            hrp.AssemblyLinearVelocity = flat * speed
                                        end)
                                        ML.ChaseState = string.format(
                                            "closing %.0f studs, leading %.1f, at %.0f studs/s",
                                            chaseSurf, ML.ChaseLeadStuds or 0, speed)
                                    end
                                end
                            else
                                ML.ChaseState = string.format("cooldown (%.0f studs away)", chaseSurf)
                            end
                        end
                    else
                        ML.chaseUntil = 0
                        ML.ChaseState = "off"
                    end

                    if hit and canSwing and mouse1click then
                        pcall(function() mouse1click() end)
                        lastSwing = now
                        -- counted here rather than sampled: the "swinging" state lasts
                        -- one 0.03s tick, so any sampler slower than that undercounts it
                        ML.Swings = (ML.Swings or 0) + 1
                        ML.State = "swinging"
                        melKeepSprint()
                    elseif hit and not canSwing then
                        ML.State = "cooldown"       -- in reach, waiting on the timer
                    else
                        ML.State = hit and "no mouse1click" or "nothing in reach"
                    end
                end
            end
        end
        task.wait(0.03)
    end
end)

