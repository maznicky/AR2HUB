local PV_PART = {Part=true, MeshPart=true, UnionOperation=true, WedgePart=true, TrussPart=true, CornerWedgePart=true}
local function pvAnchor(o, d)
    d = d or 3
    if PV_PART[o.ClassName] then
        local p = o.Position
        if typeof(p) == "Vector3" then return o end
    end
    if d <= 0 then return nil end
    for _, c in ipairs(o:GetChildren()) do
        local a = pvAnchor(c, d - 1)
        if a then return a end
    end
    return nil
end
local function pvCamPos()
    local cam = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
    if not cam then return nil end
    local ok, p = pcall(function() return cam.CFrame.Position end)
    if ok and typeof(p) == "Vector3" then return p end
    local ok2, p2 = pcall(function() return cam.Position end)
    if ok2 and typeof(p2) == "Vector3" then return p2 end
    return nil
end

-- melee first (its words appear in no gun name), then exact names, then
-- substrings. secondary always beats primary so a short primary token cannot
-- steal a pistol. verified against all 16 melee and both wiki gun lists.
local function classify(item)
    local ln = string.lower(item or "")
    if ln == "" then return nil end
    for _, w in ipairs(PV.Melee or {}) do
        if string.find(ln, w, 1, true) then return "melee" end
    end
    for _, w in ipairs(PV.SecondaryExact or {}) do if ln == w then return "secondary" end end
    for _, w in ipairs(PV.PrimaryExact or {})   do if ln == w then return "primary"   end end
    for _, w in ipairs(PV.Secondary or {}) do
        if string.find(ln, w, 1, true) then return "secondary" end
    end
    for _, w in ipairs(PV.Primary or {}) do
        if string.find(ln, w, 1, true) then return "primary" end
    end
    return nil          -- food, tools, consumables: ignored, never wipe a slot
end

-- Matcha cannot decode some Roblox strings and hands back 6 bytes of POINTER
-- instead. memory_read dereferences it, taking weapon coverage to ~100%.
-- Requires "Allow Unsafe LuaU" enabled in Matcha.
local function resolveJson(ei)
    local raw = tostring(ei.Value or "")
    if raw == "" or raw == "[]" then return nil end
    if string.find(raw, "ItemName", 1, true) then return raw end
    if #raw >= 4 and #raw <= 8 then
        local addr = 0
        for i = #raw, 1, -1 do addr = addr * 256 + string.byte(raw, i) end
        local ok, s = pcall(function() return memory_read("string", addr) end)
        if ok and type(s) == "string" and string.find(s, "ItemName", 1, true) then
            return s
        end
    end
    return nil
end

local function readEquipped(char)
    local anim = char and char:FindFirstChild("Animator")
    local ei = anim and anim:FindFirstChild("EquippedItem")
    if not ei then return nil, nil end
    local json = resolveJson(ei)
    if not json then return nil, nil end
    local item = string.match(json, '"ItemName"%s*:%s*"([^"]*)"') or ""
    local block = string.match(json, '"Attachments"%s*:%s*(%b{})') or ""
    local list = {}
    for v in string.gmatch(block, '"[%w_]+"%s*:%s*"([^"]*)"') do
        if v ~= "" then list[#list + 1] = v end
    end
    return item, (#list > 0 and table.concat(list, ", ") or "none")
end

