-- ==================== Scheduler health ====================
-- Every heavy sweep in this script is budgeted per tick, but the budgets were each
-- chosen in isolation. Together they can outrun the client: reads that cost 0.05 ms
-- on a healthy client were measured at 7 ms under contention, which makes every
-- budget 140x too large at exactly the moment it needs to be smaller. That spiral
-- has taken Matcha down twice - once from a scan loop of mine, once from turning on
-- one ESP too many.
--
-- So the sweeps ask this how healthy the scheduler is and scale their budgets by it.
-- It measures nothing but its own lateness: a loop asking for 0.05 s that gets 0.5 s
-- reports 0.1, and every sweep then does a tenth of the work until it recovers.
_G.AR2HUB_HEALTH = 1
task.spawn(function()
    local last = tick()
    while _G.AR2HUB_GEN == GEN do
        task.wait(0.05)
        local now = tick()
        local dt = now - last
        last = now
        local ratio = 0.05 / math.max(dt, 0.001)
        if ratio > 1 then ratio = 1 end
        -- fall fast, recover slowly: dropping work quickly is what breaks the spiral
        local prev = _G.AR2HUB_HEALTH or 1
        local blend = (ratio < prev) and 0.6 or 0.1
        local v = prev * (1 - blend) + ratio * blend
        if v < 0.05 then v = 0.05 elseif v > 1 then v = 1 end
        _G.AR2HUB_HEALTH = v
    end
end)

-- ==================== stall recorder ====================
-- Five explanations for the freezes have now been contradicted by measurement, so this
-- stops theorising and records instead. It samples ten times a second and notices its
-- OWN missing time: if a sample arrives a second late, the client stalled for that long
-- and the samples either side say what was happening. Cheap by construction - it reads
-- script state only, never the game.
_G.STALLS = _G.STALLS or { events = {}, ring = {}, ri = 1 }
task.spawn(function()
    local S = _G.STALLS
    local last = tick()
    while _G.AR2HUB_GEN == GEN do
        local now = tick()
        local gap = now - last
        local VM, ZE = _G.VEHMOD, _G.ZOMBESP
        local snap = {
            t = now,
            h = _G.AR2HUB_HEALTH or -1,
            ram = VM and tostring(VM.RamState) or "-",
            drive = VM and tostring(VM.State) or "-",
            ap = (VM and VM.AP) and tostring(VM.AP.phase) or "-",
            zl = ZE and #(ZE.Live or {}) or -1,
            veh = VM and tostring(VM.nearWhy) or "-",
        }
        S.ring[S.ri] = snap
        S.ri = (S.ri % 60) + 1
        -- a gap well past the 0.1s cadence is a stall, and worth keeping with context
        if gap > 0.75 then
            local before = {}
            for i = 1, 6 do
                local idx = ((S.ri - 1 - i - 1) % 60) + 1
                if S.ring[idx] then table.insert(before, 1, S.ring[idx]) end
            end
            S.events[#S.events + 1] = { gap = gap, at = now, before = before, after = snap }
            if #S.events > 12 then table.remove(S.events, 1) end
        end
        last = tick()
        task.wait(0.1)
    end
end)

_G.PRINTSTALLS = function()
    local S = _G.STALLS
    print(string.format("---- stalls recorded: %d ----", #S.events))
    for i, e in ipairs(S.events) do
        print(string.format("%d. froze for %.1fs", i, e.gap))
        for _, b in ipairs(e.before) do
            print(string.format("     -%.1fs  health %.2f | ram %-28s | drive %-22s | ap %-10s | zombies %d | veh %s",
                e.at - b.t, b.h, b.ram, b.drive, b.ap, b.zl, b.veh))
        end
        print(string.format("     after   health %.2f | ram %s", e.after.h, e.after.ram))
    end
    if #S.events == 0 then print("   nothing yet - the client has not missed a beat since load") end
end

-- ==================== Settings tab ====================
-- INS-ui ships its own Settings tab. Enabling it gives Theme, Appearance,
-- Interface (which already contains the "Menu key" bind that opens/closes this
-- menu, default P), Configs (save/load named presets) and System - so none of
-- that needs reimplementing here. Added last so it sits after the other tabs.
-- NOTE: AddSettingsTab/SettingsSection live on the object CreateWindow returns
-- (the lib's internal `o2`), NOT on the module table. `Lib` is the module and
-- returns nil for both, so these must be called on `win`.
win:AddSettingsTab("cog")

-- Script-level settings the library cannot know about.
local setSec = win:SettingsSection("AR2 Hub", "Left")
local setInfo = setSec:Label("status: -")

-- Panic: stop everything that draws or moves the mouse, and hand input back.
-- Same effect as the F7 hotkey, reachable when a hotkey is not.
local function hubPanic()
    _G.ESP_RUNNING = false
    if _G.AIMBOT then
        _G.AIMBOT.Enabled = false
        _G.AIMBOT.Locked  = nil
    end
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    pcall(function() Lib:Notify("panic: ESP and aimbot off, input released", 4) end)
end

-- Full unload: bumping the generation retires every loop in this script, and
-- each one removes its own Drawings on the way out (ESP pool, FOV ring).
local function hubUnload()
    _G.AR2HUB_GEN  = (_G.AR2HUB_GEN or 0) + 1
    _G.ESP_RUNNING = false
    _G.UI_WATCHDOG = false
    if _G.AIMBOT    then _G.AIMBOT.Enabled = false end
    if _G.PlayerVis then _G.PlayerVis.Running = false end
    if _G.SiteProbe then _G.SiteProbe.Running = false end
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)                      -- let the loops notice and clean up
    pcall(function() Lib:Destroy() end)
end

setSec:Button("Panic - stop ESP + aimbot", function() hubPanic() end,
    "Also bound to F7. Releases input, in case the menu ever traps it.")
setSec:Button("Unload AR2 Hub", function() task.spawn(hubUnload) end,
    "Retires every loop, removes all Drawings and closes the menu. Re-run the loadstring to come back.")

setSec:Divider("Safety")
setSec:Toggle("Input watchdog", true, function(v) _G.UI_WATCHDOG = v end,
