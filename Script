-- ==================== Aimbot (Combat tab) ====================
-- Everything here is calibrated against live measurements, not assumed:
--   * 0.002443 rad/count, both axes, exactly linear for a single large move.
--   * +X counts DECREASE world yaw; +Y counts look DOWN. Hence both negate.
--   * Angles are WORLD space. Mouse X rotates about the world vertical axis, so
--     camera-space yaw is wrong by 1/cos(pitch) (measured: 0.34863 delivered
--     where 0.36652 was expected, at 26 deg of pitch).
--   * atan2 stays defined behind the camera, so a flanking target can never
--     mirror and yank the view around - that was the close-combat "teleport".
--   * task.wait() = 21 Hz, task.wait(1/1000) = 221 Hz in Matcha.
--   * A full selection pass over ~66 targets costs 12.7 ms, so it CANNOT run
--     every tick (281% CPU). Selection is 10 Hz; tracking the locked target is
--     one 0.05 ms Position read and runs every tick.
--   * REQUIRES Windows "Enhance pointer precision" OFF. With it ON, 1-count
--     moves were only 6.3% effective (5-count 100%, 30-count 118.8%), which
--     crippled tracking. With it OFF, 1/2/4-count moves all measure 100% and
--     rad/count is identical on both axes, so MinStep 1 is correct. If aim ever
--     goes sluggish again, check that setting first.
--   * mousemoverel only takes effect while the Roblox window has focus.
--   * Camera.CFrame writes are silently discarded, which is why aim type is Mouse.
-- INS-ui dropdown callbacks receive a TABLE, never a string: ab() wraps every
-- value into an array and dW() dispatches dU.value, so a single-select dropdown
-- hands back {"Torso"}. Comparing that to "Head" is always false, which is why
-- Hit Part could not be switched back and Target = Distance never engaged.
local function dropStr(v, fallback)
    if type(v) == "table" then v = v[1] end
    if type(v) == "string" and v ~= "" then return v end
    return fallback
end

_G.AIMBOT = _G.AIMBOT or {}
local AB = _G.AIMBOT
AB.Enabled  = false
AB.Key      = AB.Key      or "e"
AB.PredOn   = AB.PredOn   == true   -- master switch for velocity lead
AB.PredStud = AB.PredStud or 0      -- studs to aim ahead along the target's travel
AB.DropStud = AB.DropStud or 0      -- studs of lift at DROP_REF_M, scaled by range^2
AB.FovPx    = AB.FovPx    or 150
AB.ShowFov  = (AB.ShowFov ~= false)
AB.DistM    = AB.DistM    or 300
AB.Smooth   = AB.Smooth   or 3
AB.Sens     = AB.Sens     or 1.0
AB.Sticky   = AB.Sticky   == true   -- hold one target for as long as the key is down
AB.DropScale = (AB.DropScale ~= false)     -- scale drop with range, or flat studs
-- sanitised, because a previous session may have stored a table here
AB.Mode     = dropStr(AB.Mode, "Crosshair")   -- "Crosshair" | "Distance"
AB.MinStep  = AB.MinStep  or 1      -- 1 verified 100% effective with pointer accel OFF
                                    -- (no UI: only needs changing if pointer
                                    --  acceleration is ever turned back on)
AB.Part     = dropStr(AB.Part, "Head")
AB.Zombies  = AB.Zombies  == true   -- TEMPORARY test targets
AB.Locked   = nil

-- Close-range guard for velocity lead, no longer a UI knob. A fixed lead time
-- is geometrically correct at any range, but up close the angular error it
-- produces is huge and targets change direction constantly, so linear
-- extrapolation stops being valid. Inside this range the lead fades to zero.
local FALLOFF_M = 15

-- Reference range for Drop Prediction. The slider value is the lift applied at
-- exactly this distance; closer targets get less, further targets get more, by
-- the square of the ratio.
local DROP_REF_M = 100
local DROP_REF   = DROP_REF_M * 2.75

local RAD_PER_COUNT = 0.002443
local MAX_STEP      = 250           -- counts/tick, the real anti-teleport guard
local MAX_ENGAGE    = math.rad(120)
local ABDIV         = 2.75
local SELECT_EVERY  = 0.10
local TICK          = 1/1000

local aimKeyHandle
-- no captured Players handle here either: svcPlayers() resolves it per use

local VK = { m1=0x01, m2=0x02, shift=0x10, ctrl=0x11, alt=0x12, space=0x20,
             tab=0x09, capslock=0x14 }
local function keyHeld()
    if aimKeyHandle then
        local ok, v = pcall(function() return aimKeyHandle:IsActivated() end)
        if ok and v then return true end
    end
    local k = string.lower(tostring(AB.Key or ""))
    local vk = VK[k]
    if not vk and #k == 1 then
        local b = string.byte(string.upper(k))
        if b >= 48 and b <= 90 then vk = b end
    end
    if vk and iskeypressed then
        local ok, d = pcall(function() return iskeypressed(vk) end)
        if ok and d then return true end
    end
    return false
end

-- Velocity MUST come from position history: Velocity and AssemblyLinearVelocity
-- both read exactly zero in Matcha, verified against a moving player.
local abHist = {}
local function velOf(key, pos, now)
    local h = abHist[key]
    if not h then
        abHist[key] = { pos = pos, t = now, vel = Vector3.new() }
        return Vector3.new()
    end
    local dt = now - h.t
    if dt >= 0.06 then              -- long enough to ride out replication steps
        local v = (pos - h.pos) * (1 / dt)
        h.vel = h.vel * 0.6 + v * 0.4
        h.pos, h.t = pos, now
    end
    return h.vel
end

local function wrapPi(a)
    if a >  math.pi then a = a - 2*math.pi end
    if a < -math.pi then a = a + 2*math.pi end
    return a
end

local function abPart(model)
    if AB.Part == "Head" then
        return model:FindFirstChild("Head")
            or model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Torso")
    end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("Head")
end

-- Health is read from the Humanoid reference held in the target cache, so there
-- is no per-frame FindFirstChildOfClass. Zombies have no Humanoid at all; dead
-- ones are moved to workspace.Corpses, so presence in Zombies means alive.
local function humAlive(hum)
    if not hum then return true end
    local ok, hp = pcall(function() return hum.Health end)
    if ok and type(hp) == "number" then return hp > 0 end
    return true
end

local accX, accY = 0, 0
local function moveMouse(dxc, dyc)
    if not mousemoverel then return end
    accX, accY = accX + dxc, accY + dyc
    local step = AB.MinStep
    if step < 1 then step = 1 end
    local sx, sy = 0, 0
    if math.abs(accX) >= step then sx = math.modf(accX); accX = accX - sx end
    if math.abs(accY) >= step then sy = math.modf(accY); accY = accY - sy end
    if sx ~= 0 or sy ~= 0 then
        pcall(function() mousemoverel(sx, sy) end)
    end
end

local fovRing = Drawing.new("Circle")
fovRing.Filled = false
fovRing.Thickness = 1
fovRing.NumSides = 64
fovRing.Visible = false

-- ---------------- target cache ----------------
-- Matcha charges ~0.71 ms per FindFirstChild and ~0.44 ms per
-- FindFirstChildOfClass. Resolving 98 zombie models cost 118 ms per selection
-- pass at 10 Hz - over 100% CPU, which starved the aim loop. So part and
-- Humanoid references are resolved ONCE into abTargets and the selection pass
-- only reads Position (5.5 ms). The rebuild is spread a few models per tick so
-- there is never a single long stall.
local abTargets   = {}      -- live list: {key, name, part, hum|false}
local abBuild     = nil     -- queue under construction
local abBuildOut  = nil
local abBuildIdx  = 1
local abBuiltAt   = 0
local abPartMode  = AB.Part
local BUILD_PER_TICK = 2
local REBUILD_EVERY  = 0.75

local function abBuildStep(now)
    if not abBuild then
        if (now - abBuiltAt) < REBUILD_EVERY and abPartMode == AB.Part then return end
        abPartMode = AB.Part
        local q = {}
        local P = svcPlayers()
        if P then
            local lp = P.LocalPlayer
            local lpId = lp and lp.UserId
            for _, pl in ipairs(P:GetPlayers()) do
                -- whitelisted players are skipped outright, never targeted
                if pl.UserId ~= lpId and (_G.PLAYERMARK or {})[pl.UserId] ~= "whitelist" then
                    local okc, char = pcall(function() return pl.Character end)
                    if okc and char then
                        q[#q + 1] = { key = "p" .. pl.UserId, name = pl.Name, model = char, player = true }
                    end
                end
            end
        end
        if AB.Zombies then
            local zf = workspace:FindFirstChild("Zombies")
            if zf then
                for i, m in ipairs(zf:GetChildren()) do
                    q[#q + 1] = { key = "z" .. i .. m.Name, name = m.Name, model = m }
                end
            end
        end
        abBuild, abBuildOut, abBuildIdx = q, {}, 1
    end
    local done = 0
    while abBuildIdx <= #abBuild and done < BUILD_PER_TICK do
        local e = abBuild[abBuildIdx]
        abBuildIdx = abBuildIdx + 1
        done = done + 1
        local okp, part = pcall(function() return abPart(e.model) end)
        if okp and part then
            local hum = false
            if e.player then    -- zombies have no Humanoid, so do not pay for the lookup
                local okh, h = pcall(function() return e.model:FindFirstChildOfClass("Humanoid") end)
                if okh and h then hum = h end
            end
            abBuildOut[#abBuildOut + 1] =
                { key = e.key, name = e.name, part = part, hum = hum }
        end
    end
    if abBuildIdx > #abBuild then
        abTargets = abBuildOut
        abBuild, abBuildOut, abBuildIdx = nil, nil, 1
        abBuiltAt = now
    end
end

task.spawn(function()
    local lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil
    local lastSelect, lastTick = 0, tick()

    while _G.AR2HUB_GEN == GEN do
        local now = tick()
        local dt  = now - lastTick
        if dt <= 0 then dt = TICK end
        lastTick = now

        local cam = workspace.CurrentCamera
        local cf
        if cam then
            local ok, v = pcall(function() return cam.CFrame end)
            if ok then cf = v end     -- NOT 'cam and pcall(...)': 'and' truncates
        end                           -- multi-returns, which left cf nil
        local vs = cam and cam.ViewportSize

        local gateAng, stickyAng, focal = 0, 0, 500
        if cam and vs then
            focal = (vs.Y / 2) / math.tan(math.rad(cam.FieldOfView or 70) / 2)
            gateAng   = math.atan(AB.FovPx / focal)
            stickyAng = math.atan((AB.FovPx * 1.5) / focal)
            if gateAng   > MAX_ENGAGE then gateAng   = MAX_ENGAGE end
            if stickyAng > MAX_ENGAGE then stickyAng = MAX_ENGAGE end
        end

        if AB.Enabled and AB.ShowFov and vs then
            fovRing.Position = Vector2.new(vs.X / 2, vs.Y / 2)
            fovRing.Radius = AB.FovPx
            fovRing.Color = lockPart and Color3.fromRGB(235, 80, 80)
                                      or Color3.fromRGB(165, 170, 180)
            fovRing.Visible = true
        else
            fovRing.Visible = false
        end

        if AB.Enabled then abBuildStep(now) end

        if AB.Enabled and keyHeld() and cf then
            local cp, look = cf.Position, cf.LookVector
            local curYaw   = math.atan2(look.X, look.Z)
            local curPitch = math.asin(math.clamp(look.Y, -1, 1))
            local maxStuds  = AB.DistM * ABDIV
            local fallStuds = FALLOFF_M * ABDIV
            local tau  = math.max(0.005, AB.Smooth * 0.016)   -- seconds
            local gain = 1 - math.exp(-dt / tau)

            -- ---------- SELECTION ----------
            -- Sticky holds the first target for as long as the key is down, so
            -- once we have a valid lock we skip re-selection entirely.
            local resel = (not lockPart) or
                          ((not AB.Sticky) and (now - lastSelect) >= SELECT_EVERY)
            if resel then
                lastSelect = now
                local prevKey = lockKey
                local bestScore
                lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil

                -- Iterate the CACHE and read Position only. Resolving parts is
                -- what used to cost 118 ms per pass; this costs ~5.5 ms.
                for i = 1, #abTargets do
                    local t = abTargets[i]
                    local okp, tpos = pcall(function() return t.part.Position end)
                    if not okp or not tpos then
                        t.dead = true                 -- part went away; next rebuild drops it
                    elseif humAlive(t.hum) then
                        local d = tpos - cp
                        local mag = d.Magnitude
                        if mag > 0 and mag <= maxStuds then
                            local u = d * (1 / mag)
                            local ang = math.acos(math.clamp(look:Dot(u), -1, 1))
                            local gate = (t.key == prevKey) and stickyAng or gateAng
                            if ang <= gate then
                                -- Crosshair: smallest angle off centre.
                                -- Distance: nearest in studs. Both gated by the
                                -- FOV circle, so Distance only ever picks from
                                -- what is already inside the ring.
                                local score
                                if AB.Mode == "Distance" then
                                    score = mag
                                    if t.key == prevKey then score = score * 0.85 end
                                else
                                    score = ang
                                    if t.key == prevKey then score = score * 0.5 end
                                end
                                if not bestScore or score < bestScore then
                                    bestScore = score
                                    lockPart, lockName, lockKey, lockHum =
                                        t.part, t.name, t.key, t.hum
                                end
                            end
                        end
                    end
                end
            end

            -- ---------- TRACKING: every tick, one Position read ----------
            if lockPart then
                local okp, tpos = pcall(function() return lockPart.Position end)
                if (not okp) or (not tpos) or (not humAlive(lockHum)) then
                    lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil
                    AB.Locked, AB.Status = nil, "target gone"
                else
                    local raw = (tpos - cp).Magnitude
                    local vel = velOf(lockKey, tpos, now)
                    -- Prediction OFF means no velocity lead of any kind: aim at
                    -- where the target is. Previously the controller-lag term
                    -- (vel * tau) was applied unconditionally, so "off" still
                    -- led a sprinter by over a stud - the toggle looked broken.
                    -- Three usable states now:
                    --   off              -> no lead at all
                    --   on, amount 0     -> tracking compensation only (tau)
                    --   on, amount N     -> compensation plus N studs of lead
                    local aimPos = tpos
                    if AB.PredOn then
                        aimPos = tpos + vel * tau
                        -- Prediction proper is a DISTANCE: this many studs ahead
                        -- along the target's travel. Faded out at close range by
                        -- FALLOFF_M, and skipped below a walking pace so a
                        -- stationary target does not jitter on velocity noise.
                        if AB.PredStud > 0 then
                            local sp = vel.Magnitude
                            if sp > 2 then
                                local lead = AB.PredStud
                                if fallStuds > 0 and raw < fallStuds then
                                    lead = lead * (raw / fallStuds)
                                end
                                aimPos = aimPos + vel * (lead / sp)
                            end
                        end
                    end
                    -- Drop Prediction: lifts or lowers the aim point off the
                    -- targeted part to sit where the round actually lands.
                    -- Scales with the SQUARE of range: drop is 0.5*g*t^2 and
                    -- t = range/speed, so doubling the range quadruples the
                    -- drop. The slider is therefore "studs of lift at 100 m",
                    -- which makes one calibration hold at every range.
                    if AB.DropStud ~= 0 then
                        local lift
                        if AB.DropScale then
                            -- quadratic: correct for gravity, but it means the lift
                            -- is tiny up close. 2 studs @100m is only 0.08 studs at
                            -- 20 m, which is why it looked like it did nothing.
                            local k = raw / DROP_REF
                            lift = AB.DropStud * k * k
                        else
                            lift = AB.DropStud          -- flat, same at every range
                        end
                        if lift >  40 then lift =  40 end   -- sanity clamp; at 1000 m
                        if lift < -40 then lift = -40 end   -- k^2 would run away
                        aimPos = aimPos + Vector3.new(0, lift, 0)
                    end
                    local d = aimPos - cp
                    local mag = d.Magnitude
                    if mag <= 0 or raw > maxStuds then
                        lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil
                        AB.Locked, AB.Status = nil, "out of range"
                    else
                        local u = d * (1 / mag)
                        local ang = math.acos(math.clamp(look:Dot(u), -1, 1))
                        -- Sticky ignores the FOV circle once locked; it only lets
                        -- go on death, range, or the absolute engage limit.
                        local dropAt = AB.Sticky and MAX_ENGAGE or stickyAng
                        if ang > dropAt then
                            lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil
                            AB.Locked, AB.Status = nil, "lost lock"
                        else
                            local dYaw = wrapPi(math.atan2(u.X, u.Z) - curYaw)
                            local dPit = math.asin(math.clamp(u.Y, -1, 1)) - curPitch
                            local dxc = (-dYaw / RAD_PER_COUNT) * AB.Sens * gain
                            local dyc = (-dPit / RAD_PER_COUNT) * AB.Sens * gain
                            if dxc >  MAX_STEP then dxc =  MAX_STEP end
                            if dxc < -MAX_STEP then dxc = -MAX_STEP end
                            if dyc >  MAX_STEP then dyc =  MAX_STEP end
                            if dyc < -MAX_STEP then dyc = -MAX_STEP end
                            moveMouse(dxc, dyc)
                            AB.Locked = lockKey
                            AB.Status = string.format("%s  %.0fpx",
                                string.sub(lockName or "?", 1, 20), math.tan(ang) * focal)
                        end
                    end
                end
            else
                AB.Locked, AB.Status = nil, "nothing in circle"
            end
        else
            -- key released: drop the lock, which is what ends a Sticky hold
            lockPart, lockName, lockKey, lockHum = nil, nil, nil, nil
            AB.Locked, AB.Status = nil, nil
            accX, accY = 0, 0
        end
        task.wait(TICK)
    end
    pcall(function() fovRing:Remove() end)
end)

