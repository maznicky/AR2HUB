            zombSweepStep(now)
            local cp = camPos()
            if cp then
                local maxStuds = ZE.MaxM * E.DistanceDivisor
                local list = ZE.Live
                for i = 1, #list do
                    if n >= ZOMB_POOL then break end
                    local e = list[i]
                    if ZE.Show[e.cat] then
                        -- The arithmetic is wrapped, not just the read: Matcha
                        -- falls back to FindFirstChild for unsupported properties,
                        -- so .Position can hand back an INSTANCE instead of a
                        -- Vector3. That threw "Vector3Meta expected, got Instance"
                        -- and silently killed the loop it happened in.
                        local ok, pos = pcall(function() return e.part.Position end)
                        local okd, d = false, nil
                        if ok and pos then
                            okd, d = pcall(function() return (pos - cp).Magnitude end)
                        end
                        if okd and type(d) == "number" then
                            if d <= maxStuds then
                                local pt, visible = toScreen(pos + Vector3.new(0, 2, 0))
                                if visible then
                                    n = n + 1
                                    local o = pool[n]
                                    local col = (e.cat == "armed") and ZCOL.armed
                                             or (e.cat == "normal") and ZCOL.normal
                                             or ZCOL.special

                                    o.ring.Position = pt
                                    o.ring.Color = col
                                    o.ring.Visible = true

                                    o.core.Position = pt
                                    o.core.Color = col
                                    o.core.Visible = true

                                    o.name.Text = e.name
                                    o.name.Position = Vector2.new(pt.X, pt.Y - 30)
                                    o.name.Color = STYLE.name
                                    o.name.Visible = true

                                    local detail = metres(d) .. E.DistanceUnit
                                    if e.item then detail = detail .. "  " .. e.item end
                                    o.sub.Text = detail
                                    o.sub.Position = Vector2.new(pt.X, pt.Y - 16)
                                    o.sub.Color = col
                                    o.sub.Visible = true
                                end
                            end
                        end
                    end
                end
            end
        end
        for i = n + 1, ZOMB_POOL do hide(pool[i]) end
        task.wait(0.05)
    end
    for i = 1, ZOMB_POOL do
        pcall(function() pool[i].ring:Remove() end)
        pcall(function() pool[i].core:Remove() end)
        pcall(function() pool[i].name:Remove() end)
        pcall(function() pool[i].sub:Remove() end)
    end
end)

