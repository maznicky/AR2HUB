                        end
                    end
                end
            end
        else
            VM.RamState = "off"
        end
        task.wait(0.05)
    end
end)

-- ---- autopilot ----
-- Flies the vehicle to a saved waypoint on its own: climb, cruise, descend, stop.
--
-- The landing is the part that needs the waypoint. There is no way to ask this game
-- how high the ground is anywhere - workspace:Raycast is bound but always returns nil
-- - so a destination picked off a map would have no known ground level and the
-- descent would either stop in mid-air or drive into a hillside. A waypoint saved
-- from where you are STANDING carries its own ground height, which is exactly the
-- number the descent needs.
_G.VEHMOD.AP = _G.VEHMOD.AP or {}
_G.VEHMOD.AP.on      = false
_G.VEHMOD.AP.phase   = "idle"
_G.VEHMOD.AP.target  = nil
_G.VEHMOD.AP.Height  = 140            -- cruise altitude above the waypoint
_G.VEHMOD.AP.Speed   = 1200           -- cruise ceiling; the braking curve picks the rest
-- Descent rate. This was 35, which sounds gentle and is actually the most expensive
-- part of a trip: 250 studs down at 35 studs/s is 7 seconds in the air, against 1.3 to
-- climb the same distance at 220. At the measured drain that is roughly 12% of engine
-- spent sinking, and it killed a tractor mid-descent. Engine cost follows time in the
-- air, so a slow descent is not the safe option - it is the one that strands you.
_G.VEHMOD.AP.Descent = 360            -- travel speed * 0.3, matching the slider
_G.VEHMOD.AP.Radius  = 12             -- horizontal arrival tolerance
-- Absolute altitude floor for cruising. Height alone is measured from the DESTINATION,
-- so a trip to somewhere low crossed low - a run to a coastal target at Y=17 cruised at
-- 157 and went straight through ground that Beaufort sits on at 194. Phasing through
-- terrain at speed is also what got the account kicked, so this is a safety floor as
-- much as a routing one: the highest recorded destination is 194.
_G.VEHMOD.AP.MinAlt  = 280
-- Braking is kept equal to travel speed: that ratio landed cleanly in testing, and it
-- means one slider controls the whole profile instead of four that interact.
_G.VEHMOD.AP.Brake   = 1200           -- studs/s^2 it can shed on the run-in
_G.VEHMOD.AP.LandDecel  = 150         -- how hard the descent flares out near the ground
_G.VEHMOD.AP.TouchSpeed = 8           -- vertical speed it aims to actually touch down at
-- Vertical speed is where multi-leg trips bleed engine: every leg pays a climb AND a
-- descent, so a three leg run spends about 13 seconds going up and down before any
-- horizontal distance is covered - roughly 30% of engine at the measured 2.3%/s. The
-- climb used to be hardcoded at 220.
_G.VEHMOD.AP.Climb = 480      -- travel speed * 0.4, matching the slider

_G.VEHMOD.ui.apSec = _G.VEHMOD.ui.sub:Section("Autopilot", "Full")
_G.VEHMOD.ui.apSec:Label("Flies the vehicle to a destination and lands it. Long trips")
_G.VEHMOD.ui.apSec:Label("may still need manual stops: the engine depletes the whole")
_G.VEHMOD.ui.apSec:Label("time you are airborne, and arriving somewhere the map has")
_G.VEHMOD.ui.apSec:Label("not streamed in yet drops the vehicle through the ground.")
