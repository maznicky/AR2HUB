                    if not e.wheels then vehResolve(e) end
                    vehReadCondition(e)
                    local p = e.parts or {}
                    local wheels = e.boat and "boat" or pctText(e.frac)
                    if (not e.boat) and e.frac and e.count > 0 and e.read < e.count then
                        wheels = wheels .. string.format(" (%d/%d)", e.read, e.count)
                    end
                    local bits = {}
                    bits[#bits + 1] = "eng " .. pctText(p.engine)
                    bits[#bits + 1] = "body " .. pctText(p.body)
                    bits[#bits + 1] = "tank " .. pctText(p.tank)
                    bits[#bits + 1] = "fuel " .. pctText(p.fuel)
                    if p.glassFixed and p.glassTotal then
                        bits[#bits + 1] = string.format("glass %d/%d", p.glassFixed, p.glassTotal)
                    end
                    pcall(function()
                        row.top:SetText(string.format("%s - %d%s - wheels %s",
                            e.name, metres(item.d), E.DistanceUnit, wheels))
                        row.bot:SetText(table.concat(bits, "  "))
                    end)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- ==================== Zombie ESP (Visuals > Zombies) ====================
-- What a zombie carries is readable from its Equipment folder. Verified live:
--   Backpack Firearm <gun>   slung primary   e.g. "Backpack Firearm SPAS-12"
--   Belt Firearm <gun>       holstered       e.g. "Belt Firearm Makarov"
--   Backpack <bag>           actual bag      e.g. "Backpack Rucksack Brown"
--   Hat/Vest/Pants/Accessory/Belt/Shirt      cosmetic only
-- Special variants carry a Mod<digit> suffix - confirmed in the world as
-- "Belt Firearm Winchester 1894Mod1" on Unique Trapper Winchester 1894Mod1.
-- That rule is generic, so every Mod1/Mod2 gun is caught without a name list;
-- SPECIAL_EXTRA covers the exclusives that have no Mod suffix.
-- Zombies have no Humanoid and no Id attribute, and the population churns
-- (94 -> 101 within minutes), so the cache is rebuilt by an incremental sweep
-- into a second buffer and swapped in whole. Resolving Equipment costs ~0.8 ms
-- per zombie, which is why it is never done in bulk.
_G.ZOMBESP = _G.ZOMBESP or {}
local ZE = _G.ZOMBESP
ZE.Enabled = false
ZE.MaxM    = ZE.MaxM or 250
ZE.Show    = ZE.Show or {}      -- category -> true
ZE.Live    = ZE.Live or {}      -- rendered list

local ZOMB_POOL    = 80
local ZOMB_PERTICK = 3          -- zombies classified per tick during a sweep
local ZOMB_SWEEP   = 1.5        -- seconds between sweeps

local ZCOL = {
    special = C(245, 170,  70),  -- orange, same as the vehicle middle band
    armed   = C(120, 190, 255),  -- blue: notable, not a jackpot
    normal  = C(245, 246, 250),  -- white
}

-- Exclusives with no Mod suffix. Matched case-insensitively as substrings, so
-- "Heavy Survey" covers every colour of that bag.
local SPECIAL_EXTRA = {
    "patriot", "socom", "mk23",
    "garbage bag", "heavy survey", "military duffel",
