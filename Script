-- one scan for all 26 keys, ~30s, once per session
local function prepare()
    if CB.Scanning then return end
    CB.Scanning = true
    setStatus("scanning... game freezes ~30s, ONCE per session")
    task.wait(0.1)
    task.spawn(function()
        local t0 = tick()
        local ok, cache = pcall(function() return getgc(allKeys()) end)
        local secs = tick() - t0
        if not ok or type(cache) ~= "table" or #cache == 0 then
            CB.Scanning = false
            setStatus(string.format("scan failed after %.1fs", secs))
            return
        end
        CB.Originals = {}
        local n = 0
        for _, e in ipairs(cache) do
            if e.addr and tostring(e.type) == "number" then
                CB.Originals[e.addr] = tonumber(e.value) or 0
                n = n + 1
            end
        end
        CB.Cache, CB.Prepared, CB.Scanning = cache, true, false
        setStatus(string.format("ready - %d values cached in %.0fs", n, secs))
        print(string.format("[combat] prepared: %d entries in %.1fs", n, secs))
    end)
end

-- zero a key group, or restore it
-- Direct memory_write, NOT applygc. Measured: applygc caused ~100ms scheduler
-- stalls every few seconds (loop throughput collapsing 680/s -> 10/s), which
-- crippled the aimbot. Writing the cached addresses costs 1.6ms for 488 and
-- the values never drift back, so nothing needs re-applying.
local function apply(keys, on, label)
    if not CB.Prepared then setStatus("press Prepare first"); return end
    local want = {}
    for _, k in ipairs(keys) do want[k] = true end
    local t0, written, skipped = tick(), 0, 0
    for _, e in ipairs(CB.Cache) do
        if e.addr and want[tostring(e.key)] and tostring(e.type) == "number" then
            if on then
                local ok = pcall(function() memory_write("double", e.addr, 0) end)
                if ok then written = written + 1 else skipped = skipped + 1 end
            else
                -- guarded restore: only write back where the live value still reads
                local orig = CB.Originals[e.addr]
                local okr, live = pcall(function() return memory_read("double", e.addr) end)
                if orig and okr and type(live) == "number" then
                    pcall(function() memory_write("double", e.addr, orig) end)
                    written = written + 1
                else
                    skipped = skipped + 1
                end
            end
        end
    end
    setStatus(string.format("%s %s - %d written, %d skipped (%.1fms)",
        label, on and "ON" or "OFF", written, skipped, (tick() - t0) * 1000))
    print(string.format("[combat] %s %s: %d written, %d skipped",
        label, on and "ON" or "OFF", written, skipped))
end

