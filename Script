-- metres -> studs, once at load
E.Cluster        = E.ClusterM   * E.DistanceDivisor
E.SiteMatch      = E.SiteMatchM * E.DistanceDivisor
E.LootTrustRange = E.LootTrustM * E.DistanceDivisor
E.MaxDistance    = E.MaxDistM   * E.DistanceDivisor

-- ---------------- visual style ----------------
local STYLE = {
    unlooted = C( 80, 230, 120),   -- green: alive, worth going
    unknown  = C(165, 170, 180),   -- gray: no information
    looted   = C(235,  80,  80),   -- red: rarely seen, sites are wiped
    name     = C(245, 246, 250),   -- white label
    NameSize = 13,
    SubSize  = 12,
    Ring     = 5,
    Core     = 2,
}
_G.EventESP = E

function E:Set(name, on)
    if not self.Categories[name] then return end
    self.Enabled[name] = on and true or false
    if not on then
        self.Registry[name]  = nil
        self.Primed[name]    = nil
        self.NpcPts[name]    = nil
        self.NpcNames[name]  = nil
        self.Wiped[name]     = nil
        -- StructPts kept: disabled structures still arbitrate NPC ownership
    end
end
function E:Stop() _G.ESP_RUNNING = false end
function E:Forget(name)
    if name then self.Registry[name] = nil; self.Wiped[name] = nil
    else self.Registry = {}; self.Wiped = {} end
end

local PART = {Part=true, MeshPart=true, UnionOperation=true, WedgePart=true, TrussPart=true, CornerWedgePart=true}
local function anchor(o, d)
    d = d or 3
    if PART[o.ClassName] then
        local p = o.Position
        if typeof(p) == "Vector3" then return o end
    end
    if d <= 0 then return nil end
    for _, c in ipairs(o:GetChildren()) do
        local a = anchor(c, d - 1)
        if a then return a end
    end
    return nil
end
local function npcMatch(ln, def)
    if def.npcAll then
        for _, w in ipairs(def.npcAll) do
            if not string.find(ln, w, 1, true) then return false end
        end
        return true
    end
    if def.npcs then
        for _, w in ipairs(def.npcs) do
            if string.find(ln, w, 1, true) then return true end
        end
    end
    return false
end
local function sharedMatch(ln)
    for _, pat in ipairs(E.SharedNpcs) do
        local all = true
        for _, w in ipairs(pat) do
            if not string.find(ln, w, 1, true) then all = false; break end
        end
        if all then return true end
    end
    return false
end
local function structMatch(ln, def)
    if not def.structures then return false end
    for _, w in ipairs(def.structures) do
        if string.find(ln, w, 1, true) then return true end
    end
    return false
end
-- full names kept: only the event tag is stripped, weapon suffix preserved
local function tidyName(n)
    n = string.gsub(n, "^Unique ", "")
    n = string.gsub(n, " Crash Site$", "")
    n = string.gsub(n, " Event$", "")
    return n
end
local function collapse(names)
    local counts, order = {}, {}
    for _, n in ipairs(names or {}) do
        if not counts[n] then counts[n] = 0; order[#order + 1] = n end
        counts[n] += 1
    end
    table.sort(order, function(a, b)
        if counts[a] ~= counts[b] then return counts[a] > counts[b] end
        return a < b
    end)
    return order, counts
end
local function metres(studs)
    return math.floor(studs / E.DistanceDivisor + 0.5)
end

local function rebuildSites()
    local now = tick()
    local pastGrace = (now - E.StartTime) > E.GraceSeconds
    local cpos = camPos()

    -- index EVERY structure, enabled or not, so ownership is always decided
    -- correctly even when the owning event is toggled off
    local structIndex = {}
    for cat, pts in pairs(E.StructPts) do
        for _, p in ipairs(pts) do structIndex[#structIndex + 1] = {pos = p, cat = cat} end
    end

    -- category-matched NPCs: reassigned to the structure they stand at
    local npcByCat = {}
    E.NpcNames = {}
    for cat, entries in pairs(E.NpcPts) do
        if E.Enabled[cat] then
            for _, entry in ipairs(entries) do
                local best, bestD = cat, E.Cluster
                for _, s in ipairs(structIndex) do
                    local d = (s.pos - entry.pos).Magnitude
                    if d < bestD then best, bestD = s.cat, d end
                end
                if E.Enabled[best] then      -- owned by a disabled event -> discard
                    npcByCat[best] = npcByCat[best] or {}
                    table.insert(npcByCat[best], {pos = entry.pos, name = entry.name})
                    E.NpcNames[best] = E.NpcNames[best] or {}
                    table.insert(E.NpcNames[best], entry.name)
                end
            end
        end
    end

    -- shared NPCs belong to whichever structure they stand at, or nobody
    for _, entry in ipairs(E.SharedPts or {}) do
        local best, bestD = nil, E.Cluster
        for _, s in ipairs(structIndex) do
            local d = (s.pos - entry.pos).Magnitude
            if d < bestD then best, bestD = s.cat, d end
        end
        if best and E.Enabled[best] then
            npcByCat[best] = npcByCat[best] or {}
            table.insert(npcByCat[best], {pos = entry.pos, name = entry.name})
            E.NpcNames[best] = E.NpcNames[best] or {}
            table.insert(E.NpcNames[best], entry.name)
        end
    end

    local out = {}
    for _, cat in ipairs(E.Order) do
        local def = E.Categories[cat]
        if E.Enabled[cat] then
            local hasStruct = def.structures ~= nil

            local pts = {}
            for _, p in ipairs(E.StructPts[cat] or {}) do
                pts[#pts + 1] = {pos = p, s = true}
            end
            for _, en in ipairs(npcByCat[cat] or {}) do
                pts[#pts + 1] = {pos = en.pos, s = false, name = en.name}
            end

            -- cluster into sites, collecting each site's roster
            local used, sites = {}, {}
            for i = 1, #pts do
                if not used[i] then
                    used[i] = true
                    local spos, npcN, names = pts[i].pos, 0, {}
                    if not pts[i].s then npcN = 1; names[1] = pts[i].name end
                    for j = i + 1, #pts do
                        if not used[j] and (pts[j].pos - pts[i].pos).Magnitude < E.Cluster then
                            used[j] = true
                            if pts[j].s then
                                spos = pts[j].pos
                            else
                                npcN += 1
                                names[#names + 1] = pts[j].name
                            end
                        end
                    end
                    if pts[i].s then spos = pts[i].pos end
                    sites[#sites + 1] = {pos = spos, npcN = npcN, names = names}
                end
            end

            local reg = E.Registry[cat] or {}
            E.Registry[cat] = reg
            local seen = {}

            for _, s in ipairs(sites) do
                local key, rec
                for k, t in pairs(reg) do
                    if (t.pos - s.pos).Magnitude < E.SiteMatch then key = k; rec = t; break end
                end
                key = key or string.format("%d,%d", math.floor(s.pos.X), math.floor(s.pos.Z))

                -- a site we already wiped stays gone until its NPCs come back
                if s.npcN == 0 and not rec then
                    local sup, blocked = E.Wiped[cat], false
                    if sup then
                        for _, w in ipairs(sup) do
                            if (now - w.t) < E.LootedSuppress
                               and (w.pos - s.pos).Magnitude < E.SiteMatch then
                                blocked = true; break
                            end
                        end
                    end
                    if blocked then continue end
                end

                local dist = cpos and (s.pos - cpos).Magnitude or math.huge
                local raw
                if s.npcN > 0 then
                    raw = "unlooted"                    -- presence is proof
                elseif dist <= E.LootTrustRange then
                    raw = "looted"                      -- close enough to trust absence
                elseif rec and rec.everUnlooted then
                    raw = "unlooted"                    -- sticky: proven alive
                else
                    raw = "unknown"                     -- never seen populated
                end

                if not rec then
                    rec = {pos = s.pos, state = raw, streak = 0, lastAlert = 0,
                           unlootedStreak = 0, announced = false, lastSeen = now,
                           names = {}, everUnlooted = (raw == "unlooted")}
                    reg[key] = rec
                end
                rec.pos, rec.lastSeen = s.pos, now
                if s.npcN > 0 then
                    rec.names = s.names
                    rec.everUnlooted = true        -- proven populated
                elseif raw == "looted" then
                    rec.names = {}
                    rec.everUnlooted = false
                end
                seen[key] = true

                if raw == "unlooted" then rec.unlootedStreak = (rec.unlootedStreak or 0) + 1
                else rec.unlootedStreak = 0 end

                if raw == "unknown" then
                    rec.state = "unknown"; rec.streak = 0
                elseif raw ~= rec.state then
                    rec.streak += 1
                    if rec.streak >= E.ConfirmScans then
                        local wasLooted = (rec.state == "looted")
                        rec.state = raw; rec.streak = 0
                        if raw == "unlooted" and wasLooted and rec.announced
                           and pastGrace and (now - rec.lastAlert) > E.RenotifyCooldown then
                            toast(def.label, "has respawned", 6)
                            rec.lastAlert = now
                        end
                    end
                else
                    rec.streak = 0
                end

                -- a new site announces only after holding unlooted for ConfirmScans
                if not rec.announced and rec.unlootedStreak >= E.ConfirmScans then
                    if pastGrace and E.Primed[cat] then
                        toast(def.label, "has spawned", 6)
                        rec.lastAlert = now
                    end
                    rec.announced = true
                end

                -- LOOTED = WIPED: drop the site and suppress re-registration
                if rec.state == "looted" then
                    reg[key] = nil
                    E.Wiped[cat] = E.Wiped[cat] or {}
                    table.insert(E.Wiped[cat], {pos = rec.pos, t = now})
                end
            end

            for key, rec in pairs(reg) do
                if not seen[key] then
                    local dist = cpos and (rec.pos - cpos).Magnitude or math.huge
                    if (now - rec.lastSeen) > E.SiteTTL then
                        reg[key] = nil                        -- stale memory
                    elseif dist <= E.LootTrustRange then
                        reg[key] = nil                        -- gone while we watched
                        if not hasStruct then
                            E.Wiped[cat] = E.Wiped[cat] or {}
                            table.insert(E.Wiped[cat], {pos = rec.pos, t = now})
                        end
                    else
                        rec.state = rec.everUnlooted and "unlooted" or "unknown"
                    end
                end
            end

            for _, rec in pairs(reg) do
                out[#out + 1] = {cat = cat, pos = rec.pos,
                                 name = def.label, state = rec.state}
            end
            E.Primed[cat] = true
        end
    end

    -- expire suppression entries
    for cat, sup in pairs(E.Wiped) do
        for i = #sup, 1, -1 do
            if (now - sup[i].t) > E.LootedSuppress then table.remove(sup, i) end
        end
    end

    E.Targets = out
end

-- ---------------- SCANNER (never blocks drawing) ----------------
task.spawn(function()
    local myGen = _G.ESP_GEN
    local lastEl = 0
    while _G.ESP_RUNNING and _G.ESP_GEN == myGen do
        local zom = workspace:FindFirstChild("Zombies")
        if zom then
            local fresh, shared = {}, {}
            for _, z in ipairs(zom:GetChildren()) do
                local nm = z.Name
                local ln = string.lower(nm)
                local claimed = false
                for _, cat in ipairs(E.Order) do
                    if E.Enabled[cat] and npcMatch(ln, E.Categories[cat]) then
                        local a = anchor(z)
                        if a then
                            fresh[cat] = fresh[cat] or {}
                            table.insert(fresh[cat], { pos = a.Position, name = tidyName(nm) })
                        end
                        claimed = true
                        break
                    end
                end
                if not claimed and sharedMatch(ln) then
                    local a = anchor(z)
                    if a then
                        shared[#shared + 1] = { pos = a.Position, name = tidyName(nm) }
                    end
                end
            end
            E.NpcPts, E.SharedPts = fresh, shared
        end

        if tick() - lastEl > E.ElementInterval then
            lastEl = tick()
            local el = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Elements")
            if el then
                local kids = el:GetChildren()
                local fresh = {}
                for i, c in ipairs(kids) do
                    local ln = string.lower(c.Name)
                    for _, cat in ipairs(E.Order) do
                        if structMatch(ln, E.Categories[cat]) then    -- no Enabled gate
                            local a = anchor(c)
                            if a then
                                fresh[cat] = fresh[cat] or {}
                                table.insert(fresh[cat], a.Position)
                            end
                            break
                        end
                    end
                    if i % E.ChunkSize == 0 then task.wait() end
                end
                E.StructPts = fresh
            end
        end

        rebuildSites()
        task.wait(E.NpcInterval)
    end
end)

-- ---------------- RENDERER (pure drawing) ----------------
-- Colour is assigned every frame; Font and Transparency are left at defaults,
-- since setting those is what turned the text black.
task.spawn(function()
    local myGen = _G.ESP_GEN
    local pool = {}
    for i = 1, E.PoolSize do
        local ring = Drawing.new("Circle")
        ring.Thickness = 1; ring.Filled = false; ring.NumSides = 18
        ring.Radius = STYLE.Ring; ring.Visible = false
        local core = Drawing.new("Circle")
        core.Filled = true; core.NumSides = 12
        core.Radius = STYLE.Core; core.Visible = false
        local name = Drawing.new("Text")
        name.Size = STYLE.NameSize; name.Center = true; name.Outline = true
        name.Visible = false
        local sub = Drawing.new("Text")
        sub.Size = STYLE.SubSize; sub.Center = true; sub.Outline = true
        sub.Visible = false
        pool[i] = {ring = ring, core = core, name = name, sub = sub}
    end

    local function hide(e)
        e.ring.Visible = false; e.core.Visible = false
        e.name.Visible = false; e.sub.Visible = false
    end

    while _G.ESP_RUNNING and _G.ESP_GEN == myGen do
        if iskeypressed and iskeypressed(0x76) then   -- F7 panic
            if setrobloxinput then pcall(function() setrobloxinput(true) end) end
            _G.ESP_RUNNING = false
        end
        local cpos = camPos()
        local list, n = E.Targets, 0
        for i = 1, #list do
            if n >= E.PoolSize then break end
            local t = list[i]
            if cpos and E.Enabled[t.cat] then
                local dist = (t.pos - cpos).Magnitude
                if dist <= E.MaxDistance then
                    local pt, vis = toScreen(t.pos + Vector3.new(0, 2, 0))
                    if vis then
                        n += 1
                        local e = pool[n]
                        local col = STYLE[t.state] or STYLE.name

                        e.ring.Position = pt
                        e.ring.Color = col
                        e.ring.Visible = true

                        e.core.Position = pt
                        e.core.Color = col
                        e.core.Visible = true

                        e.name.Text = t.name
                        e.name.Position = Vector2.new(pt.X, pt.Y - 30)
                        e.name.Color = STYLE.name
                        e.name.Visible = true

                        local sub = metres(dist) .. E.DistanceUnit
                        if t.state == "unknown" then sub = sub .. "  ?" end
                        e.sub.Text = sub
                        e.sub.Position = Vector2.new(pt.X, pt.Y - 16)
                        e.sub.Color = col
                        e.sub.Visible = true
                    end
                end
            end
        end
        _G.ESP_COUNT = n
        for i = n + 1, E.PoolSize do hide(pool[i]) end
        task.wait()
    end

    for i = 1, E.PoolSize do
        pool[i].ring:Remove(); pool[i].core:Remove()
        pool[i].name:Remove(); pool[i].sub:Remove()
    end
end)

