_G.VEHMOD.FlySpeed   = _G.VEHMOD.FlySpeed or 70
_G.VEHMOD.Range      = 15
_G.VEHMOD.Trigger    = "Key"   -- forced, same reason
_G.VEHMOD.State      = "off"
_G.VEHMOD.TRIG = { ["Mouse 4"] = 0x05, ["Mouse 5"] = 0x06, ["Right Mouse"] = 0x02, ["Space"] = 0x20 }

_G.VEHMOD.ui = {}
_G.VEHMOD.ui.sub = combattab:Sub("Vehicle Mods", "compass")
_G.VEHMOD.ui.sec = _G.VEHMOD.ui.sub:Section("Drive", "Full")
_G.VEHMOD.ui.sec:Label("Moves the VEHICLE, not you. Time in the air is the cost:")
