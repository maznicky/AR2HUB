-- one scan for all 26 keys, ~30s, once per session
local function prepare()
    if CB.Scanning then return end
    CB.Scanning = true
    setStatus("scanning... game freezes ~30s, ONCE per session")
    task.wait(0.1)
    task.spawn(function()
        local t0 = tick()
        local ok, cache = pcall(function() return getgc(allKeys()) end)
        local secs = tick() - t0
        if not ok or type(cache) ~= "table" or #cache == 0 then
            CB.Scanning = false
            setStatus(string.format("scan failed after %.1fs", secs))
            return
        end
        CB.Originals = {}
        local n = 0
        for _, e in ipairs(cache) do
            if e.addr and tostring(e.type) == "number" then
                CB.Originals[e.addr] = tonumber(e.value) or 0
                n = n + 1
            end
        end
        CB.Cache, CB.Prepared, CB.Scanning = cache, true, false
        setStatus(string.format("ready - %d values cached in %.0fs", n, secs))
        print(string.format("[combat] prepared: %d entries in %.1fs", n, secs))
    end)
