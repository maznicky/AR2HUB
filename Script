            vehCount:SetText(string.format("%d of %d types selected", onCount, allCount))
        end)

        if VE.Enabled then
            local cp = camPos()
            local shortlist = {}
            if cp and anyType then
                local maxStuds = VE.MaxM * E.DistanceDivisor
                for _, e in ipairs(VE.Cache) do
                    if VE.Types[e.name] == true then
                        -- The arithmetic is wrapped, not just the read: Matcha
                        -- falls back to FindFirstChild for unsupported properties,
                        -- so .Position can hand back an INSTANCE instead of a
                        -- Vector3. That threw "Vector3Meta expected, got Instance"
                        -- and silently killed the loop it happened in.
                        local ok, pos = pcall(function() return e.part.Position end)
                        local okd, d = false, nil
                        if ok and pos then
                            okd, d = pcall(function() return (pos - cp).Magnitude end)
                        end
                        if okd and type(d) == "number" then
                            if d <= maxStuds then
                                shortlist[#shortlist + 1] = { e = e, d = d }
                            end
                        end
                    end
                end
                table.sort(shortlist, function(a, b) return a.d < b.d end)
            end

            local shown = math.min(#shortlist, VEH_ROWS)
            pcall(function()
                if not anyType then
                    detHead:SetText("no types selected")
