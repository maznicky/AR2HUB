-- Finds the vehicle you are in via the ESP cache rather than walking the Vehicles
-- folder: enumerating all 79 of them alongside the ESP's own sweep is what took
-- Matcha down during this investigation.
-- Result is cached briefly. This walks all ~79 cached vehicles reading a position
-- from each, about 4 ms, and Auto Right was calling it every tick for as long as
-- Boost or Fly was enabled - 80 ms of every second spent re-answering the same
-- question. Everything here runs alongside several ESP sweeps, so that mattered.
-- Engine condition, read straight off the vehicle rather than through the ESP cache.
-- VM.EngineNow used to be refreshed only inside the flight loops, so between trips it
-- held the LAST vehicle's reading - a fresh 68% Mustang was judged as the 15% wreck
-- that preceded it, which would refuse or abort flights it could easily complete.
_G.VEHMOD.engineOf = function(base)
    if not base then return nil end
    local model = base.Parent
    local inter = model and model:FindFirstChild("Interaction")
    local ref = inter and inter:FindFirstChild("Repair Engine")
    if not ref then return nil end
    local ok, h = pcall(function() return ref:GetAttribute("Health") end)
    if ok and type(h) == "table" and type(h.y) == "number" then return h.y end
    return nil
end

_G.VEHMOD.baseNear = function(myPos, maxAge)
    local VM = _G.VEHMOD
    local now = tick()
    if VM.nearAt and (now - VM.nearAt) < (maxAge or 1.0) and VM.nearBase then
        local okv = pcall(function() return VM.nearBase.Position end)
        if okv then return VM.nearBase, VM.nearWhy end
    end
    -- FAILURE backoff. A miss used to re-scan on the very next call, so autopilot with
    -- no vehicle locked asked 30 times a second. The scan measured 4 ms on a healthy
    -- client, but under load each lookup inflates the same way every other read does,
    -- and it starved the client to a fifth of a frame per second - health hit its 0.05
    -- floor and the game stopped responding. A failed search must cost almost nothing
    -- to repeat, so it simply is not repeated for a while.
    if VM.nearFailAt and (now - VM.nearFailAt) < 2.0 and not VM.nearBase then
        return nil, VM.nearWhy or "no vehicle within reach"
    end
    VM.nearAt = now
    local cache = _G.VEHESP and _G.VEHESP.Cache
    if not cache or #cache == 0 then
        -- Fall back to reading the Vehicles folder directly. Using the ESP's cache is
        -- cheaper, but depending on it meant every Vehicle Mods feature silently did
        -- nothing whenever Vehicle ESP happened to be switched off - autopilot just sat
        -- in "no vehicle" after a button press with no visible reason. A feature should
        -- not fail because an unrelated toggle is off.
        local vf = workspace:FindFirstChild("Vehicles")
        if not vf then return nil, "no Vehicles folder" end
        local fb, fbd, fbn
        for _, v in ipairs(vf:GetChildren()) do
            local b = v:FindFirstChild("Base")
            if b then
                local okp, p = pcall(function() return b.Position end)
                if okp and p then
                    local okd, d = pcall(function() return (p - myPos).Magnitude end)
                    if okd and d <= VM.Range and (not fbd or d < fbd) then
                        fb, fbd, fbn = b, d, v.Name
                    end
                end
            end
        end
        VM.nearBase, VM.nearWhy = fb, fb and fbn or "no vehicle within reach"
        VM.nearFailAt = (not fb) and now or nil
        return fb, VM.nearWhy
    end
    local best, bd
    for _, e in ipairs(cache) do
        local okp, p = pcall(function() return e.part.Position end)
        if okp and p then
            local okd, d = pcall(function() return (p - myPos).Magnitude end)
            if okd and (not bd or d < bd) then best, bd = e, d end
        end
    end
    if not best or bd > _G.VEHMOD.Range then
        VM.nearBase, VM.nearWhy = nil, "no vehicle within reach"
        return nil, VM.nearWhy
    end
    local model = best.part.Parent
    local base = model and model:FindFirstChild("Base")
    VM.nearBase = base
    VM.nearWhy = base and best.name or "no Base part"
    return base, VM.nearWhy
end

-- ---- flight log ----
-- Answers the three questions that matter for planning a trip, and does it inside the
-- script rather than through an external recorder, because every recorder I ran from
-- outside either got cut off mid-run or contributed to a crash.
--
--   how far before damage   - distance and air time when engine health FIRST drops
--   how fast is possible    - peak speed measured from position change, not the
--                             velocity property, which reads mid-ramp values
--   does ground time reset  - time spent grounded before each flight is recorded
--                             alongside how long that flight lasted before damage,
--                             so the two can be compared across runs
--
-- Engine health is a fraction of a maximum that differs per vehicle, so the drop
-- SIZE is not comparable between vehicles - the timing of the first drop is.
_G.FLIGHTLOG = _G.FLIGHTLOG or { runs = {} }
_G.VEHMOD.ui.logSec = _G.VEHMOD.ui.sub:Section("Flight Log", "Full")
_G.VEHMOD.ui.logA = _G.VEHMOD.ui.logSec:Label("grounded")
_G.VEHMOD.ui.logB = _G.VEHMOD.ui.logSec:Label("-")
_G.VEHMOD.ui.logC = _G.VEHMOD.ui.logSec:Label("no damage recorded yet")
_G.VEHMOD.ui.logSec:Button("Reset Log", function()
    _G.FLIGHTLOG.runs = {}
    _G.FLIGHTLOG.first = nil
    pcall(function() Lib:Notify("flight log cleared", 2) end)
end, "Clears the recorded runs. The current flight keeps going.")
_G.VEHMOD.ui.logSec:Button("Print Log", function()
    local L = _G.FLIGHTLOG
    print("---- AR2 Hub flight log ----")
    print(string.format("%d run%s recorded", #L.runs, (#L.runs == 1) and "" or "s"))
    for i, r in ipairs(L.runs) do
        print(string.format("%2d. grounded %5.1fs | flew %5.1fs, %6.0f studs, peak %4.0f | tilted %4.1fs, worst level %.2f | %s",
            i, r.groundBefore or -1, r.air or -1, r.dist or -1, r.peak or -1,
            r.tilted or -1, r.minLevel or -1,
            r.dmgAir and string.format("DAMAGE at %.1fs, level %.2f (tilted %.1fs by then)",
                                       r.dmgAir, r.dmgLevel or -1, r.dmgTilted or -1)
                     or "no damage"))
    end
end, "Dumps every recorded run to the console, one line each.")

task.spawn(function()
    local VM = _G.VEHMOD
    local L = _G.FLIGHTLOG
    local run, lastPos, lastT, groundAt, lastEng = nil, nil, tick(), tick(), nil
    while _G.AR2HUB_GEN == GEN do
        local okr, P = pcall(function() return svcPlayers() end)
        local lp = (okr and P) and P.LocalPlayer or nil
        local ch = lp and lp.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart") or nil
        local myPos
        if hrp then
            local okp, p = pcall(function() return hrp.Position end)
            myPos = okp and p or nil
        end
        -- long cache: the log is a passive observer and must never drive a search
        local base = myPos and VM.baseNear(myPos, 3.0) or nil
        if base then
            local okp, pos = pcall(function() return base.Position end)
            -- read it here too, on a timer, so the log and the guards agree even when
            -- no flight loop is running
            local nowE = tick()
            if nowE - (VM.engAt or 0) > 0.5 then
                VM.engAt = nowE
                VM.EngineNow = VM.engineOf(base) or VM.EngineNow
            end
            local eng = VM.EngineNow
            if okp and pos then
                local now = tick()
                -- ground reference: the lowest recent altitude counts as ground, so
                -- "airborne" means well above wherever this vehicle was sitting
                if not run then
                    run = { groundY = pos.Y, air = 0, dist = 0, peak = 0,
                            eng0 = eng, groundBefore = now - groundAt,
                            minLevel = 1, tilted = 0 }
                end
                -- Orientation, to test whether flight damage is really the same
                -- "vehicle is not upright" rule that drains it on the ground. The
                -- Jeep exploded at 12% engine rather than 0%, so the explosion is a
                -- separate trigger from the drain - and nothing here controls
                -- rotation, since angular velocity cannot be written, so a flying
                -- vehicle is free to tumble.
                local okc, vcf = pcall(function() return base.CFrame end)
                local level = (okc and vcf) and vcf.UpVector.Y or 1
                if level < run.minLevel then run.minLevel = level end
                local airborne = (pos.Y - run.groundY) > 10
                local dt = now - lastT
                if lastPos and dt > 0 then
                    local seg = (pos - lastPos).Magnitude
                    local sp = seg / dt
                    if airborne then
                        run.air = run.air + dt
                        run.dist = run.dist + seg
                        if sp > run.peak then run.peak = sp end
                        if level < 0.9 then run.tilted = run.tilted + dt end
                    end
                end
                -- first engine drop of this flight is the number being hunted
                if eng and lastEng and eng < lastEng - 0.0005 and airborne and not run.dmgAir then
                    run.dmgAir, run.dmgDist = run.air, run.dist
                    -- the number that decides it: was the vehicle upright when the
                    -- engine first took damage, or already tumbling?
                    run.dmgLevel, run.dmgTilted = level, run.tilted
                    L.first = L.first or { air = run.air, dist = run.dist,
                                           ground = run.groundBefore, peak = run.peak }
                end
                if eng then lastEng = eng end
                if not airborne then
                    if run.air > 1.5 then
                        -- A real flight just ended: file it, and learn the drain rate
                        -- from it. A flat "don't fly below 15%" threshold is the wrong
                        -- test - a 4,380 stud hop was completed on a 15% engine because
                        -- it took two seconds, while a slow trip at 40% could strand
                        -- you. Cost is time multiplied by this rate.
                        if run.eng0 and eng and run.air > 1 then
                            local spent = run.eng0 - eng
                            if spent > 0 then
                                local r = spent / run.air
                                L.rate = L.rate and (L.rate * 0.6 + r * 0.4) or r
                            end
                        end
                        L.runs[#L.runs + 1] = run
                        run = nil
                        groundAt = now
                    else
                        run.groundY = math.min(run.groundY, pos.Y)
                        run.groundBefore = now - groundAt
                    end
                end
                lastPos, lastT = pos, now
                VM.logLive = run
            end
        else
            groundAt = groundAt or tick()
        end
        task.wait(0.2)
    end
end)

