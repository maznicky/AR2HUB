end, "Dumps every recorded run to the console, one line each.")

AR2SPAWN("ram", function()
    local VM = _G.VEHMOD
    local L = _G.FLIGHTLOG
    local run, lastPos, lastT, groundAt, lastEng = nil, nil, tick(), tick(), nil
    while _G.AR2HUB_GEN == GEN do
        local okr, P = pcall(function() return svcPlayers() end)
        local lp = (okr and P) and P.LocalPlayer or nil
        local ch = lp and lp.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart") or nil
        local myPos
        if hrp then
            local okp, p = pcall(function() return hrp.Position end)
            myPos = okp and p or nil
        end
        -- long cache: the log is a passive observer and must never drive a search
        local base = myPos and VM.baseNear(myPos, 3.0) or nil
        if base then
            local okp, pos = pcall(function() return base.Position end)
            -- read it here too, on a timer, so the log and the guards agree even when
            -- no flight loop is running
            local nowE = tick()
            if nowE - (VM.engAt or 0) > 0.5 then
                VM.engAt = nowE
                VM.EngineNow = VM.engineOf(base) or VM.EngineNow
            end
            local eng = VM.EngineNow
            if okp and pos then
                local now = tick()
                -- ground reference: the lowest recent altitude counts as ground, so
                -- "airborne" means well above wherever this vehicle was sitting
                if not run then
                    run = { groundY = pos.Y, air = 0, dist = 0, peak = 0,
                            eng0 = eng, groundBefore = now - groundAt,
                            minLevel = 1, tilted = 0 }
                end
                -- Orientation, to test whether flight damage is really the same
                -- "vehicle is not upright" rule that drains it on the ground. The
                -- Jeep exploded at 12% engine rather than 0%, so the explosion is a
                -- separate trigger from the drain - and nothing here controls
                -- rotation, since angular velocity cannot be written, so a flying
                -- vehicle is free to tumble.
                local okc, vcf = pcall(function() return base.CFrame end)
                local level = (okc and vcf) and vcf.UpVector.Y or 1
                if level < run.minLevel then run.minLevel = level end
                local airborne = (pos.Y - run.groundY) > 10
                local dt = now - lastT
                if lastPos and dt > 0 then
                    local seg = (pos - lastPos).Magnitude
                    local sp = seg / dt
                    if airborne then
                        run.air = run.air + dt
                        run.dist = run.dist + seg
                        if sp > run.peak then run.peak = sp end
                        if level < 0.9 then run.tilted = run.tilted + dt end
                    end
                end
                -- first engine drop of this flight is the number being hunted
                if eng and lastEng and eng < lastEng - 0.0005 and airborne and not run.dmgAir then
                    run.dmgAir, run.dmgDist = run.air, run.dist
                    -- the number that decides it: was the vehicle upright when the
                    -- engine first took damage, or already tumbling?
                    run.dmgLevel, run.dmgTilted = level, run.tilted
                    L.first = L.first or { air = run.air, dist = run.dist,
                                           ground = run.groundBefore, peak = run.peak }
                end
                if eng then lastEng = eng end
                if not airborne then
                    if run.air > 1.5 then
                        -- A real flight just ended: file it, and learn the drain rate
                        -- from it. A flat "don't fly below 15%" threshold is the wrong
                        -- test - a 4,380 stud hop was completed on a 15% engine because
                        -- it took two seconds, while a slow trip at 40% could strand
                        -- you. Cost is time multiplied by this rate.
                        if run.eng0 and eng and run.air > 1 then
                            local spent = run.eng0 - eng
                            if spent > 0 then
                                local r = spent / run.air
                                L.rate = L.rate and (L.rate * 0.6 + r * 0.4) or r
                            end
                        end
                        L.runs[#L.runs + 1] = run
                        run = nil
                        groundAt = now
                    else
                        run.groundY = math.min(run.groundY, pos.Y)
                        run.groundBefore = now - groundAt
                    end
                end
                lastPos, lastT = pos, now
                VM.logLive = run
            end
        else
            groundAt = groundAt or tick()
        end
        task.wait(0.2)
    end
end)

