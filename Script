                local ok, d = pcall(function() return iskeypressed(vk) end)
                held = (ok and d) and true or false
            end
            if not held then
                VM.ramPart, VM.ramPickAt = nil, 0     -- fresh target on the next press
                VM.RamState = "ready - hold " .. tostring(VM.RamTrigger)
