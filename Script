-- ==================== Scheduler health ====================
-- Every heavy sweep in this script is budgeted per tick, but the budgets were each
-- chosen in isolation. Together they can outrun the client: reads that cost 0.05 ms
-- on a healthy client were measured at 7 ms under contention, which makes every
-- budget 140x too large at exactly the moment it needs to be smaller. That spiral
-- has taken Matcha down twice - once from a scan loop of mine, once from turning on
-- one ESP too many.
--
-- So the sweeps ask this how healthy the scheduler is and scale their budgets by it.
-- It measures nothing but its own lateness: a loop asking for 0.05 s that gets 0.5 s
-- reports 0.1, and every sweep then does a tenth of the work until it recovers.
_G.AR2HUB_HEALTH = 1
task.spawn(function()
    local last = tick()
    while _G.AR2HUB_GEN == GEN do
        task.wait(0.05)
        local now = tick()
        local dt = now - last
        last = now
        local ratio = 0.05 / math.max(dt, 0.001)
        if ratio > 1 then ratio = 1 end
        -- fall fast, recover slowly: dropping work quickly is what breaks the spiral
        local prev = _G.AR2HUB_HEALTH or 1
        local blend = (ratio < prev) and 0.6 or 0.1
        local v = prev * (1 - blend) + ratio * blend
        if v < 0.05 then v = 0.05 elseif v > 1 then v = 1 end
        _G.AR2HUB_HEALTH = v
    end
end)

