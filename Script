-- ---------------- panel: boxes created and destroyed with players ----------------
-- playertab._tab.sections is the array the lib's layout pass iterates.
-- Splicing an entry out of it removes the box; appending adds one at runtime.
local pvSections = playertab._tab and playertab._tab.sections

local function makeBox(userId)
    local box = playertab:Section("-", "Full")
    local row = {
        userId = userId,
        box    = box,
        pri    = box:Label("Primary: -"),
        sec    = box:Label("Secondary: -"),
        mel    = box:Label("Melee: -"),
    }
    row.mark = box:Label("Mark: none")
    box:Button("Cycle Mark", function() cycleMark(userId) end,
        "none -> whitelisted (ignored by aimbot and melee) -> prioritised (red outline) -> none")
    return row
end

local function destroyBox(row)
    if not (pvSections and row and row.box) then return end
    local target = rawget(row.box, "_section")
    for i = #pvSections, 1, -1 do
        if pvSections[i] == target then table.remove(pvSections, i) end
    end
end

task.spawn(function()
    while PV.Running and _G.AR2HUB_GEN == GEN do
        local cpos = pvCamPos()
        local Players = svcPlayers()
        if not Players then
            task.wait(1)          -- handle is stale; wait for it rather than throw
            continue
        end
        local lp = Players.LocalPlayer
        local lpId = lp and lp.UserId

        local present = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId ~= lpId then
                local ok, char = pcall(function() return p.Character end)
                local a = (ok and char) and pvAnchor(char) or nil
                if a then
                    local item, att = readEquipped(char)
                    if item and item ~= "" then
                        local slot = classify(item)
                        if slot then
                            local c = PV.Cache[p.UserId] or {}
                            c[slot] = {name = item, att = att}
                            PV.Cache[p.UserId] = c
                        end
                    end
                    present[p.UserId] = {
                        name = p.Name,
                        d = cpos and (a.Position - cpos).Magnitude / 2.75 or nil,
                    }
                end
            end
        end

        -- leavers: destroy their box
        for i = #PV.Rows, 1, -1 do
            local row = PV.Rows[i]
            if not present[row.userId] then
                pcall(destroyBox, row)
                PV.Cache[row.userId] = nil
                table.remove(PV.Rows, i)
            end
        end

        -- joiners: append a box at the bottom
        local have = {}
        for _, row in ipairs(PV.Rows) do have[row.userId] = true end
        for id in pairs(present) do
            if not have[id] then
                local ok, row = pcall(makeBox, id)
                if ok and row then PV.Rows[#PV.Rows + 1] = row end
            end
        end

        -- refresh contents
        for _, row in ipairs(PV.Rows) do
            local info = present[row.userId]
            if info then
                local c = PV.Cache[row.userId] or {}
                local pri = c.primary and (c.primary.name .. "  |  " .. c.primary.att) or "-"
                local sec = c.secondary and (c.secondary.name .. "  |  " .. c.secondary.att) or "-"
                local mel = c.melee and c.melee.name or "-"
                local dist = info.d and string.format("  |  %dm", math.floor(info.d + 0.5)) or ""
                local mk = markOf(row.userId)
                pcall(function() row.box:SetName((MARK_TAG[mk] or "") .. info.name .. dist) end)
                pcall(function() row.pri:SetText("Primary: " .. pri) end)
                pcall(function() row.sec:SetText("Secondary: " .. sec) end)
                pcall(function() row.mel:SetText("Melee: " .. mel) end)
                pcall(function() row.mark:SetText("Mark: " .. ((mk ~= "") and mk or "none")) end)
            end
        end
        task.wait(PV.Refresh)
    end
end)


-- ==================== Vehicle ESP (Visuals > Vehicles) ====================
-- Vehicles replicate map-wide, same as zombies and players, so nothing streams
-- out and the list is complete. Each vehicle is tracked by its Base part: since a game
-- update, PrimaryPart reads back as an unreadable, parentless instance on every vehicle
-- (0 of 66 gave a position, 2026-10-16), which left the ESP and Vehicle Mods with nothing.
_G.VEHESP = _G.VEHESP or {}
local VE = _G.VEHESP
VE.Enabled   = false
-- Start with an empty cache. It lives in _G, so a reload otherwise inherits the last
-- generation's entries - built by older code and never rebuilt while the ESP is off, which is
-- how a reload kept the dead PrimaryPart anchors and left Vehicle Mods blind.
VE.Cache     = {}
VE.MaxM      = VE.MaxM or 1000
VE.Types     = VE.Types or {}   -- name -> true to show that type; default off
VE.Cache     = VE.Cache or {}   -- reused across rebuilds, keyed by vehicle Id

local VEH_POOL   = 64
local VEH_ORANGE = C(245, 170,  70)   -- the middle band; red/green reuse STYLE
local VEH_BUILD  = 1.0                -- cache rebuild interval, seconds
local VEH_HEALTH = 0.75               -- how stale a condition reading may get
local VEH_PERTICK = 2                 -- vehicles resolved/refreshed per tick

-- Boats are always green: they have a Wheels model like everything else, but no
-- wheels to lose, so the condition reading is meaningless for them.
local VEH_BOATS = {
    ["Aluminum Boat"] = true, ["Rubber Dinghy"] = true, ["Speed Boat"] = true,
    ["Patrol Boat"] = true, ["Swing Keel Boat"] = true, ["Fishing Boat"] = true,
