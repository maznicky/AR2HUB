-- ==================== AR2 Hub - Event ESP ====================
-- 16 events grouped by faction. Per-event readout: Amount + nearest site's roster.
-- States: Unlooted (green) / Unknown (gray). Looted sites are WIPED, not shown.
-- Distances match Matcha's ESP (studs / 2.75, rounded). Config is in metres.
-- Site Probe: F8, plus an automatic sweep every 60s.
-- Everything starts DISABLED; nothing scans until toggled on.

-- ---------------- re-run guard ----------------
-- Loading this script a second time (which a loadstring URL makes easy) would
-- otherwise stack a second copy of every task.spawn loop and a second UI window
-- on top of the first. Bumping the generation makes every loop from the previous
-- load exit on its next tick; the renderer removes its own Drawings as it goes.
_G.AR2HUB_GEN = (_G.AR2HUB_GEN or 0) + 1
local GEN = _G.AR2HUB_GEN
if GEN > 1 then
    print(string.format("[AR2 Hub] reload #%d - retiring previous instance", GEN))
    if _G.AR2HUB_WIN then
        for _, m in ipairs({"Destroy", "Unload", "Close", "Remove"}) do
            pcall(function() _G.AR2HUB_WIN[m](_G.AR2HUB_WIN) end)
        end
        _G.AR2HUB_WIN = nil
    end
    -- never leave input trapped if the old window vanished mid-drag
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)   -- let the retiring loops notice before we respawn them
end

local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua"))() or INSui

-- ---------------- portability shims ----------------
local function getCamera()
    return workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
end
local function camPos()
    local cam = getCamera()
    if not cam then return nil end
    local ok, p = pcall(function() return cam.CFrame.Position end)
    if ok and typeof(p) == "Vector3" then return p end
    local ok2, p2 = pcall(function() return cam.Position end)
    if ok2 and typeof(p2) == "Vector3" then return p2 end
    return nil
end
local function toScreen(v3)
    if WorldToScreen then return WorldToScreen(v3) end
    local cam = getCamera()
    if not cam then return Vector2.new(0, 0), false end
    local p, vis = cam:WorldToViewportPoint(v3)
    return Vector2.new(p.X, p.Y), (vis and p.Z > 0)
end
local function toast(title, msg, dur)
    if Lib and Lib.Notify then
        local ok = pcall(function() Lib:Notify(title .. ": " .. msg, dur or 5) end)
        if ok then return end
    end
    if notify then
        local ok = pcall(function() notify(title, msg, dur or 5) end)
        if ok then return end
    end
    print("[" .. title .. "] " .. msg)
end

-- ---------------- input watchdog ----------------
-- Matcha's Players handle goes stale after time in-server; INS-ui then cannot
-- read the mouse and would trap your input. This always hands input back.
_G.UI_WATCHDOG = true
task.spawn(function()
    local wasAlive = nil
    while _G.UI_WATCHDOG and _G.AR2HUB_GEN == GEN do
        local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
        local alive = (ok and lp ~= nil)
        if wasAlive ~= nil and alive ~= wasAlive then
            if alive then
                toast("UI", "Players handle restored", 5)
            else
                if setrobloxinput then pcall(function() setrobloxinput(true) end) end
                toast("UI", "handle went stale - input released, reinject for the menu", 8)
            end
        end
        wasAlive = alive
        task.wait(2)
    end
end)

