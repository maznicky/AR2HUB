                                -- d == d rejects NaN, which a bad read can produce and
                                -- which makes table.sort throw "invalid order function"
                                -- - and an error here kills this loop for good
                                if okd and type(d) == "number" and d == d
                                   and d < math.huge and d <= maxStuds then
