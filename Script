-- ---------------- panel: boxes created and destroyed with players ----------------
-- playertab._tab.sections is the array the lib's layout pass iterates.
-- Splicing an entry out of it removes the box; appending adds one at runtime.
local pvSections = playertab._tab and playertab._tab.sections

local function makeBox(userId)
    local box = playertab:Section("-", "Full")
    local row = {
        userId = userId,
        box    = box,
        pri    = box:Label("Primary: -"),
        sec    = box:Label("Secondary: -"),
        mel    = box:Label("Melee: -"),
    }
    row.mark = box:Label("Mark: none")
    box:Button("Cycle Mark", function() cycleMark(userId) end,
        "none -> whitelisted (ignored by aimbot and melee) -> prioritised (red outline) -> none")
    return row
end

local function destroyBox(row)
    if not (pvSections and row and row.box) then return end
    local target = rawget(row.box, "_section")
    for i = #pvSections, 1, -1 do
        if pvSections[i] == target then table.remove(pvSections, i) end
    end
end

task.spawn(function()
    while PV.Running and _G.AR2HUB_GEN == GEN do
        local cpos = pvCamPos()
        local Players = svcPlayers()
        if not Players then
            task.wait(1)          -- handle is stale; wait for it rather than throw
            continue
        end
        local lp = Players.LocalPlayer
        local lpId = lp and lp.UserId

        local present = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId ~= lpId then
                local ok, char = pcall(function() return p.Character end)
                local a = (ok and char) and pvAnchor(char) or nil
                if a then
                    local item, att = readEquipped(char)
