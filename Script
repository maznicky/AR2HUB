-- Nearest thing worth hitting. Zombie roots come from the ESP cache when it is running
-- and from a throttled scan when it is not, because resolving ~80 roots costs about
-- 56 ms and must never sit on a per-tick path.
-- Returns the target PART, not a position, and is called on a timer rather than every
-- tick. Searching walks ~85 zombie roots reading a position from each: about 4 ms on a
-- healthy client, which is exactly the sort of cost that becomes hundreds of
-- milliseconds once the client is behind. Run at 20 Hz it froze the game every time
-- the ram key was pressed. Between searches the loop reads one position - the target's.
_G.VEHMOD.ramTarget = function(from)
    local VM = _G.VEHMOD
    local best, bd
    local function consider(part)
        local okp, p = pcall(function() return part.Position end)
        if not okp or not p then return end
        local okd, d = pcall(function() return (p - from).Magnitude end)
        if okd and d <= VM.RamRange and (not bd or d < bd) then best, bd = part, d end
    end
    if VM.RamPlayers then
        local okr, P = pcall(function() return svcPlayers() end)
        local lp = (okr and P) and P.LocalPlayer or nil
        if okr and P and lp then
            local marks = _G.PLAYERMARK or {}
            for _, pl in ipairs(P:GetPlayers()) do
                if pl.UserId ~= lp.UserId and marks[pl.UserId] ~= "whitelist" then
                    local okc, ch = pcall(function() return pl.Character end)
                    local r = (okc and ch) and ch:FindFirstChild("HumanoidRootPart") or nil
                    if r then consider(r) end
                end
            end
        end
    end
    if VM.RamZombies then
        local live = _G.ZOMBESP and _G.ZOMBESP.Live
        if live and #live > 0 then
            for _, e in ipairs(live) do if e.part then consider(e.part) end end
        else
            -- Incremental, because resolving ~85 roots in one go is a 60 ms burst of
            -- FindFirstChild at 0.71 ms each, and that burst is what stalls the client
            -- the moment the ram key is pressed. A few per call spreads the same work
            -- out and the list is complete within a second, which is soon enough.
            VM.ramZ = VM.ramZ or {}
            if not VM.ramZQ then
                local now = tick()
                if (now - (VM.ramZAt or 0)) > 2.0 then
                    VM.ramZAt = now
                    local zf = workspace:FindFirstChild("Zombies")
                    VM.ramZQ = zf and zf:GetChildren() or {}
                    VM.ramZI, VM.ramZOut = 1, {}
                end
            end
            if VM.ramZQ then
                local done = 0
                while VM.ramZI <= #VM.ramZQ and done < 8 do
                    local z = VM.ramZQ[VM.ramZI]
                    VM.ramZI = VM.ramZI + 1
                    done = done + 1
                    local r = z and z:FindFirstChild("HumanoidRootPart")
                    if r then VM.ramZOut[#VM.ramZOut + 1] = r end
                end
                if VM.ramZI > #VM.ramZQ then
                    VM.ramZ, VM.ramZQ = VM.ramZOut, nil
                end
            end
            for _, r in ipairs(VM.ramZ) do consider(r) end
        end
    end
    return best, bd
end

task.spawn(function()
