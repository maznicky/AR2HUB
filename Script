-- zero a key group, or restore it
-- Direct memory_write, NOT applygc. Measured: applygc caused ~100ms scheduler
-- stalls every few seconds (loop throughput collapsing 680/s -> 10/s), which
-- crippled the aimbot. Writing the cached addresses costs 1.6ms for 488 and
-- the values never drift back, so nothing needs re-applying.
local function apply(keys, on, label)
    if not CB.Prepared then setStatus("press Prepare first"); return end
    local want = {}
    for _, k in ipairs(keys) do want[k] = true end

    -- Crash guard. These addresses came from a getgc snapshot; if Lua has since
    -- freed or reused any of that memory, writing to it corrupts something
    -- unrelated and the game dies. So verify first: an address is only written
    -- if it still reads back as the value we captured (or as 0, meaning we
    -- already zeroed it). If too much of the cache has moved, refuse outright
    -- rather than write into whatever now lives there.
    local targets, moved = {}, 0
    for _, e in ipairs(CB.Cache) do
        if e.addr and want[tostring(e.key)] and tostring(e.type) == "number" then
            local orig = CB.Originals[e.addr]
            local okr, live = pcall(function() return memory_read("double", e.addr) end)
            if orig and okr and type(live) == "number" and (live == orig or live == 0) then
                targets[#targets + 1] = e
            else
                moved = moved + 1
            end
        end
    end
    local checked = #targets + moved
    if checked > 0 and moved * 4 > checked then      -- more than 25% unrecognisable
        setStatus(string.format("%s ABORTED - %d of %d addresses moved, press Prepare again",
            label, moved, checked))
        warn(string.format("[combat] %s aborted: %d of %d addresses no longer hold their captured value. Re-run Prepare.",
            label, moved, checked))
        return
    end

    local t0, written, skipped = tick(), 0, moved
    for _, e in ipairs(targets) do
        if on then
            local ok = pcall(function() memory_write("double", e.addr, 0) end)
            if ok then written = written + 1 else skipped = skipped + 1 end
        else
            local orig = CB.Originals[e.addr]
            local ok = pcall(function() memory_write("double", e.addr, orig) end)
            if ok then written = written + 1 else skipped = skipped + 1 end
        end
    end
    setStatus(string.format("%s %s - %d written, %d skipped (%.1fms)",
        label, on and "ON" or "OFF", written, skipped, (tick() - t0) * 1000))
    print(string.format("[combat] %s %s: %d written, %d skipped",
        label, on and "ON" or "OFF", written, skipped))
end

