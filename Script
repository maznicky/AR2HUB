-- Anything spawned that is not in the seeded lists gets a toggle at runtime, so
-- a vehicle type I have not seen can never be silently invisible.
local vehOther = vehtab:Section("Other", "Right")
local vehOtherSeen = false

-- Entries are REUSED across rebuilds, keyed by the vehicle's Id attribute (a
-- stable GUID: 40 vehicles, no duplicates, unchanged across rebuild intervals).
-- Building fresh entries every second was what made readings flicker between a
-- percentage and "?" - the resolved wheels and cached condition were thrown away
-- each rebuild and had to be rediscovered by the staggered pass.
local function vehRebuild(discovered)
    -- The part a vehicle is tracked by: Base when its position reads (60 of 66 measured);
    -- otherwise the first part that gives a position under Collision, Seats, Wheels or Body
    -- (Tractor, Cargo Van, StepVan and Quad have a Base that would not read). A model that
    -- comes back empty has not loaded in yet and is skipped until it does. Defined in here,
    -- not at the top level, which already holds 197 of Luau's 200 locals.
    local function vehAnchor(v)
        local b = v:FindFirstChild("Base")
        if b then
            local ok, p = pcall(function() return b.Position end)
            if ok and typeof(p) == "Vector3" then return b end
        end
        for _, sub in ipairs({ "Collision", "Seats", "Wheels", "Body" }) do
            local m = v:FindFirstChild(sub)
            if m then
                local okd, ds = pcall(function() return m:GetDescendants() end)
                for _, d in ipairs((okd and ds) or {}) do
                    local ok, p = pcall(function() return d.Position end)
                    if ok and typeof(p) == "Vector3" then return d end
                end
            end
        end
        return nil
    end
    local vf = workspace:FindFirstChild("Vehicles")
    local out = {}
    local prev, prevByName = {}, {}
    for _, e in ipairs(VE.Cache) do
        if e.id then
            prev[e.id] = e
        else                            -- a few vehicles carry no Id
            prevByName[e.name] = prevByName[e.name] or {}
            table.insert(prevByName[e.name], e)
        end
    end
    if vf then
        for _, v in ipairs(vf:GetChildren()) do
            local nm = v.Name
            if VE.Types[nm] == nil then
                VE.Types[nm] = false    -- new types start off, like everything else
                discovered[#discovered + 1] = nm
            end
            local pp = vehAnchor(v)
            if pp then
                local oki, id = pcall(function() return v:GetAttribute("Id") end)
                id = (oki and type(id) == "string" and id ~= "") and id or nil
                local e = id and prev[id]
                if not e and not id and prevByName[nm] and #prevByName[nm] > 0 then
                    e = table.remove(prevByName[nm])
                end
                if e then
                    e.part, e.model, e.name = pp, v, nm   -- refresh refs, keep readings
                    out[#out + 1] = e
                else
                    out[#out + 1] = {
                        id    = id,
                        part  = pp,
                        name  = nm,
                        model = v,
                        boat  = VEH_BOATS[nm] == true,
                        wheels = nil,      -- resolved lazily, 0.72 ms per vehicle
                        count  = 0,        -- wheel models present
                        read   = 0,        -- wheels whose Health actually replicated
                        frac   = nil,      -- 0..1 condition, nil until first read
                        parts  = {},
                        at     = 0,
                    }
                end
            end
        end
    end
    VE.Cache = out
end

-- Wheel condition. Each wheel's Hitbox carries a Health attribute that reads as
-- a Vector2-like {x = current, y = fraction}; x/y came out a consistent 350 on
-- every wheel, so y is already the 0-1 ratio we want. Resolving the hitboxes
-- costs 0.72 ms per vehicle and each GetAttribute costs 0.12 ms, so both the
-- lookup and the reads are done a couple of vehicles per tick, never in bulk.
-- Component parts live under Interaction and use the same Health attribute,
-- except Glass which uses Fixed/Total. The set is consistent fleet-wide: Body
-- and FuelTank on all 42, Engine and Refuel on 41, Glass on 37 (boats and
-- quads have no glass). Refs are resolved once, in the same staggered pass.
local VEH_COMPS = {
    { key = "body",   part = "Repair Body" },
    { key = "engine", part = "Repair Engine" },
    { key = "tank",   part = "Repair FuelTank" },
    { key = "fuel",   part = "Refuel" },
}

local function vehResolve(e)
    local list = {}
    local w = e.model and e.model:FindFirstChild("Wheels")
    if w then
        for _, wheel in ipairs(w:GetChildren()) do
            local hb = wheel:FindFirstChild("Hitbox")
            if hb then list[#list + 1] = hb end
        end
        e.count = #w:GetChildren()
    end
    e.wheels = list          -- empty table still counts as resolved

    -- one GetChildren pass, matching by name, instead of 5 FindFirstChild calls
    local refs = {}
    local it = e.model and e.model:FindFirstChild("Interaction")
    if it then
        for _, c in ipairs(it:GetChildren()) do
            local nm = c.Name
            if nm == "Repair Body" then refs.body = c
            elseif nm == "Repair Engine" then refs.engine = c
            elseif nm == "Repair FuelTank" then refs.tank = c
            elseif nm == "Refuel" then refs.fuel = c
            elseif nm == "Repair Glass" then refs.glass = c end
        end
    end
    e.refs = refs
    e.parts = e.parts or {}
end

-- Averaged over the wheels that actually report, NOT over the wheel count.
-- Measured: every vehicle with unreadable wheels was over 600 m away, none were
-- nearby, and not one wheel anywhere reported y = 0. So a missing Health
-- attribute is replication lag, not a destroyed wheel - counting it as 0 would
-- have shown distant vehicles as wrecks. The label reports partial coverage.
local function vehReadCondition(e)
    if not e.wheels then return end
    local sum, read = 0, 0
    for i = 1, #e.wheels do
        local ok, h = pcall(function() return e.wheels[i]:GetAttribute("Health") end)
        if ok and type(h) == "table" and type(h.y) == "number" then
            sum = sum + h.y
            read = read + 1
        end
    end
    e.read = read
    e.frac = (read > 0) and (sum / read) or nil   -- nil = unknown, drawn gray

    -- component parts, same cadence. Wheels alone drive the COLOUR, because
    -- wheel condition is what governs whether the thing is drivable; these are
    -- reported for information only.
    local refs, parts = e.refs, e.parts
    if refs and parts then
        for _, c in ipairs(VEH_COMPS) do
            local ref = refs[c.key]
            if ref then
                local ok, h = pcall(function() return ref:GetAttribute("Health") end)
                parts[c.key] = (ok and type(h) == "table" and type(h.y) == "number") and h.y or nil
            end
        end
        if refs.glass then
            local okf, fx = pcall(function() return refs.glass:GetAttribute("Fixed") end)
            local okt, tt = pcall(function() return refs.glass:GetAttribute("Total") end)
            parts.glassFixed = (okf and type(fx) == "number") and fx or nil
            parts.glassTotal = (okt and type(tt) == "number") and tt or nil
        end
    end
end

local function vehColour(e)
    if e.boat then return STYLE.unlooted end       -- boats have no wheels to lose
    local f = e.frac
    if not f then return STYLE.unknown end
    if f <= 0.33 then return STYLE.looted end      -- red
    if f <= 0.66 then return VEH_ORANGE end
    return STYLE.unlooted                          -- green
end

task.spawn(function()
    -- Same shape as the event ESP: ring + core, name above, detail below.
    -- Colour is assigned every frame; Font and Transparency are left alone,
    -- since setting those is what turned the event text black.
    local pool = {}
    for i = 1, VEH_POOL do
        local ring = Drawing.new("Circle")
        ring.Thickness = 1; ring.Filled = false; ring.NumSides = 18
        ring.Radius = STYLE.Ring; ring.Visible = false
        local core = Drawing.new("Circle")
        core.Filled = true; core.NumSides = 12
        core.Radius = STYLE.Core; core.Visible = false
        local name = Drawing.new("Text")
        name.Size = STYLE.NameSize; name.Center = true; name.Outline = true
        name.Visible = false
        local sub = Drawing.new("Text")
        sub.Size = STYLE.SubSize; sub.Center = true; sub.Outline = true
        sub.Visible = false
        pool[i] = { ring = ring, core = core, name = name, sub = sub }
    end
    local function hide(o)
        o.ring.Visible = false; o.core.Visible = false
        o.name.Visible = false; o.sub.Visible = false
    end

    local lastBuild, cursor = 0, 1
    while _G.AR2HUB_GEN == GEN do
        local n = 0
        if VE.Enabled then
            local now = tick()
            if (now - lastBuild) >= VEH_BUILD then
                lastBuild = now
                local discovered = {}
                vehRebuild(discovered)
                cursor = 1
                for _, nm in ipairs(discovered) do
                    vehOtherSeen = true
                    pcall(function()
                        vehToggles[#vehToggles + 1] =
                            vehOther:Toggle(nm, false, function(v) VE.Types[nm] = v end)
                    end)
                    print("[vehicle esp] new type discovered: " .. nm)
                end
            end

            local list = VE.Cache
            -- staggered condition work: a couple of vehicles per tick, so the
            -- 0.72 ms lookup and 0.12 ms-per-wheel reads never land together
            local done = 0
            -- scaled by scheduler health: see the note at the bottom of the file
            local budget = math.max(1, math.floor(VEH_PERTICK * (_G.AR2HUB_HEALTH or 1)))
            while done < budget and #list > 0 do
                if cursor > #list then cursor = 1 end
                local e = list[cursor]
                cursor = cursor + 1
                done = done + 1
                if e then
                    if not e.wheels then
                        vehResolve(e)
                    elseif (now - e.at) >= VEH_HEALTH then
                        e.at = now
                        vehReadCondition(e)
                    end
                end
                if #list <= done then break end
            end

            local cp = camPos()
            if cp then
                local maxStuds = VE.MaxM * E.DistanceDivisor
                for i = 1, #list do
                    if n >= VEH_POOL then break end
                    local e = list[i]
                    if VE.Types[e.name] == true then
                        -- The arithmetic is wrapped, not just the read: Matcha
                        -- falls back to FindFirstChild for unsupported properties,
                        -- so .Position can hand back an INSTANCE instead of a
                        -- Vector3. That threw "Vector3Meta expected, got Instance"
                        -- and silently killed the loop it happened in.
                        local ok, pos = pcall(function() return e.part.Position end)
                        local okd, d = false, nil
                        if ok and pos then
                            okd, d = pcall(function() return (pos - cp).Magnitude end)
                        end
                        if okd and type(d) == "number" then
                            if d <= maxStuds then
                                local pt, visible = toScreen(pos + Vector3.new(0, 3, 0))
                                if visible then
                                    n = n + 1
                                    local o = pool[n]
                                    local col = vehColour(e)

                                    o.ring.Position = pt
                                    o.ring.Color = col
                                    o.ring.Visible = true

                                    o.core.Position = pt
                                    o.core.Color = col
                                    o.core.Visible = true

                                    o.name.Text = e.name
                                    o.name.Position = Vector2.new(pt.X, pt.Y - 30)
                                    o.name.Color = STYLE.name
                                    o.name.Visible = true

                                    local detail = metres(d) .. E.DistanceUnit
                                    if e.boat then
                                        -- nothing to add: boats are always green
                                    elseif e.frac then
                                        detail = detail .. string.format("  %d%%", math.floor(e.frac * 100 + 0.5))
                                        -- flag when only some wheels reported, so a
                                        -- partial reading is never mistaken for a full one
                                        if e.read and e.count > 0 and e.read < e.count then
                                            detail = detail .. string.format(" (%d/%d)", e.read, e.count)
                                        end
                                    else
                                        detail = detail .. "  ?"
                                    end
