-- ==================== AR2 Hub - Event ESP ====================
-- 16 events grouped by faction. Per-event readout: Amount + nearest site's roster.
-- States: Unlooted (green) / Unknown (gray). Looted sites are WIPED, not shown.
-- Distances match Matcha's ESP (studs / 2.75, rounded). Config is in metres.
-- Site Probe: F8, plus an automatic sweep every 60s.
-- Everything starts DISABLED; nothing scans until toggled on.

-- ---------------- re-run guard ----------------
-- Loading this script a second time (which a loadstring URL makes easy) would
-- otherwise stack a second copy of every task.spawn loop and a second UI window
-- on top of the first. Bumping the generation makes every loop from the previous
-- load exit on its next tick; the renderer removes its own Drawings as it goes.
_G.AR2HUB_GEN = (_G.AR2HUB_GEN or 0) + 1
local GEN = _G.AR2HUB_GEN
if GEN > 1 then
    print(string.format("[AR2 Hub] reload #%d - retiring previous instance", GEN))
    if _G.AR2HUB_WIN then
        for _, m in ipairs({"Destroy", "Unload", "Close", "Remove"}) do
            pcall(function() _G.AR2HUB_WIN[m](_G.AR2HUB_WIN) end)
        end
        _G.AR2HUB_WIN = nil
    end
    -- never leave input trapped if the old window vanished mid-drag
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)   -- let the retiring loops notice before we respawn them
end

-- ---------------- loop supervisor ----------------
-- Every feature runs in its own task.spawn loop, and an error inside one of those
-- kills it outright - no message, no restart, the feature simply stops while the rest
-- of the menu carries on looking fine. That is what "the script crashed" has meant
-- more than once: one stale instance read, one dead loop.
--
-- Loops registered here are restarted when they die, at most a few times, so a
-- transient (a respawn, a streaming gap) costs a moment rather than the feature. A
-- loop that keeps failing is left dead and named in the console, because restarting
-- something permanently broken just hides it.
_G.AR2HUB_LOOPS = {}
function AR2SPAWN(name, fn)
    local restarts = 0
    local function run()
        task.spawn(function()
            while _G.AR2HUB_GEN == GEN do
                local ok, err = pcall(fn)
                if ok then return end          -- finished cleanly
                if _G.AR2HUB_GEN ~= GEN then return end
                restarts = restarts + 1
                _G.AR2HUB_LOOPS[name] = restarts
                if restarts > 5 then
                    warn(string.format("[AR2 Hub] '%s' died %d times, leaving it stopped: %s",
                        name, restarts, tostring(err)))
                    return
                end
                warn(string.format("[AR2 Hub] '%s' errored (restart %d): %s",
                    name, restarts, tostring(err)))
                task.wait(0.5)
            end
        end)
    end
    run()
end

-- ---------------- Drawing registry ----------------
-- Each load builds 22 pools of Drawings across 32 loops, and each loop removes its
-- own on the way out - but only when it next ticks, and only if it gets there. A loop
-- killed mid-sweep, or one still inside a long wait, never cleans up, and its
-- Drawings stay on the renderer forever. Twenty reloads in a session is enough of
-- that to matter, and it fits crashes that arrive with no obvious trigger.
--
-- So every Drawing is registered as it is created, and a reload wipes the previous
-- generation's set outright rather than trusting each loop to tidy up after itself.
-- Drawing.new is wrapped once, globally, and the wrapper survives reloads.
_G.AR2HUB_DRAWINGS = _G.AR2HUB_DRAWINGS or {}
if GEN > 1 then
    local n = 0
    for _, d in ipairs(_G.AR2HUB_DRAWINGS) do
        if pcall(function() d.Visible = false end) then n = n + 1 end
        pcall(function() d:Remove() end)
    end
    print(string.format("[AR2 Hub] cleared %d drawings from the previous load", n))
end
_G.AR2HUB_DRAWINGS = {}
if Drawing and not _G.AR2HUB_DRAWWRAP then
    _G.AR2HUB_DRAWWRAP = true
    local realNew = Drawing.new
    Drawing.new = function(...)
        local obj = realNew(...)
        if obj then table.insert(_G.AR2HUB_DRAWINGS, obj) end
        return obj
    end
end

-- INS-ui captures game:GetService("Players") ONCE, at library load, and reads
-- the mouse only through LocalPlayer:GetMouse() - there is no UserInputService
-- fallback and no retry. If the handle is nil at that instant the menu renders
-- but can never be clicked, for the life of that instance. Matcha's service
-- lookup does go nil (observed returning nil for Players, Workspace, RunService
-- and CoreGui while Lighting and ReplicatedStorage still resolved), so wait for
-- it before loading the library rather than loading into a dead menu.
do
    local waited, limit = 0, 10
    local function handleOk()
        local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
        return ok and lp ~= nil
    end
    while not handleOk() and waited < limit do
        task.wait(0.5)
        waited = waited + 0.5
    end
    if not handleOk() then
        warn("[AR2 Hub] Players handle is stale after " .. limit .. "s - the menu will")
        warn("[AR2 Hub] render but not accept clicks. Reinject Matcha, then reload.")
    elseif waited > 0 then
        print(string.format("[AR2 Hub] waited %.1fs for the Players handle", waited))
    end
end

-- The UI library is fetched fresh on every load, and every reload is another request.
-- Seventeen reloads in one session earned a "429: Too Many Requests" from GitHub,
-- which loadstring then tried to parse as Luau ("Expected identifier ... got '429'"),
-- leaving Lib nil and no menu at all - after the re-run guard had already retired the
-- working instance. So: keep a copy on disk, and fall back to it whenever the fetch
-- returns anything that is not the library.
local LIB_CACHE = "insui_cache.lua"
-- jsDelivr mirrors the same file from the same repo but rate-limits separately, so it
-- keeps working when raw.githubusercontent starts answering 429.
local LIB_URLS = {
    "https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua",
    "https://cdn.jsdelivr.net/gh/neaxusxgod-png/INS-ui@main/uilib.min.lua",
}
local libSrc
-- The library has TWO shapes in the wild. The older minified build returns its table;
-- the newer one (LIB_NAME="INSUI") returns nil and publishes a global instead - and
-- names it INSUI, not INSui, so the old fallback found nothing and every UI call died
-- on a nil Lib. Take the return value if there is one, otherwise whichever global
-- actually carries the API.
-- Try each source and accept only one that produces a WORKING library.
--
-- Three separate things went wrong here across one session, and any single-source
-- loader falls to all of them: GitHub answered 429 and the rate-limit page was handed
-- to loadstring; the newest upstream build returns nil and publishes a global named
-- INSUI rather than INSui; and that same build dies on its second line under Matcha,
-- almost certainly calling getgenv, which this executor does not provide. Caching
-- whatever was fetched then overwrote the copy that worked.
--
-- So: fetch, RUN, and only keep a source that yields a table with CreateWindow. The
-- cache is written after that test, never before, so a broken upstream cannot poison
-- a working local copy.
local Lib
do
    local function usableSrc(s)
        return type(s) == "string" and #s > 5000 and not string.find(s, "^%s*%d%d%d:")
    end
    local function usableLib(t) return type(t) == "table" and type(t.CreateWindow) == "function" end
    local function try(src)
        if not usableSrc(src) then return nil end
        local chunk = loadstring(src)
        if not chunk then return nil end
        local okr, ret = pcall(chunk)
        if okr and usableLib(ret) then return ret end
        for _, name in ipairs({ "INSUI", "INSui", "insui" }) do
            local g = _G[name] or rawget(getfenv(), name)
            if usableLib(g) then return g end
        end
        return nil
    end
    -- cache first: it is the copy already proven to work on this machine
    local okc, cached = pcall(function() return readfile(LIB_CACHE) end)
    if okc then
        Lib = try(cached)
        if Lib then libSrc = cached end
    end
    if not Lib then
        for _, u in ipairs(LIB_URLS) do
            local okh, body = pcall(function() return game:HttpGet(u) end)
            if okh then
                local got = try(body)
                if got then
                    Lib, libSrc = got, body
                    pcall(function() writefile(LIB_CACHE, body) end)   -- only once proven
                    break
                end
            end
        end
    end
    if not Lib then
        warn("[AR2 Hub] no working UI library from cache or any mirror - menu cannot load")
    end
end

-- ---------------- portability shims ----------------
local function getCamera()
    return workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
end
local function camPos()
    local cam = getCamera()
    if not cam then return nil end
    local ok, p = pcall(function() return cam.CFrame.Position end)
    if ok and typeof(p) == "Vector3" then return p end
    local ok2, p2 = pcall(function() return cam.Position end)
    if ok2 and typeof(p2) == "Vector3" then return p2 end
    return nil
end
local function toScreen(v3)
    if WorldToScreen then return WorldToScreen(v3) end
    local cam = getCamera()
    if not cam then return Vector2.new(0, 0), false end
    local p, vis = cam:WorldToViewportPoint(v3)
    return Vector2.new(p.X, p.Y), (vis and p.Z > 0)
end
local function toast(title, msg, dur)
    if Lib and Lib.Notify then
        local ok = pcall(function() Lib:Notify(title .. ": " .. msg, dur or 5) end)
        if ok then return end
    end
    if notify then
        local ok = pcall(function() notify(title, msg, dur or 5) end)
        if ok then return end
    end
    print("[" .. title .. "] " .. msg)
end

-- ---------------- input watchdog ----------------
-- Matcha's Players handle goes stale after time in-server; INS-ui then cannot
-- read the mouse and would trap your input. This always hands input back.
_G.UI_WATCHDOG = true
task.spawn(function()
    local wasAlive = nil
    while _G.UI_WATCHDOG and _G.AR2HUB_GEN == GEN do
        local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
        local alive = (ok and lp ~= nil)
        if wasAlive ~= nil and alive ~= wasAlive then
            if alive then
                toast("UI", "Players handle restored", 5)
            else
                if setrobloxinput then pcall(function() setrobloxinput(true) end) end
                toast("UI", "handle went stale - input released, reinject for the menu", 8)
            end
        end
        wasAlive = alive
        task.wait(2)
    end
end)

