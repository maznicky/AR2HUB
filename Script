                        if okt and p then tp = p else VM.ramPart = nil end
                    end
                    if not tp then
                        VM.RamState = "nothing in range"
                    elseif okb and bp then
                        local dir = tp - bp
                        local flat = Vector3.new(dir.X, 0, dir.Z)
                        local dist = flat.Magnitude
                        if dist > 0.5 then
                            flat = flat / dist
                            local vel
                            if VM.RamMode == "Air" then
                                -- lift enough to clear obstacles, aimed slightly above
                                local up = math.max(0, (tp.Y + 6) - bp.Y)
                                vel = flat * VM.RamSpeed + Vector3.new(0, math.min(up * 3, 200), 0)
                            else
