-- direct, always: manual stops replaced automatic hops
_G.VEHMOD.routeTo = function(from, target) return { target } end
_G.VEHMOD.flyTo = function(target)
    local VM = _G.VEHMOD
    local okr, P = pcall(function() return svcPlayers() end)
    local lp = (okr and P) and P.LocalPlayer or nil
    local ch = lp and lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart") or nil
    local from
    if hrp then
        local okp, p = pcall(function() return hrp.Position end)
        from = okp and p or nil
    end
    if not from then return end
    -- Lock the vehicle HERE, while standing still, rather than letting the flight loop
    -- hunt for one at 30 Hz. Pressing a destination with no vehicle in reach used to
    -- start a search that repeated every tick and took the client down with it.
    local base, why = VM.baseNear(from, 0)
    if not base then
        pcall(function() Lib:Notify("no vehicle in reach - get in one first", 4) end)
        VM.AP.on, VM.AP.phase = false, tostring(why)
        return
    end
    VM.AP.base = base
    VM.EngineNow = VM.engineOf(base) or VM.EngineNow   -- current vehicle, not the last one
    local legs = VM.routeTo(from, target)
    -- Estimate what the trip costs before committing to it. Per leg: climb, cross,
    -- descend - the cross being distance/speed plus the time to shed that speed.
    local est, prev = 0, from
    for _, p in ipairs(legs) do
        local d = (Vector3.new(p.X, 0, p.Z) - Vector3.new(prev.X, 0, prev.Z)).Magnitude
        local v = math.min(VM.AP.Speed, math.sqrt(2 * VM.AP.Brake * math.max(d, 1)))
        est = est + (d / v) + (v / (2 * VM.AP.Brake))
                  + (VM.AP.Height / math.max(VM.AP.Climb or 500, 1))
                  + (VM.AP.Height / math.max(VM.AP.Descent, 1))
        prev = p
    end
    VM.AP.estTime = est
    local L = _G.FLIGHTLOG
    local cost = L and L.rate and (L.rate * est) or nil
    VM.AP.estCost = cost
    if VM.EngineGuard and VM.EngineNow then
        -- hard floor only: below this nothing is worth attempting
        if VM.EngineNow < (VM.EngineMin or 0.05) then
            pcall(function()
                Lib:Notify(string.format("engine at %.0f%% - too low to fly", VM.EngineNow * 100), 4)
            end)
            VM.AP.on, VM.AP.phase = false, "engine too low"
            return
        end
        -- otherwise judge the trip, not the number: warn when the estimate does not fit
        if cost and cost > (VM.EngineNow - 0.02) then
            pcall(function()
                Lib:Notify(string.format("trip needs about %.0f%% engine, you have %.0f%% - it may not make it",
                    cost * 100, VM.EngineNow * 100), 5)
            end)
        end
    end
    VM.AP.legs = legs
    VM.AP.leg = 1
    VM.AP.target = VM.AP.legs[1]
    VM.AP.early, VM.AP.lastHoriz = nil, nil
    VM.AP.on = true
    VM.AP.phase = "climb"
    pcall(function()
        Lib:Notify(string.format("flying: %d leg%s", #VM.AP.legs, (#VM.AP.legs == 1) and "" or "s"), 3)
    end)
end

