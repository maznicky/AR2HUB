-- ---------------- SITE PROBE ----------------
-- Flies the CAMERA to uncertain sites to force NPCs to stream in, then snaps
-- back. Your character never moves - but the world around it unloads while the
-- camera is away, so prefer triggering this from safe cover.
_G.SiteProbe = {
    Key          = 0x77,   -- F8, manual sweep
    Dwell        = 2.5,    -- seconds parked at each site
    Height       = 45,     -- studs above the site
    MaxSites     = 4,      -- sites per sweep
    OnlyUncertain= true,
    AutoInterval = 60,     -- seconds between automatic sweeps (0 = manual only)
    RequireIdle  = false,  -- true = only sweep while your character is stationary
    IdleSeconds  = 3,
    Running      = true,
}
local SP = _G.SiteProbe

local function myCharRoot()
    local cam = getCamera()
    if not cam then return nil end
    local cpos = cam.Position
    local best, bestD = nil, math.huge
    -- workspace.Characters goes nil during respawns and streaming gaps. Unguarded,
    -- this threw "attempt to index nil with 'GetChildren'" during a load and aborted
    -- the whole chunk partway, leaving half the script missing with no obvious sign.
    local chars = workspace:FindFirstChild("Characters")
    if not chars then return nil end
    for _, c in ipairs(chars:GetChildren()) do
        local a = anchor(c)
        if a then
            local d = (a.Position - cpos).Magnitude
            if d < bestD then best, bestD = a, d end
        end
    end
    return best
end

local function resolveSite(cat, rec)
    local def = E.Categories[cat]
    local names, count = {}, 0
    -- same nil-during-streaming guard as myCharRoot; returns a count, not a list
    local zf = workspace:FindFirstChild("Zombies")
    if not zf then return 0 end
    for _, z in ipairs(zf:GetChildren()) do
        local ln = string.lower(z.Name)
        if npcMatch(ln, def) or sharedMatch(ln) then
            local a = anchor(z)
            if a and (a.Position - rec.pos).Magnitude < E.Cluster then
                count += 1
                names[#names + 1] = tidyName(z.Name)
            end
        end
    end
    if count > 0 then
        rec.names, rec.state, rec.everUnlooted = names, "unlooted", true
    else
        rec.names, rec.state, rec.everUnlooted = {}, "looted", false
    end
    rec.lastSeen = tick()
    return count
end

function _G.ProbeSites()
    local cam = getCamera()
    if not cam then return end
    local saved = cam.CFrame
    local root = myCharRoot()
    local beforePos = root and root.Position

    local jobs = {}
    for cat, reg in pairs(E.Registry) do
        if E.Enabled[cat] then
            for _, rec in pairs(reg) do
                if (not SP.OnlyUncertain) or rec.state == "unknown" or rec.everUnlooted then
                    jobs[#jobs + 1] = {cat = cat, rec = rec,
                                       d = (rec.pos - saved.Position).Magnitude}
                end
            end
        end
    end
    table.sort(jobs, function(a, b) return a.d < b.d end)
    if #jobs == 0 then return end

    for i = 1, math.min(#jobs, SP.MaxSites) do
        local j = jobs[i]
        local eye = j.rec.pos + Vector3.new(0, SP.Height, 0)
        cam.CFrame = CFrame.lookAt(eye, j.rec.pos)
        task.wait(SP.Dwell)
        local n = resolveSite(j.cat, j.rec)
        print(string.format("[probe] %-18s %s (%d npc)",
            E.Categories[j.cat].label, j.rec.state, n))
    end

    cam.CFrame = saved
    local afterPos = root and root.Position
    if beforePos and afterPos then
        local drift = (afterPos - beforePos).Magnitude
        if drift > 15 then
            print(string.format("[probe] character moved %.0f studs during sweep", drift))
        end
    end
end

