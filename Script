_G.ITEMESP.catWords = {
    { "Ammo",         { "ammo", "speedloader", "magazine", "buckshot", "slug", " rd", "rd ", "round", "shell", "belt of" } },
    { "Backpacks",    { "backpack", "rucksack", "duffel", "satchel", "bag", "pack" } },
    { "VehicleParts", { "tire", "wheel", "fuel", "gasoline", "jerry", "battery", "spark", "repair", "engine", "oil", "canister" } },
    { "Consumables",  { "drink", "water", "soda", "beans", "canned", "food", "mre", "snack", "energy",
                        "booster", "bandage", "dressing", "morphine", "pill", "medical", "medkit",
                        "syringe", "splint", "antibiotic", "ration", "candy", "chocolate" } },
    { "Accessories",  { "hat", "cap", "helmet", "vest", "shirt", "pants", "jacket", "coat", "mask",
                        "glasses", "goggles", "boots", "gloves", "belt", "armor", "armour", "plate",
                        "uniform", "hoodie", "beanie", "bandana", "accessory" } },
    { "Melees",       { "knife", "machete", "axe", "hatchet", "bat", "crowbar", "hammer", "shovel", "wrench", "sword" } },
    { "Firearms",     { "rifle", "pistol", "shotgun", "smg", "carbine", "revolver", "sniper", "snubnose" } },
}
_G.ITEMESP.catOf = function(label, kind)
    -- applies to any label, including the mesh-derived ones: a mesh called
    -- "Energy Drink Yellow" sorts to Consumables the same as a real name would
    if type(label) == "string" then
        local low = string.lower(label)
        for _, pair in ipairs(_G.ITEMESP.catWords) do
            for _, w in ipairs(pair[2]) do
                if string.find(low, w, 1, true) then return pair[1] end
            end
        end
    end
    -- shape only: these two are the ones structure can actually prove
    if kind == "firearm" then return "Firearms" end
    if kind == "melee" then return "Melees" end
    return "Other"
end

-- a few meshes are named differently from the item they belong to: a Common
-- Bandage's mesh is FieldDressing. Only affects the far-away guess, since up close
-- the UI list gives the real name.
_G.ITEMESP.alias = {
    FieldDressing = "Bandage",
    ["Hunting Spray"] = "Scent Cover Spray",
}

-- material and geometry names that are not item names
_G.ITEMESP.junk = {}
for _, w in ipairs({ "plastic", "metal", "glass", "wood", "rubber", "cloth", "fabric",
                     "part", "union", "cylinder", "block", "wedge", "sphere", "mesh",
                     "handle", "cap", "lid", "body", "top", "bottom", "middle",
                     "color", "color2", "colour", "geometry", "primary", "secondary" }) do
    _G.ITEMESP.junk[w] = true
end

-- structural guess, used wherever the UI list cannot name something
_G.ITEMESP.hintOf = function(m)
    local has = {}
    local ok, kids = pcall(function() return m:GetChildren() end)
    if not ok or not kids then return "generic", "Item" end
    for _, p in ipairs(kids) do has[p.Name] = true end
    if has.Blade or has.HandGuard then return "melee", "Melee" end
    if has.BarrelMount or has.SightMount or has.Muzzle or has["Charging Handle"] then
        return "firearm", "Firearm"
    end
    if has.ActionConstant or (has.Action and has.Constant) then return "firearm", "Firearm" end
    for _, p in ipairs(kids) do
        local n = p.Name
        -- a mesh with a real name is often the item itself, but plenty are named
        -- after their material or their source file instead ("Plastic",
        -- "Meshes/frames") and those read as nonsense on screen
        if n ~= "Base" and n ~= "MeshPart" and n ~= "Model" and not string.match(n, "^%d+$")
           and not string.match(n, "^Projection") and not string.match(n, "^SightLine")
           and not string.find(n, "/") and not _G.ITEMESP.junk[string.lower(n)] then
            return "named", _G.ITEMESP.alias[n] or n
        end
    end
    return "generic", "Item"
end

-- Finding the nodes means checking the name of every map element, and there can be
-- 2,500 of them. That read costs 0.05 ms when the client is healthy - a 130 ms scan,
-- fine on its own - but I first ran it once a second from inside the draw loop, and
-- alongside the other sweeps the contention inflated each read to 7 ms. One scan
-- then took 18 SECONDS and the whole script updated about twice a minute.
-- So: the scan is incremental with a hard per-tick budget, and only the cheap part
-- (distances and names, over the few nodes already found) runs frequently.
_G.ITEMESP.PERTICK = 150        -- elements per tick, about 8 ms
_G.ITEMESP.every   = 3.0        -- seconds between full rescans
_G.ITEMESP.scanning = false
_G.ITEMESP.cursor  = 1

_G.ITEMESP.step = function(now)
    local IT = _G.ITEMESP
    local els = workspace.Map and workspace.Map:FindFirstChild("Elements")
    if not els then return end
    if not IT.scanning then
        if (now - IT.At) < IT.every then return end
        local okk, kids = pcall(function() return els:GetChildren() end)
        if not okk or not kids then return end
        IT.kids, IT.cursor, IT.buffer, IT.scanning = kids, 1, {}, true
    end
    -- scaled by scheduler health: see the note at the bottom of the file
    local budget = math.floor(IT.PERTICK * (_G.AR2HUB_HEALTH or 1))
    if budget < 5 then budget = 5 end
    local done = 0
    while IT.cursor <= #IT.kids and done < budget do
        local e = IT.kids[IT.cursor]
        IT.cursor = IT.cursor + 1
        done = done + 1
        local okn, nm = pcall(function() return e.Name end)
        if okn and type(nm) == "string" and string.find(nm, "ItemNode") then
            local okc, kids = pcall(function() return e:GetChildren() end)
            if okc and kids then
                for _, node in ipairs(kids) do
                    local inode = node:FindFirstChild("ItemNode")
                    local m = node:FindFirstChild("Model")
                    if inode and m then
                        local kind, label = IT.hintOf(m)
                        IT.buffer[#IT.buffer + 1] =
                            { part = inode, kind = kind, label = label, hint = label, d = 1e9 }
                    end
                end
            end
        end
    end
    if IT.cursor > #IT.kids then
        IT.Live, IT.buffer, IT.scanning = IT.buffer, nil, false
        IT.At = now
        -- a fresh list carries no names yet, so name it on the very next tick
        -- instead of showing hints until the once-a-second pass comes round
        IT.AssignAt = 0
    end
end

-- Cheap pass over the nodes already found: refresh distances and categories.
--
-- There is deliberately NO exact naming here. The game's nearby-loot list has the
-- real names, but nothing ties an entry to a specific object in the world:
--   * BY ORDER - looked perfect (12 of 12) but the test was taken on a pile where
--     everything sat 4-6 studs away so the orderings coincided. In the field labels
--     swapped between items depending on which one you stood nearer.
--   * BY MODEL FINGERPRINT - the UI entry embeds a copy of the item's model, but its
--     parts are scaled to fit the inventory grid, so the sizes do not match the world
--     model. A gasoline can 7 studs away scored higher against the chemlight's entry
--     than against its own, and single-part items make it worse: one coincidental
--     size match is a 100% score.
-- Two wrong methods was enough. Labels now come only from the model's own structure,
-- which cannot claim something it does not know.
_G.ITEMESP.assign = function(now, cp)
    local IT = _G.ITEMESP
    if (now - (IT.AssignAt or 0)) < 1.0 then return end
    IT.AssignAt = now
    local live = IT.Live
    if not live or #live == 0 then IT.Named = 0 return end
    for _, e in ipairs(live) do
        e.label = e.hint
        local okp, p = pcall(function() return e.part.Position end)
        if okp and p then
            local okd, dd = pcall(function() return (p - cp).Magnitude end)
            e.d = okd and dd or 1e9
        else
            e.d = 1e9
        end
        e.cat = IT.catOf(e.label, e.kind)
    end
    IT.Named = 0
end

task.spawn(function()
    local IT = _G.ITEMESP
    local pool = {}
    for i = 1, IT.POOL do
        local dot = Drawing.new("Circle")
        dot.Thickness = 1; dot.Filled = false; dot.NumSides = 8
        dot.Radius = 3; dot.Visible = false
        local nm = Drawing.new("Text")
        nm.Size = STYLE.SubSize; nm.Center = true; nm.Outline = true; nm.Visible = false
        pool[i] = { dot = dot, name = nm }
    end
    while _G.AR2HUB_GEN == GEN do
        local n = 0
        if IT.Enabled then
            local cp = camPos()
            if cp then
                local now = tick()
                IT.step(now)
                IT.assign(now, cp)
                local maxStuds = IT.MaxM * E.DistanceDivisor
                for i = 1, #IT.Live do
                    if n >= IT.POOL then break end
                    local e = IT.Live[i]
                    local cat = e.cat or "Other"
                    local ok, pos = false, nil
                    if IT.Cats[cat] then
                        ok, pos = pcall(function() return e.part.Position end)
                    end
                    local okd, d = false, nil
                    if ok and pos then
                        okd, d = pcall(function() return (pos - cp).Magnitude end)
                    end
                    if okd and type(d) == "number" and d <= maxStuds then
                        local pt, vis2 = toScreen(pos + Vector3.new(0, 0.5, 0))
                        if vis2 then
                            n = n + 1
                            local o = pool[n]
                            local col = IT.col[cat] or IT.col.Other
                            o.dot.Position = pt; o.dot.Color = col; o.dot.Visible = true
                            if IT.Names then
                                o.name.Text = string.format("%s  %d%s", e.label, metres(d),
                                    E.DistanceUnit)
                                o.name.Position = Vector2.new(pt.X, pt.Y - 13)
                                o.name.Color = col
                                o.name.Visible = true
                            else
                                o.name.Visible = false
                            end
                        end
                    end
                end
            end
            pcall(function()
                IT.Shown = n
                IT.ui.info:SetText(string.format("%d on the ground%s | %d shown",
                    #IT.Live, IT.scanning and " (scanning...)" or "", n))
            end)
        end
        for i = n + 1, IT.POOL do
            pool[i].dot.Visible = false
            pool[i].name.Visible = false
        end
        task.wait(0.06)
    end
    for i = 1, IT.POOL do
        pcall(function() pool[i].dot:Remove() end)
        pcall(function() pool[i].name:Remove() end)
    end
end)
end
-- ==================== Vehicle Mods (Combat > Vehicle Mods) ====================
-- Measured on an ambulance with the player sitting in it:
--   * writing AssemblyLinearVelocity to the vehicle's Base part MOVED it 16.88 studs,
--     and read back exactly what was written
--   * 0.13 studs of drift over the next 2 seconds with no further writes, so the
--     server accepts the displacement rather than correcting it
--   * vertical at 22 studs/s did nothing at all - the suspension absorbs it - but 60
--     lifted the vehicle 19.3 studs, so flight needs to clear that floor
--   * Config and Config.Physics decompile with their structure but no numbers, so
--     there is no MaxSpeed constant to edit; velocity is the whole mechanism
--   * there is NO velocity ceiling. Writing 600 once read back as 425 and I called
--     that a clamp - it was a snapshot taken 0.05s into the burst while the value was
--     still ramping. A proper 6 second run at 1000 recorded a peak of 1108 studs/s
--     measured from actual position change, velocity reading back at 1035, and
--     covered 2344 studs with the vehicle intact. Trust displacement over a property
--     read taken mid-acceleration
-- The vehicle itself is what moves here. The character is never touched.
--
-- This is the loudest thing in the script by a distance: a car doing 120 studs/s or
-- leaving the ground is visible to everyone, not just to the server.
do
_G.VEHMOD = _G.VEHMOD or {}
