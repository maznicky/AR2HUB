-- ---- classification ----
local function isSpecialName(item)
    local low = string.lower(item)
    if string.find(low, "mod%d") then return true end
    for _, s in ipairs(SPECIAL_EXTRA) do
        if string.find(low, s, 1, true) then return true end
    end
    return false
end

-- returns category key, a short description of the notable item
local function classify(z)
    local eq = z:FindFirstChild("Equipment")
    if not eq then return "normal", nil end
    local gun, melee, bag
    local sGun, sMelee, sBag
    for _, it in ipairs(eq:GetChildren()) do
        local nm = it.Name
        local item = string.match(nm, "^Backpack Firearm (.+)$")
                  or string.match(nm, "^Belt Firearm (.+)$")
        if item then
            gun = gun or item
            if isSpecialName(item) then sGun = sGun or item end
        else
            local m = string.match(nm, "^Backpack Melee (.+)$")
                   or string.match(nm, "^Belt Melee (.+)$")
            if m then
                melee = melee or m
                if isSpecialName(m) then sMelee = sMelee or m end
            else
                local b = string.match(nm, "^Backpack (.+)$")
                if b then
                    bag = bag or b
                    if isSpecialName(b) then sBag = sBag or b end
                end
            end
        end
    end
    if sGun   then return "sgun",   sGun   end
    if sMelee then return "smelee", sMelee end
    if sBag   then return "sbag",   sBag   end
    if gun    then return "armed",  gun    end
    if melee  then return "armed",  melee  end
    if bag    then return "armed",  bag    end
    return "normal", nil
end

-- long names like "Unique Convoy US Soldier Woodland Camo Mask M16A2" do not fit
local function shortName(n)
    n = string.gsub(n, "^Male ", "")
    n = string.gsub(n, "^Female ", "")
    n = string.gsub(n, "^NB ", "")
    if #n > 26 then n = string.sub(n, 1, 25) .. "." end
    return n
end

-- ---- incremental sweep ----
local zQueue, zOut, zIdx, zSweptAt = nil, nil, 1, 0

local function zombSweepStep(now)
    if not zQueue then
        if (now - zSweptAt) < ZOMB_SWEEP then return end
        local zf = workspace:FindFirstChild("Zombies")
        zQueue = zf and zf:GetChildren() or {}
        zOut, zIdx = {}, 1
    end
    -- scaled by scheduler health: see the note at the bottom of the file
    local budget = math.floor(ZOMB_PERTICK * (_G.AR2HUB_HEALTH or 1))
    if budget < 1 then budget = 1 end
    local done = 0
    while zIdx <= #zQueue and done < budget do
        local z = zQueue[zIdx]
        zIdx = zIdx + 1
        done = done + 1
        if z then
            local part = z:FindFirstChild("Head") or z:FindFirstChild("HumanoidRootPart")
            if part then
                local cat, item = classify(z)
                zOut[#zOut + 1] = { part = part, name = shortName(z.Name), cat = cat, item = item }
            end
        end
    end
    if zIdx > #zQueue then
        ZE.Live = zOut                     -- swap in whole, so nothing flickers
        zQueue, zOut, zIdx = nil, nil, 1
        zSweptAt = now
    end
end

AR2SPAWN("zombie esp", function()
    local pool = {}
    for i = 1, ZOMB_POOL do
        local ring = Drawing.new("Circle")
        ring.Thickness = 1; ring.Filled = false; ring.NumSides = 18
