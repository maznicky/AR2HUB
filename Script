        local n = 0
        -- The whole frame is wrapped. Any throw in here - a stale part, a bad read, a
        -- sort that dislikes its input - used to end the ESP permanently and silently,
        -- which reads as "the script crashed". A bad frame now costs one frame.
        local frameOk, frameErr = pcall(function()
        if ZE.Enabled then
            local now = tick()
            zombSweepStep(now)
            local cp = camPos()
            if cp then
                local maxStuds = ZE.MaxM * E.DistanceDivisor
                -- Shortlist, rebuilt on a timer, drawn every frame.
                --
                -- Projecting all 94 tracked zombies every frame cost 36% of the client.
                -- Rotating through a window of them fixed the cost but made markers
                -- flicker, because a zombie drawn on one pass was skipped on the next
                -- and its marker hidden. So: scan everything a few times a second to
                -- decide WHICH are worth drawing, then draw that same set every frame.
                -- Flat cost, stable markers.
                if (now - (ZE.shortAt or 0)) > 0.3 or not ZE.short then
                    ZE.shortAt = now
                    local cand = {}
