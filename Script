    "How far away it will pick a target from.")
_G.VEHMOD.ui.ramSec:Slider("Ram Speed", 220, 10, 40, 1200, " studs/s", function(v) _G.VEHMOD.RamSpeed = v end,
    "How hard it drives at them. Ground mode keeps this flat, so speed here is all horizontal.")
_G.VEHMOD.ui.ramSec:Dropdown("Trigger", "Key", { "Key", "Right Mouse", "Space" }, false,
    function(v) _G.VEHMOD.RamTrigger = dropStr(v, "Key") end,
