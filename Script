                                    o.sub.Color = col; o.sub.Visible = true
                                end
                            end
                        end
                    end
                end
            end
            pcall(function()
                CO.ui.info:SetText((#CO.Live == 0) and "no player corpses"
                    or string.format("%d player corpse%s", #CO.Live, (#CO.Live == 1) and "" or "s"))
            end)
        end
        for i = n + 1, CO.POOL do
            pool[i].ring.Visible = false
            pool[i].name.Visible = false
            pool[i].sub.Visible = false
        end
        task.wait(0.08)
    end
    for i = 1, CO.POOL do
        pcall(function() pool[i].ring:Remove() end)
        pcall(function() pool[i].name:Remove() end)
        pcall(function() pool[i].sub:Remove() end)
    end
end)
end
-- ==================== Movement (Combat > Movement) ====================
-- Everything here rides on ONE verified mechanism: writes to
-- HumanoidRootPart.AssemblyLinearVelocity apply. Measured live:
--   * (0,60,0) lifted Y from 60.05 to 68.34, then fell back under gravity
--   * writing (0,99,0) read back as (0,97,0), so the write lands
--   * 140 studs/s held for 0.24s moved 39.6 studs, and 1.5s later the position
--     was still 45.5 studs from the start - no snap-back, no rubber-band
-- What does NOT work, both tested: HumanoidRootPart.CFrame writes are silently
-- discarded (so no teleporting), and workspace:Raycast always returns nil even
-- straight down onto solid ground (so no ground checks - which is why fall
-- protection clamps speed instead of predicting impact).
--
-- Hybrid mode is NOT required: these are ordinary property writes.
--
-- RISK NOTE, deliberately in the file and in the panel: this is the most
-- externally visible thing in the script. No Spread only changes where your own
-- bullet goes; this moves your character in ways the server sees. Bursts with
-- gaps are used rather than sustained speed, since sustained velocity is the
-- obvious shape for a movement check to catch.
--
-- Written with almost no top-level locals: the main chunk is at Luau's 200
-- register limit, so state and UI handles hang off _G.MOVE.
do
_G.MOVE = _G.MOVE or {}
local MV = _G.MOVE

MV.DashOn   = false
MV.Key      = MV.Key or "x"
MV.Speed    = MV.Speed or 140          -- studs/sec during the burst
MV.Time     = MV.Time or 0.24          -- burst length, seconds
MV.CD       = MV.CD or 1.0             -- cooldown between bursts
MV.Lift     = MV.Lift or 4             -- small upward component, clears kerbs
MV.State    = "off"
MV.LastDash = 0
MV.LastDist = 0
MV.VK = { m1=0x01, m2=0x02, shift=0x10, ctrl=0x11, alt=0x12, space=0x20, tab=0x09 }

MV.ui = {}
MV.ui.tab = win:Tab("Character", "users")
MV.ui.sub = MV.ui.tab:Sub("Movement", "zap")
MV.ui.dashSec = MV.ui.sub:Section("Dash", "Full")
MV.ui.dashSec:Label("Velocity bursts, not teleports: CFrame writes are ignored")
MV.ui.dashSec:Label("by this game. This IS visible to the server - the most")
MV.ui.dashSec:Label("conspicuous thing in the script. Bursts + cooldown keep")
MV.ui.dashSec:Label("it away from the shape a movement check looks for.")
MV.ui.dashSec:Toggle("Enable Dash", false, function(v) MV.DashOn = v end)
MV.ui.key = MV.ui.dashSec:Keybind("Dash Key", "x", function(k) MV.Key = k end)
MV.ui.dashSec:Slider("Dash Speed", 140, 10, 40, 300, " studs/s", function(v) MV.Speed = v end,
    "140 for 0.24s measured 39.6 studs with no correction. Higher is further but more obvious.")
MV.ui.dashSec:Slider("Dash Duration", 0.24, 0.02, 0.06, 0.5, " s", function(v) MV.Time = v end)
MV.ui.dashSec:Slider("Cooldown", 1.0, 0.1, 0.2, 3, " s", function(v) MV.CD = v end,
    "Gaps between bursts matter more than burst size for staying unremarkable.")
MV.ui.dashInfo = MV.ui.dashSec:Label("off")


-- resolves the dash key the same way the aimbot and melee do: the lib handle
-- first, then a raw iskeypressed fallback so it works with the menu closed
MV.keyDown = function()
    if MV.ui.key then
        local ok, v = pcall(function() return MV.ui.key:IsActivated() end)
        if ok and v then return true end
    end
    local k = string.lower(tostring(MV.Key or ""))
    local vk = MV.VK[k]
    if not vk and #k == 1 then
        local b = string.byte(string.upper(k))
        if b >= 48 and b <= 90 then vk = b end
    end
    if vk and iskeypressed then
        local ok, d = pcall(function() return iskeypressed(vk) end)
        if ok and d then return true end
    end
    return false
end

MV.root = function()
    local ok, P = pcall(function() return game:GetService("Players") end)
    local lp = (ok and P) and P.LocalPlayer or nil
    local ch = lp and lp.Character
    return ch and ch:FindFirstChild("HumanoidRootPart") or nil
end

-- dash
AR2SPAWN("dash", function()
    local was = false
    while _G.AR2HUB_GEN == GEN do
        if MV.DashOn then
            local now = tick()
            local down = MV.keyDown()
            if down and not was and (now - MV.LastDash) >= MV.CD then
                local hrp = MV.root()
                local cam = workspace.CurrentCamera
                local cf
                if cam then
                    local ok, v = pcall(function() return cam.CFrame end)
                    if ok then cf = v end
                end
                if hrp and cf then
                    local look = cf.LookVector
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude > 0.01 then
                        flat = flat / flat.Magnitude
                        MV.LastDash = now
                        -- Both of these reads used to be unprotected. Dying or
                        -- respawning mid-dash - which is exactly what happens when you
                        -- dash into things - leaves a stale character, the read throws,
                        -- and an error inside a task.spawn loop kills that loop for
                        -- good, silently. That is the whole feature gone with no message.
                        local okf, from = pcall(function() return hrp.Position end)
                        MV.State = "dashing"
                        local finish = now + MV.Time
                        while tick() < finish and _G.AR2HUB_GEN == GEN do
                            local okw = pcall(function()
                                hrp.AssemblyLinearVelocity = flat * MV.Speed + Vector3.new(0, MV.Lift, 0)
                            end)
                            if not okw then break end   -- character gone: stop pushing
                            task.wait(0.03)
                        end
                        local okt, to = pcall(function() return hrp.Position end)
                        if okf and okt and from and to then
                            MV.LastDist = (Vector3.new(to.X, 0, to.Z) - Vector3.new(from.X, 0, from.Z)).Magnitude
                        end
                        MV.State = "cooldown"
                    end
                end
            elseif (now - MV.LastDash) < MV.CD then
                MV.State = "cooldown"
            else
                MV.State = "ready"
            end
            was = down
        else
            MV.State = "off"
            was = false
        end
        task.wait(0.03)
    end
end)

-- readouts
task.spawn(function()
    while _G.AR2HUB_GEN == GEN do
        pcall(function()
            MV.ui.dashInfo:SetText(MV.DashOn
                and string.format("%s%s", MV.State,
                    (MV.LastDist > 0) and string.format("  |  last dash %.0f studs", MV.LastDist) or "")
                or "off")
        end)
        task.wait(0.2)
    end
end)
end
-- ==================== Map ESP (Visuals > Map) ====================
-- Draws players, zombies and vehicles ONTO the in-game map (M). This was
-- previously impossible because Matcha could not enumerate PlayerGui; with
-- hybrid mode on it now can, and the whole map tree is readable:
--   PlayerGui.Map.ClipBin              the visible viewport (0 size when closed)
--     .DragBin                         pans and zooms
--       .Map                           the world image, four 512x462 tiles
--       .LocalMarker.MarkerCenter       a ZERO-SIZE anchor at YOUR position
--
-- MarkerCenter is what makes this work: everything is drawn relative to your own
-- marker, so panning and zooming are handled for free - no world bounds needed.
--
-- Scale was measured by nudging the character with velocity (the map screen locks
-- input, so walking cannot calibrate it) and watching the marker move:
--   43.8 studs -> 3.33 px  = 0.07586 px/stud on X
--   63.1 studs -> 4.71 px  = 0.07468 px/stud on Z
-- Within 1.6% of each other, so the projection is uniform. Held as a fraction of
-- DragBin's width (7.353e-5 px/stud per px) so zooming rescales automatically.
--
-- Hybrid mode IS required for this feature: without it PlayerGui reads as empty
-- and there is no map to draw on.
do
_G.MAPESP = _G.MAPESP or {}
local MP = _G.MAPESP
MP.Enabled  = false
MP.Players  = (MP.Players ~= false)
MP.Zombies  = MP.Zombies == true
MP.Vehicles = MP.Vehicles == true
MP.Events   = false   -- forced: the checkbox below always draws unchecked
MP.Names    = (MP.Names ~= false)
MP.Scale    = MP.Scale or 7.353e-5     -- px per stud, per px of DragBin width
MP.POOL     = 60
MP.Refs     = nil
MP.At       = 0
MP.Open     = false
MP.Shown    = 0
-- shared with the world ESPs so a dot means the same thing on the map as it does
-- on screen: orange = special zombie / half-worn wheels, blue = armed zombie,
-- red = prioritised player or wrecked wheels, green = healthy wheels or a boat
MP.col = {
    player   = C(245, 246, 250),
    priority = C(235,  80,  80),
    zombie   = C(245, 170,  70),
    armed    = C(120, 190, 255),
    vehicle  = C(120, 190, 255),
    good     = C( 80, 230, 120),
    bad      = C(235,  80,  80),
    unknown  = C(165, 170, 180),
}

MP.ui = {}
MP.ui.sub = vis:Sub("Map", "map")
MP.ui.sec = MP.ui.sub:Section("Map ESP", "Full")
MP.ui.sec:Label("Draws onto the real map. Open it with M.")
MP.ui.sec:Label("Everything is positioned relative to your own marker,")
MP.ui.sec:Label("so panning and zooming the map are handled automatically.")
MP.ui.sec:Toggle("Map ESP", false, function(v) MP.Enabled = v end)
MP.ui.sec:Toggle("Players", true, function(v) MP.Players = v end,
    "Marked players keep their colour: prioritised show red.")
MP.ui.sec:Toggle("Zombies", false, function(v) MP.Zombies = v end,
    "Uses the Zombies tab's cache, so enable Zombie ESP for this to have anything to draw.")
MP.ui.sec:Toggle("Vehicles", false, function(v) MP.Vehicles = v end,
    "Uses the Vehicles tab's cache, so enable Vehicle ESP for this to have anything to draw.")
MP.ui.sec:Toggle("Events", false, function(v) MP.Events = v end,
    "Uses the Events tab's sites, so turn on the events you want there first. Larger dots: green = alive, grey = not seen populated yet.")
MP.ui.sec:Toggle("Show Names", true, function(v) MP.Names = v end)
MP.ui.sec:Toggle("Show My Own Dot", false, function(v) MP.Self = v end,
    "Draws a dot at YOUR position. It should sit exactly on your own map marker - if it does not, adjust the offsets below until it does. That calibrates the anchor.")
MP.ui.sec:Toggle("Map Is Open (override)", false, function(v) MP.MapOpen = v end,
    "The game gives no readable signal for whether the map is open, so the script follows your M key. If the dots ever disappear while the map is open, or linger after closing it, flip this to resync - or just press M twice.")
MP.ui.cal = MP.ui.sub:Section("Calibration", "Full")
MP.ui.cal:Label("Automated calibration failed: the game's marker only updates")
MP.ui.cal:Label("its position in coarse steps, so small test moves produce no")
MP.ui.cal:Label("measurable signal. Tune these against a player whose real")
MP.ui.cal:Label("location you know, or against your own dot.")
MP.ui.cal:Slider("Scale Trim", 100, 1, 40, 200, " %", function(v) MP.Trim = v end,
    "Scales distance from you. If distant things are too far out, lower this; if they bunch up, raise it.")
-- Offsets are no longer exposed: they were dialled in by hand and nobody else
-- needs to touch them. Measured against the game's own marker:
--   zoomed out (DragBin 1024 wide): X -15, Y +25
--   zoomed in  (DragBin 2048 wide): X -25, Y +25
-- Y is constant, X moves 10 px between the two zoom levels, so X is
-- interpolated from DragBin's width and Y is fixed. See MP.anchor below.
MP.ui.info = MP.ui.sec:Label("map closed")
MP.Trim = MP.Trim or 100
-- X offset interpolated across zoom: -15 at DragBin 1024, -25 at 2048.
MP.offsetFor = function(dragWidth)
    return -5 - 10 * ((dragWidth or 1024) / 1024), 25
end

-- There is NO readable signal for whether the map is open. Everything was tried:
--   * geometry is byte-identical open vs closed (ClipBin stays 769x695, and a
--     close/reopen produced not one changed property)
--   * Enabled and Visible are unsupported bindings on every element
--   * no CanvasGroup exists to read GroupTransparency from
--   * the cursor is unlocked in both states in third person, so mouse position
--     relative to screen centre says nothing
-- An earlier attempt keyed off "the map locks your movement" - that was wrong,
-- you can walk with it open, and it made the ESP vanish whenever you moved.
-- So state is tracked from the M key, with Escape as a close, plus a manual
-- override in the UI for the one case that can drift: the map already being in
-- the opposite state when the script loads.
MP.MapOpen = false
MP.mWas    = false
MP.OPEN_OFF = 0x4AC    -- Map ScreenGui Enabled byte; see the render loop

-- The map key is watched in its own loop at ~221 Hz (task.wait(1/1000)), not in
-- the render loop. The render loop runs at roughly 20 Hz, and a short keypress
-- falls between polls at that rate - which is exactly how the state drifted out
-- of sync: the map got closed but the M press was never seen.
task.spawn(function()
    while _G.AR2HUB_GEN == GEN do
        if MP.Enabled and iskeypressed then
            local down = false
            local ok, d = pcall(function() return iskeypressed(0x4D) end)   -- M
            if ok then down = d and true or false end
            if down and not MP.mWas then MP.MapOpen = not MP.MapOpen end
            MP.mWas = down
            local oke, esc = pcall(function() return iskeypressed(0x1B) end) -- Escape
            if oke and esc then MP.MapOpen = false end
        else
            MP.mWas = false
        end
        task.wait(1/1000)
    end
end)
-- Forced off on every load rather than carried over from _G. The UI draws these
-- checkboxes unchecked, so a persisted `true` left the feature running while the
-- box said off - which is exactly the mismatch reported.
MP.Self = false

-- GUI refs are resolved on a timer: the map tree can be rebuilt, and
-- FindFirstChild is expensive enough not to want it every frame.
MP.resolve = function(now)
    if MP.Refs and (now - MP.At) < 1.0 then return MP.Refs end
    MP.At = now
    MP.Refs = nil
    local ok, refs = pcall(function()
        local P = game:GetService("Players")
        local lp = P and P.LocalPlayer
        local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("Map")
        local clip = gui and gui:FindFirstChild("ClipBin")
        local drag = clip and clip:FindFirstChild("DragBin")
        local marker = drag and drag:FindFirstChild("LocalMarker")
        local center = marker and marker:FindFirstChild("MarkerCenter")
        if clip and drag and marker then
            -- The tiles give the DragBin width now that AbsoluteSize reads 0.
            local tiles = drag:FindFirstChild("Map")
            return { gui = gui, clip = clip, drag = drag, marker = marker, center = center,
                     tl = tiles and tiles:FindFirstChild("TopLeft"),
                     tr = tiles and tiles:FindFirstChild("TopRight") }
        end
        return nil
    end)
    MP.Refs = ok and refs or nil
    return MP.Refs
end

task.spawn(function()
    local pool = {}
    for i = 1, MP.POOL do
        local dot = Drawing.new("Circle")
        dot.Filled = true; dot.NumSides = 8; dot.Radius = 3; dot.Visible = false
        local nm = Drawing.new("Text")
        nm.Size = 12; nm.Center = true; nm.Outline = true; nm.Visible = false
        pool[i] = { dot = dot, name = nm }
    end
    local function hide(o) o.dot.Visible = false; o.name.Visible = false end

    while _G.AR2HUB_GEN == GEN do
        local n = 0
        if MP.Enabled then
            local now = tick()
            local refs = MP.resolve(now)
            -- Open/closed comes from MEMORY: no readable property changes when the map
            -- opens, but the Map ScreenGui's byte at +0x4AC (its Enabled flag) is 1
            -- while open and 0 while closed - it tracked all 8 transitions in a
            -- recording on 2026-10-23. A Roblox update can move that offset, so any
            -- read that is not exactly 0 or 1 falls back to the M-key count.
            if refs and refs.gui and memory_read then
                local okm, v = pcall(function()
                    return memory_read("byte", refs.gui.Address + MP.OPEN_OFF)
                end)
                if okm and (v == 0 or v == 1) then
                    MP.MapOpen = (v == 1)
                    MP.OpenSrc = "memory"
                else
                    MP.OpenSrc = "M key"
                end
            end
            local open = MP.MapOpen and refs ~= nil
            MP.Open = open
            if open then
                -- AbsoluteSize reads 0 on every GUI element in Matcha now (2026-10-23),
                -- which collapsed every dot onto your marker and clipped them all away.
                -- Everything here comes from AbsolutePosition instead:
                --   DragBin width = 2 x the gap between the TopLeft and TopRight tiles
                --   marker centre = MarkerCenter's X, and as far below the marker's top
                --                   as MarkerCenter is right of its left edge
                --   ClipBin       = centred on screen, 769:695 (measured when sizes read)
                local okd, ds = pcall(function()
                    local w = 2 * (refs.tr.AbsolutePosition.X - refs.tl.AbsolutePosition.X)
                    if w <= 0 then w = 1024 end
                    return Vector2.new(w, w)
                end)
                local okc, cpx = pcall(function()
                    local mp2 = refs.marker.AbsolutePosition
                    local cx = refs.center and refs.center.AbsolutePosition.X or mp2.X
                    local half = cx - mp2.X
                    local ox, oy = MP.offsetFor((okd and ds) and ds.X or 1024)
                    return Vector2.new(mp2.X + half + ox, mp2.Y + half + oy)
                end)
                local okr, cr = pcall(function() return refs.clip.AbsolutePosition end)
                local oks, cs = pcall(function()
                    local vw = workspace.CurrentCamera.ViewportSize.X
                    local w = vw - 2 * cr.X
                    return Vector2.new(w, w * 695 / 769)
                end)
                local P = svcPlayers()
                local lp = P and P.LocalPlayer
                local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                local okm, me = false, nil
                if hrp then okm, me = pcall(function() return hrp.Position end) end
                if okd and okc and okr and oks and okm and ds and cpx and me then
                    local scale = ds.X * MP.Scale * (MP.Trim / 100)
                    local minX, minY = cr.X, cr.Y
                    local maxX, maxY = cr.X + cs.X, cr.Y + cs.Y

                    local function plot(wpos, col, label, radius)
                        if n >= MP.POOL then return end
                        local sx = cpx.X + (wpos.X - me.X) * scale
                        local sy = cpx.Y + (wpos.Z - me.Z) * scale
                        -- clip to the viewport, or dots spill outside the map frame
                        if sx < minX or sx > maxX or sy < minY or sy > maxY then return end
                        n = n + 1
                        local o = pool[n]
                        o.dot.Position = Vector2.new(sx, sy)
                        o.dot.Radius = radius or 3   -- reset every time: slots are reused
                        o.dot.Color = col
                        o.dot.Visible = true
                        if MP.Names and label then
                            o.name.Text = label
                            o.name.Position = Vector2.new(sx, sy - 13)
                            o.name.Color = col
                            o.name.Visible = true
                        else
                            o.name.Visible = false
                        end
                    end

                    -- your own dot: a calibration aid. It must land on your marker.
                    if MP.Self then plot(me, C(120, 255, 160), "me") end

                    -- Events first, so players and zombies can never use up the pool
                    -- before them. Reuses the Events tab's site list, so only events
                    -- toggled on there are drawn, in the same colours: green = alive,
                    -- grey = never seen populated. Bigger dots than everything else.
                    if MP.Events and _G.EventESP and _G.EventESP.Targets then
                        local EV = _G.EventESP
                        for _, t in ipairs(EV.Targets) do
                            if EV.Enabled[t.cat] and t.pos then
                                local col = (t.state == "unlooted") and MP.col.good or MP.col.unknown
                                plot(t.pos, col, t.name, 5)
                            end
                        end
                    end

                    if MP.Players and P then
                        local marks = _G.PLAYERMARK or {}
                        for _, pl in ipairs(P:GetPlayers()) do
                            if pl.UserId ~= lp.UserId and marks[pl.UserId] ~= "whitelist" then
                                local okc2, ch = pcall(function() return pl.Character end)
                                local r = (okc2 and ch) and ch:FindFirstChild("HumanoidRootPart") or nil
                                if r then
                                    local okp, p = pcall(function() return r.Position end)
                                    if okp and p then
                                        plot(p, (marks[pl.UserId] == "priority") and MP.col.priority
                                                or MP.col.player, pl.Name)
                                    end
                                end
                            end
                        end
                    end
                    -- these reuse the other tabs' caches rather than re-scanning
                    -- Zombies keep the Zombies tab's colours: orange for a special
                    -- carry, blue for armed, white for nothing worth taking. Only
                    -- categories enabled there are drawn, so the map agrees with
                    -- the world ESP instead of showing a different population.
                    if MP.Zombies and _G.ZOMBESP and _G.ZOMBESP.Live then
                        local ZE = _G.ZOMBESP
                        for _, e in ipairs(ZE.Live) do
                            if (not ZE.Show) or ZE.Show[e.cat] then
                                local okp, p = pcall(function() return e.part.Position end)
                                if okp and p then
                                    local col = (e.cat == "armed") and MP.col.armed
                                             or (e.cat == "normal") and MP.col.player
                                             or MP.col.zombie
                                    plot(p, col, e.item or nil)
                                end
                            end
                        end
                    end
                    -- Vehicles keep the wheel-condition colours: red under 33%,
                    -- orange to 66%, green above, grey when no reading, and boats
                    -- always green since they have no wheels to lose.
                    if MP.Vehicles and _G.VEHESP and _G.VEHESP.Cache then
                        local VE = _G.VEHESP
                        for _, e in ipairs(VE.Cache) do
                            if (not VE.Types) or VE.Types[e.name] == true then
                                local okp, p = pcall(function() return e.part.Position end)
                                if okp and p then
                                    local col
                                    if e.boat then col = MP.col.good
                                    elseif not e.frac then col = MP.col.unknown
                                    elseif e.frac <= 0.33 then col = MP.col.bad
                                    elseif e.frac <= 0.66 then col = MP.col.zombie
                                    else col = MP.col.good end
                                    plot(p, col, e.name)
                                end
                            end
                        end
                    end
                end
            end
            MP.Shown = n
            pcall(function()
                MP.ui.info:SetText(open
                    and string.format("map open - %d marks drawn", n)
                    or (refs and "map closed - press M" or "map GUI not found"))
            end)
        end
        for i = n + 1, MP.POOL do hide(pool[i]) end
        task.wait(0.05)
    end
    for i = 1, MP.POOL do
        pcall(function() pool[i].dot:Remove() end)
        pcall(function() pool[i].name:Remove() end)
    end
end)
end
-- ==================== Vehicle Mods (Combat > Vehicle Mods) ====================
-- Measured on an ambulance with the player sitting in it:
--   * writing AssemblyLinearVelocity to the vehicle's Base part MOVED it 16.88 studs,
--     and read back exactly what was written
--   * 0.13 studs of drift over the next 2 seconds with no further writes, so the
--     server accepts the displacement rather than correcting it
--   * vertical at 22 studs/s did nothing at all - the suspension absorbs it - but 60
--     lifted the vehicle 19.3 studs, so flight needs to clear that floor
--   * Config and Config.Physics decompile with their structure but no numbers, so
--     there is no MaxSpeed constant to edit; velocity is the whole mechanism
--   * there is NO velocity ceiling. Writing 600 once read back as 425 and I called
--     that a clamp - it was a snapshot taken 0.05s into the burst while the value was
--     still ramping. A proper 6 second run at 1000 recorded a peak of 1108 studs/s
--     measured from actual position change, velocity reading back at 1035, and
--     covered 2344 studs with the vehicle intact. Trust displacement over a property
--     read taken mid-acceleration
-- The vehicle itself is what moves here. The character is never touched.
--
-- This is the loudest thing in the script by a distance: a car doing 120 studs/s or
-- leaving the ground is visible to everyone, not just to the server.
do
_G.VEHMOD = _G.VEHMOD or {}
_G.VEHMOD.Boost      = false
_G.VEHMOD.Fly        = false
_G.VEHMOD.BoostSpeed = 70              -- forced, matches the slider drawn below
_G.VEHMOD.Ramp       = 0
-- Flight survival, measured: a gentle flight lived, a hard one exploded mid-air at 6
-- seconds, then a 6 second run at 1000 studs/s lived and covered 2344 studs. So
-- duration alone does not decide it - one 6 second flight died and another did not.
-- Whatever the trigger is, it is server side and not readable here. The limit stays
-- as an opt-out safety net rather than a rule, since it clearly is not one.
-- Manual Fly no longer applies a time limit (removed 2026-10-23); these remain only
-- so nothing that still reads them breaks.
_G.VEHMOD.FlyLimit   = false
_G.VEHMOD.FlyMax     = 6                           -- seconds of continuous flight
-- Flying drains ENGINE HEALTH, which is what actually destroys the vehicle. Traced on
-- a Jeep: 0.224 0.209 0.203 0.186 0.175 0.164 0.148 0.142 0.136 0.131 0.120, then it
-- died mid-air at 404 studs after 5.4 airborne seconds. That Jeep started at 22%, so
-- it had almost nothing to spend - which is why earlier runs looked random. A gentle
-- flight survived and a hard one exploded not because of speed or height, but because
-- of how much engine each vehicle had left. Watch the engine, not the clock.
-- No longer exposed as a toggle: it stays on. Turning it off only ever meant
-- volunteering to lose the vehicle mid-flight, which nobody wants on purpose.
