    pcall(function() Lib:Notify("flight log cleared", 2) end)
end, "Clears the recorded runs. The current flight keeps going.")
_G.VEHMOD.ui.logSec:Button("Print Log", function()
    local L = _G.FLIGHTLOG
    print("---- AR2 Hub flight log ----")
    print(string.format("%d run%s recorded", #L.runs, (#L.runs == 1) and "" or "s"))
    for i, r in ipairs(L.runs) do
        print(string.format("%2d. grounded %5.1fs | flew %5.1fs, %6.0f studs, peak %4.0f | tilted %4.1fs, worst level %.2f | %s",
            i, r.groundBefore or -1, r.air or -1, r.dist or -1, r.peak or -1,
            r.tilted or -1, r.minLevel or -1,
