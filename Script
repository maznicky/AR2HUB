-- autopilot: owns the vehicle while engaged, so the manual loop stands down
AR2SPAWN("vehicle drive", function()
    local VM = _G.VEHMOD
    while _G.AR2HUB_GEN == GEN do
        local AP = VM.AP
        if AP.on and AP.target then
            local okr, P = pcall(function() return svcPlayers() end)
            local lp = (okr and P) and P.LocalPlayer or nil
            local ch = lp and lp.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart") or nil
            local myPos
            if hrp then
                local okp, p = pcall(function() return hrp.Position end)
                myPos = okp and p or nil
            end
            -- Lock onto the vehicle once, at engage, and keep the reference.
            -- Re-deriving it every tick compares YOUR position against each vehicle's,
            -- and those two reads are taken moments apart - at 900 studs/s the vehicle
            -- moves ~20 studs in that gap, so the nearest-within-15-studs test failed
            -- and autopilot dropped the vehicle mid-flight. Traced: phase went straight
            -- from climb to "no vehicle" as soon as speed picked up, and it fell out of
            -- the sky while the altitude hold was working perfectly.
            local base = AP.base
            if base then
                local okv = pcall(function() return base.Position end)
                if not okv then base, AP.base = nil, nil end
            end
            if not base and myPos then
                base = VM.baseNear(myPos)
                AP.base = base
            end
            if not base then
                AP.phase = "no vehicle"
            else
                local okp, pos = pcall(function() return base.Position end)
                if okp and pos then
                    -- engine reading, same cache lookup the manual path uses
                    local nowE = tick()
                    if nowE - (VM.entryAt or 0) > 1.0 then
                        VM.entryAt = nowE
                        VM.entry = nil
                        local mdl = base.Parent
                        for _, e in ipairs((_G.VEHESP and _G.VEHESP.Cache) or {}) do
                            if e.model == mdl or (e.part and e.part.Parent == mdl) then VM.entry = e break end
                        end
                    end
                    VM.EngineNow = (VM.entry and VM.entry.parts) and VM.entry.parts.engine or nil
                    AP.tickAt = tick()
                    -- Stuck detection. Climb and descend both push in one direction
                    -- until an altitude is reached, with nothing to say "this is not
                    -- happening". Landing on a roof left it hovering at 128 studs
                    -- writing downward velocity forever, and pushing up against
                    -- something solid produced the same thing on the ground - the
                    -- vehicle shaking in place with no way out of the phase.
                    if AP.stuckY and math.abs(pos.Y - AP.stuckY) < 1.5 then
                        AP.stuckFor = (AP.stuckFor or 0) + 0.03
                    else
                            AP.stuckY, AP.stuckFor = pos.Y, 0
                    end
                    local flat = Vector3.new(AP.target.X - pos.X, 0, AP.target.Z - pos.Z)
                    local horiz = flat.Magnitude
                    local cruiseY = math.max(AP.target.Y + AP.Height, AP.MinAlt or 280)
                    local vel
                    if AP.phase == "climb" then
                        -- get above cruise height before crossing, so nothing is hit
                        if pos.Y >= cruiseY - 5 then
                            AP.phase = "cruise"
                        elseif (AP.stuckFor or 0) > 2.5 then
                            -- cannot get any higher: something is above or holding it,
                            -- so cross at whatever height it managed rather than
                            -- grinding upward against it
                            AP.phase = "cruise"
                            AP.stuckFor = 0
                        else
                            vel = Vector3.new(0, AP.Climb or 500, 0)
                        end
                    elseif AP.phase == "cruise" then
                        -- engine is the fuel of this whole thing: if it is nearly gone,
                        -- put down now rather than arriving as wreckage
                        if VM.EngineGuard and VM.EngineNow and VM.EngineNow < VM.EngineMin then
                            AP.phase = "descend"
                            AP.early = true
                            -- land HERE, not at the target: the descent only corrects
                            -- horizontally at 25 studs/s, so chasing a distant waypoint
                            -- while aborting looks like hovering and creeping forward
                            AP.target = Vector3.new(pos.X, AP.target.Y, pos.Z)
                            AP.legs, AP.leg = nil, nil
                        elseif horiz <= AP.Radius then
                            AP.phase = "descend"
                        else
                            local dir = flat / horiz
                            -- Altitude hold. Writing the whole velocity each tick means
                            -- Y goes to zero once it reaches height - and gravity then
                            -- has the full gap between writes to work, about 9.8 studs/s
                            -- of downward velocity every 50ms, so it sank out of the sky
                            -- while the correction chased it. The bias cancels that gap,
                            -- and the gain is enough to actually climb back.
                            local dy = cruiseY - pos.Y
                            if dy > 60 then dy = 60 elseif dy < -60 then dy = -60 end
                            local lift = dy * 4 + 12          -- 12 = what gravity steals between ticks

                            -- Braking curve, not a taper. The speed that can still be
                            -- shed in the distance left is sqrt(2 * decel * remaining),
                            -- so it runs at full speed until the last possible moment
                            -- and then sheds it - which is what gets you there soonest
                            -- AND stopped. A linear taper either crawls the last third
                            -- or arrives too fast to stop.
                            local remain = math.max(horiz - AP.Radius * 0.5, 0)
                            local sp = math.min(AP.Speed, math.sqrt(2 * (AP.Brake or 300) * remain))

                            -- and never step past the target inside one tick: at 400
                            -- studs/s a tick covers 20 studs, which is how it was
                            -- skipping straight over a 12 stud arrival radius
                            local dt = tick() - (AP.tickAt or (tick() - 0.05))
                            if dt < 0.02 then dt = 0.02 elseif dt > 0.2 then dt = 0.2 end
                            if sp * dt > horiz then sp = horiz / dt end

                            -- overshoot guard: if the gap starts growing while closing
                            -- in, it has gone past, so stop dead and let descend take it
                            if AP.lastHoriz and horiz > AP.lastHoriz and horiz < 120 then
                                sp = 0
                                AP.phase = "descend"
                            end
                            AP.lastHoriz = horiz
                            -- if it has dropped badly, climbing matters more than speed:
                            -- carrying full throttle while low is how it ends up meeting
                            -- terrain instead of crossing it
                            if dy > 25 then sp = sp * 0.5 end
                            vel = dir * sp + Vector3.new(0, lift, 0)
                        end
                    elseif AP.phase == "descend" then
                        local above = pos.Y - AP.target.Y
                        -- Contact detection. The waypoint's height is only correct if it
                        -- was recorded standing on that exact spot, and arriving a few
                        -- studs off means real ground can be higher - so descending "to
                        -- the number" drives the car into it. If the altitude stops
                        -- falling while a descent is commanded, that IS contact, and
                        -- continuing to push down is what turns a landing into damage.
                        if above > 6 and (AP.stuckFor or 0) > 0.5 then
                            local okv, cv = pcall(function() return base.AssemblyLinearVelocity end)
                            if okv and cv and cv.Y > -3 then
                                above = 0
                                AP.landedHigh = true
                            end
                        end
                        if above > 6 and (AP.stuckFor or 0) > 2.5 then
                            above = 0
                            AP.landedHigh = true
                        end
                        if above <= 6 then
                            pcall(function()
                                base.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            end)
                            AP.stuckY, AP.stuckFor = nil, 0
                            if AP.legs and AP.leg and AP.leg < #AP.legs then
                                -- sit still so the next area can stream in, then go on
                                AP.phase = "waiting"
                                task.wait(AP.Pause or 3)
                                AP.leg = AP.leg + 1
                                AP.target = AP.legs[AP.leg]
                                AP.lastHoriz, AP.early = nil, nil
                                AP.phase = "climb"
                            else
                                AP.phase = "done"
                                AP.on = false
                            end
                        else
                            -- slow the closer it gets: a soft arrival is the whole
                            -- point, since impact is what damages the vehicle
                            -- Flare, not a linear taper. Touchdown speed is what does
                            -- impact damage - the car was seen catching fire on arrival,
                            -- which is the ordinary damage path, and trips cost anywhere
                            -- from 4% to 10% depending on how hard it lands. The speed
                            -- that can still be shed in the height remaining is
                            -- sqrt(2*decel*above), so it falls fast while high and is
                            -- genuinely slow at the moment of contact, which a linear
                            -- taper to a 14 studs/s floor never was.
                            local rate = math.min(AP.Descent,
                                                  math.sqrt(2 * (AP.LandDecel or 60) * math.max(above, 0)))
                            if rate < (AP.TouchSpeed or 8) then rate = AP.TouchSpeed or 8 end
                            local corr = Vector3.new(0, 0, 0)
                            if horiz > 2 then corr = (flat / horiz) * math.min(horiz * 1.5, 25) end
                            vel = corr + Vector3.new(0, -rate, 0)
                        end
                    end
                    if vel then
                        pcall(function() base.AssemblyLinearVelocity = vel end)
                    end
                    AP.dist, AP.alt = horiz, pos.Y - AP.target.Y
                end
            end
            VM.APActive = AP.on
            task.wait(0.03)      -- faster than the manual loop: less gravity per gap
            continue
        end
        VM.APActive = false
        task.wait(0.2)
    end
end)

task.spawn(function()
    local VM = _G.VEHMOD
    while _G.AR2HUB_GEN == GEN do
        if (VM.Boost or VM.Fly) and not VM.APActive then
            local held = false
            local vk = VM.TRIG[tostring(VM.Trigger)]
            if not vk and tostring(VM.Trigger) == "Key" then
                -- the bound key, resolved the same way the melee trigger does it: the
                -- library handle first, then the raw virtual-key code
                if VM.ui.key then
                    local okh, v = pcall(function() return VM.ui.key:IsActivated() end)
                    if okh and v then held = true end
                end
                local k = string.lower(tostring(VM.Key or "g"))
                if #k == 1 then
                    local b = string.byte(string.upper(k))
                    if b >= 48 and b <= 90 then vk = b end
                end
            end
            if not held and vk and iskeypressed then
                local ok, d = pcall(function() return iskeypressed(vk) end)
                held = (ok and d) and true or false
            end
            local okr, P = pcall(function() return svcPlayers() end)
            local lp = (okr and P) and P.LocalPlayer or nil
            local ch = lp and lp.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart") or nil
            local myPos
            if hrp then
                local okp, p = pcall(function() return hrp.Position end)
                myPos = okp and p or nil
            end
            -- Righting runs whether or not the trigger is held: a vehicle on its roof
            -- is exactly when you cannot be holding anything useful.
            if myPos and VM.AutoRight then
                local rbase = VM.baseNear(myPos)
                if rbase then
                    local okc, rcf = pcall(function() return rbase.CFrame end)
                    local ry = (okc and rcf) and rcf.UpVector.Y or 1
                    -- A slope is not a flip. 45 degrees of hill still reads 0.71 and a
                    -- steep bank around 0.5, so the old 0.45 threshold fired on terrain.
                    -- A vehicle actually on its side or roof sits near zero or negative,
                    -- and it STAYS there - a slope is transient as you drive over it.
                    -- So: a much lower threshold, and it has to hold for most of a
                    -- second before anything is done about it.
                    local nowT = tick()
                    if ry < 0.25 then
                        VM.tiltSince = VM.tiltSince or nowT
                    else
                        VM.tiltSince = nil
                    end
                    if VM.tiltSince and (nowT - VM.tiltSince) > 0.7
                       and nowT >= VM.rightUntil and (nowT - VM.rightLast) > 2.0 then
                        VM.rightUntil, VM.rightLast = nowT + 0.45, nowT
                        VM.tiltSince = nil
                    end
                    if nowT < VM.rightUntil then
                        pcall(function()
                            local cur = rbase.AssemblyLinearVelocity
                            rbase.AssemblyLinearVelocity =
                                Vector3.new(cur.X * 0.5, VM.RightLift, cur.Z * 0.5)
                        end)
                        VM.State = string.format("righting (level %.2f)", ry)
                        task.wait(0.05)
                        continue
                    end
                end
            end
            if not myPos then
                VM.State = "no character"
            elseif not held then
                VM.Ramp = 0            -- start from a standstill on the next press
                VM.flyStart = nil      -- releasing resets the flight clock
                VM.State = "ready - hold " .. tostring(VM.Trigger)
            else
                local base, why = VM.baseNear(myPos)
                if not base then
                    VM.State = tostring(why)
                else
                    local cam = workspace.CurrentCamera
                    local cf
                    if cam then
                        local okc, c = pcall(function() return cam.CFrame end)
                        if okc then cf = c end
                    end
                    -- The vehicle's own orientation, which is what stops it rolling:
                    -- pushing along the camera's axis shoves a grounded car sideways
                    -- while the wheels still grip, and it torques over and explodes.
                    -- Angular velocity cannot be damped - the write is rejected - so
                    -- the only levers are direction, ramping, and knowing when to stop.
                    local vcf
                    local okvc, c2 = pcall(function() return base.CFrame end)
                    if okvc then vcf = c2 end
                    local upY = vcf and vcf.UpVector.Y or 1
                    if cf then
                        local lv = cf.LookVector
                        local vel
                        if VM.Fly then
                            local nowF = tick()
                            -- engine health, resolved through the ESP's cache entry for
                            -- this vehicle; refreshed on a timer since it means walking
                            -- the cache to find the matching model
                            if nowF - (VM.entryAt or 0) > 1.0 then
                                VM.entryAt = nowF
                                VM.entry = nil
                                local mdl = base.Parent
                                for _, e in ipairs((_G.VEHESP and _G.VEHESP.Cache) or {}) do
                                    if e.model == mdl or (e.part and e.part.Parent == mdl) then VM.entry = e break end
                                end
                            end
                            -- Shown in the status line only. Manual flight has no engine
                            -- guard and no time limit (removed at the user's request,
                            -- 2026-10-23): it flies until you let go, even on a dying engine.
                            VM.EngineNow = (VM.entry and VM.entry.parts) and VM.entry.parts.engine or nil
                            -- full 3D: look up and it climbs, which is the whole point
                            vel = lv * VM.FlySpeed
                        elseif upY < 0.90 then
                            -- already leaning: pushing now is what turns a lean into a
                            -- roll, so back off and let it settle
                            VM.Ramp = 0
                            VM.State = string.format("%s tilting - easing off", tostring(why))
                        else
                            -- drive along the VEHICLE's axis, signed by which way you
                            -- are facing, so it goes forwards or reverses rather than
                            -- being shoved across its own wheels
                            local vfwd = vcf and Vector3.new(vcf.LookVector.X, 0, vcf.LookVector.Z) or nil
                            local camflat = Vector3.new(lv.X, 0, lv.Z)
                            if vfwd and vfwd.Magnitude > 0.01 and camflat.Magnitude > 0.01 then
                                vfwd = vfwd / vfwd.Magnitude
                                camflat = camflat / camflat.Magnitude
                                local sign = (vfwd:Dot(camflat) < 0) and -1 or 1
                                -- ramp instead of snapping to full speed: a standing
                                -- start straight to 120 is itself enough to flip it
                                VM.Ramp = math.min((VM.Ramp or 0) + VM.BoostSpeed * 0.12, VM.BoostSpeed)

                                -- How fast the vehicle is rotating, from its own facing
                                -- between ticks. Rewriting velocity along the new
                                -- forward each tick is what rolls it in a turn, so the
                                -- harder it is turning, the less speed it gets - the
                                -- same trade a real car makes for grip.
                                local nowT = tick()
                                local yawRate = 0
                                if VM.LastFwd and VM.LastFwdAt then
                                    local dt2 = nowT - VM.LastFwdAt
                                    if dt2 > 0.01 then
                                        local dot = VM.LastFwd:Dot(vfwd)
                                        if dot > 1 then dot = 1 elseif dot < -1 then dot = -1 end
                                        yawRate = math.acos(dot) / dt2
                                    end
                                end
                                VM.LastFwd, VM.LastFwdAt = vfwd, nowT
                                VM.Yaw = yawRate
                                local turnCut = 1 / (1 + yawRate * 1.5)
                                local target = vfwd * (VM.Ramp * turnCut * sign)

                                -- Clamp how much of the change is SIDEWAYS. Speeding up
                                -- or slowing along the current heading is harmless; it
                                -- is the perpendicular jolt that tips a tall vehicle.
                                local okv, cur = pcall(function() return base.AssemblyLinearVelocity end)
                                local keepY = (okv and cur) and cur.Y or 0
                                local curFlat = (okv and cur) and Vector3.new(cur.X, 0, cur.Z) or Vector3.new(0, 0, 0)
                                local delta = target - curFlat
                                if curFlat.Magnitude > 1 then
                                    local dir = curFlat / curFlat.Magnitude
                                    local alongMag = delta:Dot(dir)
                                    local along = dir * alongMag
                                    local perp = delta - along
                                    local maxPerp = 6          -- studs/s of sideways change per tick
                                    if perp.Magnitude > maxPerp then
                                        perp = (perp / perp.Magnitude) * maxPerp
                                    end
                                    target = curFlat + along + perp
                                end
                                vel = target + Vector3.new(0, keepY, 0)
                            end
                        end
                        if vel then
                            pcall(function() base.AssemblyLinearVelocity = vel end)
                            VM.State = string.format("%s %s at %.0f studs/s (level %.2f, turn %.1f%s)",
                                VM.Fly and "flying" or "driving", tostring(why),
                                vel.Magnitude, upY, VM.Yaw or 0,
                                VM.EngineNow and string.format(", engine %.0f%%", VM.EngineNow * 100) or "")
                        end
                    end
                end
            end
        else
            VM.State = "off"
        end
        task.wait(0.05)
    end
end)

