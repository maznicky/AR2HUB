local setDiag = win:SettingsSection("Diagnostics", "Right")
local diagLbl = setDiag:Label("-")
setDiag:Button("Log environment report", function()
    local P = svcPlayers()
    print("---- AR2 Hub environment ----")
    print("gen              : " .. tostring(_G.AR2HUB_GEN))
    print("Players handle   : " .. (P and ("ok, " .. #P:GetPlayers() .. " players") or "STALE (nil)"))
    print("camera           : " .. tostring(workspace.CurrentCamera ~= nil))
    print("mousemoverel     : " .. type(mousemoverel))
    print("iskeypressed     : " .. type(iskeypressed))
    print("memory_write     : " .. type(memory_write))
    print("ESP markers      : " .. tostring(_G.ESP_COUNT))
    print("scheduler health : " .. string.format("%.2f", _G.AR2HUB_HEALTH or -1)
          .. "  (1.00 = keeping up; sweeps scale down below that)")
    print("combat prepared  : " .. tostring(_G.COMBAT and _G.COMBAT.Prepared))
    print("combat cache     : " .. tostring(_G.COMBAT and _G.COMBAT.Cache and #_G.COMBAT.Cache))
    print("aimbot enabled   : " .. tostring(_G.AIMBOT and _G.AIMBOT.Enabled))
    print("aimbot locked    : " .. tostring(_G.AIMBOT and _G.AIMBOT.Locked))
    print("-----------------------------")
    pcall(function() Lib:Notify("environment report written to the log", 3) end)
end, "Prints the state that actually matters when something stops working.")

task.spawn(function()
    while _G.AR2HUB_GEN == GEN do
        local P = svcPlayers()
        pcall(function()
            setInfo:SetText(string.format("markers %s  |  guns %s",
                tostring(_G.ESP_COUNT or 0),
                (_G.COMBAT and _G.COMBAT.Prepared) and "ready" or "not prepared"))
            diagLbl:SetText(string.format("players %s  |  aim %s",
                P and tostring(#P:GetPlayers()) or "handle stale",
                (_G.AIMBOT and _G.AIMBOT.Enabled) and "on" or "off"))
        end)
        task.wait(1)
    end
end)
