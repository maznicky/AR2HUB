                        (#shortlist > VEH_ROWS) and (", showing nearest " .. VEH_ROWS) or ""))
                end
            end)

            -- read live for the handful actually on screen: 5 attributes each,
            -- ~0.6 ms per vehicle, so 10 rows costs ~6 ms twice a second
            for i = 1, VEH_ROWS do
                local row = detRows[i]
                local item = (i <= shown) and shortlist[i] or nil
                if not item then
                    pcall(function() row.top:SetText("") row.bot:SetText("") end)
                else
