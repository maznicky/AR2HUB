                    local nowR = tick()
                    if not VM.ramPart or (nowR - (VM.ramPickAt or 0)) > 0.35 then
                        VM.ramPickAt = nowR
                        VM.ramPart = myPos and VM.ramTarget(myPos) or nil
                    end
